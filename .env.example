# Copier ce fichier en ".env" et renseigner les vraies valeurs
# (le fichier ".env" est ignoré par Git, ne jamais commiter de vraies clés)

# Dashboard Supabase > Project Settings > API
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard Resend > API Keys (utilisé côté serveur par src/pages/api/send-email.ts)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
