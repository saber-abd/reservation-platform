# Copier ce fichier en ".env" et renseigner les vraies valeurs
# (le fichier ".env" est ignoré par Git, ne jamais commiter de vraies clés)

# Dashboard Supabase > Project Settings > API
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# EmailJS (utilisé côté serveur par src/pages/api/send-email.ts)
# Modèle à créer dans EmailJS > Email Templates :
#   To Email : {{to_email}}   Subject : {{subject}}   Content : {{{html}}}  (3 accolades = HTML non échappé)
# Activer aussi EmailJS > Account > Security > "Allow EmailJS API for non-browser applications".
EMAILJS_TEMPLATE_ID=template_xxxxxxx
# EmailJS > Account > API Keys > Private Key
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxx
# Optionnels (par défaut : ceux des formulaires de contact)
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
# Optionnel : force tous les envois vers cette adresse (tests)
EMAIL_OVERRIDE_TO=

# Google Calendar (compte de service), utilisé par src/pages/api/calendar.ts
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com

# En production (Cloudflare Workers), les variables serveur ci-dessus (EMAILJS_*, GOOGLE_*)
# doivent être définies dans le dashboard Cloudflare : Workers & Pages > reservation-platform >
# Settings > Variables and Secrets (type "Secret"), ou via `npx wrangler secret put NOM`.
# Les PUBLIC_SUPABASE_* doivent aussi y être présentes (lues à l'exécution par /api/send-email)
# en plus des variables de build.
