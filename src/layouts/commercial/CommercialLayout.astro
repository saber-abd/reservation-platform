---
import '@fontsource-variable/bricolage-grotesque/index.css';
import '@fontsource-variable/geist/index.css';
import '../../styles/commercial.css';
import { ArrowRight, ArrowUpRight, Phone, Mail } from 'lucide-react';
import SmoothScroll from '@/components/shared/SmoothScroll.astro';
import CookieBanner from '@/components/shared/CookieBanner.astro';
import Avatar from '@/components/commercial/Avatar.astro';
import BrandIcon from '@/components/commercial/BrandIcon.astro';
import { membres } from '@/components/commercial/equipe';
import { contact } from '@/components/commercial/contact';

interface Props {
	title: string;
	description: string;
	/** Bandeau « Un projet de site en tête ? » du pied de page (masqué là où la page a déjà son appel à l'action). */
	footerCta?: boolean;
}

const { title, description, footerCta = true } = Astro.props;
const currentYear = new Date().getFullYear();
const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';

const liens = [
	{ label: 'Présentation', href: '/#presentation' },
	{ label: 'Formules', href: '/#tarification' },
	{ label: 'Notre histoire', href: '/notre-histoire' },
	{ label: 'Devis', href: '/devis' },
	{ label: 'Contact', href: '/contact' },
];

const formules = [
	{ id: 'standard', label: 'Standard', href: '/galerie/standard', resume: 'Site vitrine, réservation dans Google Agenda' },
	{ id: 'premium', label: 'Premium', href: '/galerie/premium', resume: 'Espace client, tableau de bord, fidélité' },
	{ id: 'diamant', label: 'Diamant', href: '/galerie/diamant', resume: 'Gestion d’équipe, droits, modération' },
];

const legal = [
	{ label: 'Mentions légales', href: '/mentions-legales' },
	{ label: 'CGU', href: '/cgu' },
	{ label: 'Données personnelles', href: '/confidentialite' },
	{ label: 'Cookies', href: '/cookies' },
];
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<meta name="theme-color" content="#f4efe6" />
		<!-- Active les apparitions au défilement uniquement si le JS tourne (sinon tout reste visible). -->
		<!-- Filet de sécurité : si les animations d'entrée n'ont pas démarré après 3,5 s, tout s'affiche. -->
		<script is:inline>
			document.documentElement.classList.add('js');
			setTimeout(function () { document.documentElement.classList.add('cm-secours'); }, 3500);
		</script>
	</head>
	<body class="commercial-page flex min-h-screen flex-col">
		<a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-encre focus:px-4 focus:py-2 focus:text-papier">Aller au contenu</a>

		<!-- NAVIGATION FLOTTANTE -->
		<header class="site-nav" data-site-nav>
			<div class="site-nav-pilule">
				<a href="/" class="logo" aria-label="SaberWeb.dev, accueil">
					<span>SaberWeb</span><span class="logo-point">.</span><span class="logo-ext">dev</span>
				</a>

				<nav class="hidden items-center gap-0.5 lg:flex" aria-label="Navigation principale">
					<a href="/#presentation" class="nav-link">Présentation</a>

					<div class="nav-menu" data-nav-menu>
						<button type="button" class="nav-link" aria-expanded="false" aria-controls="menu-formules">
							Formules
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
						</button>
						<div id="menu-formules" class="nav-panneau">
							<div class="grid grid-cols-3 gap-1">
								{formules.map((f, i) => (
									<div class="nav-colonne">
										<a href={f.href}>
											<span class="repere">0{i + 1}</span>
											<span class="mt-1 block font-heading text-xl font-semibold tracking-tight">{f.label}</span>
											<span class="mt-1 block text-sm leading-snug text-gris">{f.resume}</span>
										</a>
										<ul class="mt-3 border-t border-filet pt-2">
											<li><a href={`${f.href}#fonctionnalites`} class="nav-sous">Fonctionnalités</a></li>
											<li><a href={`${f.href}#technologies`} class="nav-sous">Technologies</a></li>
											<li><a href={`${f.href}#couts`} class="nav-sous">Coûts détaillés</a></li>
										</ul>
									</div>
								))}
							</div>
						</div>
					</div>

					<a href="/notre-histoire" class="nav-link" aria-current={chemin === '/notre-histoire' ? 'page' : undefined}>Notre histoire</a>
					<a href="/devis" class="nav-link" aria-current={chemin === '/devis' ? 'page' : undefined}>Devis</a>
				</nav>

				<div class="flex items-center gap-2">
					<a href="/contact" class="btn btn-dark btn-sm hidden sm:inline-flex">
						Nous contacter <ArrowRight size={15} class="btn-arrow" />
					</a>
					<!-- Bouton menu mobile -->
					<button id="mobile-menu-btn" type="button" class="burger lg:hidden" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-nav">
						<span></span><span></span>
					</button>
				</div>
			</div>

			<!-- Menu mobile -->
			<div id="mobile-nav" class="mobile-nav lg:hidden" data-open="false" data-lenis-prevent>
				<nav class="flex flex-col p-5" aria-label="Navigation mobile">
					{liens.map((l, i) => (
						<a href={l.href} class="mobile-nav-item mobile-nav-lien" style={`--i:${i}`}>
							{l.label} <span class="repere">0{i + 1}</span>
						</a>
					))}
					<div class="mobile-nav-item mt-5 grid grid-cols-3 gap-2" style={`--i:${liens.length}`}>
						{formules.map((f) => (
							<a href={f.href} class="rounded-2xl border border-filet px-3 py-3 text-center text-sm font-medium">{f.label}</a>
						))}
					</div>
					<div class="mobile-nav-item mt-3 grid grid-cols-2 gap-2" style={`--i:${liens.length + 1}`}>
						<a href={contact.telephoneHref} class="btn btn-dark justify-center"><Phone size={16} /> Appeler</a>
						<a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp justify-center">
							<BrandIcon name="whatsapp" size={17} /> WhatsApp
						</a>
					</div>
				</nav>
			</div>
		</header>

		<main id="contenu" class="flex-1 overflow-x-clip">
			<slot />
		</main>

		<!-- PIED DE PAGE -->
		<footer class="site-footer sur-nuit relative overflow-hidden">
			<div class="conteneur relative">
				{footerCta && (
				<div class="flex flex-col items-start justify-between gap-8 border-b border-white/15 py-14 md:flex-row md:items-end lg:py-20">
					<div>
						<p class="titre-xl max-w-[14ch]">Un projet de site en tête ?</p>
						<p class="chapo mt-4">Un appel d’une quinzaine de minutes suffit pour savoir quelle formule vous convient.</p>
					</div>
					<div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
						<a href="/contact" class="btn btn-accent btn-lg justify-center">
							Nous écrire <ArrowRight size={17} class="btn-arrow" />
						</a>
						<a href={contact.telephoneHref} class="btn btn-ghost-dark btn-lg num justify-center">
							<Phone size={16} /> {contact.telephone}
						</a>
					</div>
				</div>
				)}

				<div class="grid gap-x-8 gap-y-12 py-14 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1.3fr]">
					<div class="sm:col-span-2 lg:col-span-1">
						<a href="/" class="logo text-2xl" aria-label="SaberWeb.dev, accueil">
							<span>SaberWeb</span><span class="logo-point">.</span><span class="logo-ext">dev</span>
						</a>
						<p class="mt-4 max-w-xs text-sm leading-relaxed text-stone-400">Sites vitrines et plateformes de réservation pour les indépendants et les petites entreprises.</p>
						<ul class="mt-6 flex items-center gap-2" aria-label="Nous suivre et nous écrire">
							<li>
								<a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="social" aria-label="Nous écrire sur WhatsApp">
									<BrandIcon name="whatsapp" size={17} />
								</a>
							</li>
							{membres.map((m) => (
								<li>
									<a href={m.linkedin} target="_blank" rel="noopener noreferrer" class="social" aria-label={`Profil LinkedIn de ${m.prenom}`} title={`LinkedIn de ${m.prenom}`}>
										<BrandIcon name="linkedin" size={16} />
									</a>
								</li>
							))}
							{contact.email && (
								<li>
									<a href={`mailto:${contact.email}`} class="social" aria-label="Nous écrire par e-mail"><Mail size={17} /></a>
								</li>
							)}
						</ul>
					</div>
					<div>
						<p class="footer-title">Navigation</p>
						<ul class="mt-4 space-y-2.5 text-sm">
							{liens.map((l) => <li><a href={l.href} class="footer-link">{l.label}</a></li>)}
						</ul>
					</div>
					<div>
						<p class="footer-title">Formules</p>
						<ul class="mt-4 space-y-2.5 text-sm">
							{formules.map((f) => (
								<li><a href={f.href} class="footer-link">{f.label}</a></li>
							))}
							<li><a href="/devis" class="footer-link inline-flex items-center gap-1">Simuler un devis <ArrowUpRight size={14} /></a></li>
						</ul>
					</div>
					<div>
						<p class="footer-title">L’équipe</p>
						<ul class="mt-4 space-y-3">
							{membres.map((m) => (
								<li>
									<a href={m.linkedin} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3" aria-label={`Profil LinkedIn de ${m.prenom}`}>
										<Avatar photo={m.photo} initiales={m.initiales} prenom={m.prenom} size={40} class="ring-1 ring-white/20" />
										<span class="min-w-0">
											<span class="block text-sm font-medium text-stone-100 transition-colors group-hover:text-accent-clair">{m.prenom}</span>
											<span class="block truncate text-xs text-stone-400">{m.role}</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				</div>

				<div class="flex flex-col items-start justify-between gap-4 border-t border-white/15 py-6 text-sm md:flex-row md:items-center">
					<p class="num text-stone-400">© {currentYear} SaberWeb.dev</p>
					<ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
						{legal.map((l) => <li><a href={l.href} class="footer-link">{l.label}</a></li>)}
						<li><button type="button" class="footer-link" data-cookie-settings>Gérer mes cookies</button></li>
					</ul>
				</div>
			</div>
			<p class="footer-marque -mb-[0.06em] text-center" aria-hidden="true">SaberWeb.dev</p>
		</footer>

		<CookieBanner policyHref="/cookies" />

		<script>
			import { initReveal, pauseOffscreen } from '@/lib/motion/reveal';

			// Apparitions au défilement (socle commun) et bandeaux en pause hors écran.
			initReveal();
			pauseOffscreen('.marquee');

			// Pilule de navigation : se compacte dès que la page défile.
			const header = document.querySelector<HTMLElement>('[data-site-nav]');
			if (header) {
				let frame = 0;
				const update = () => {
					frame = 0;
					header.classList.toggle('is-compact', window.scrollY > 40);
				};
				window.addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(update); }, { passive: true });
				update();
			}

			// Menu « Formules » : survol et focus en CSS ; clic (tactile) et Échap ici.
			const menu = document.querySelector<HTMLElement>('[data-nav-menu]');
			const menuBtn = menu?.querySelector<HTMLButtonElement>('button');
			if (menu && menuBtn) {
				const sync = () => menuBtn.setAttribute('aria-expanded', String(menu.dataset.open === 'true' || (menu.dataset.open !== 'false' && menu.matches(':hover, :focus-within'))));
				const setMenu = (state: 'true' | 'false' | undefined) => {
					if (state) menu.dataset.open = state;
					else delete menu.dataset.open;
					sync();
				};
				menuBtn.addEventListener('click', () => setMenu(menu.dataset.open === 'true' ? 'false' : 'true'));
				menu.addEventListener('mouseenter', sync);
				menu.addEventListener('mouseleave', () => setMenu(undefined));
				menu.addEventListener('focusin', sync);
				menu.addEventListener('focusout', (e) => {
					if (!menu.contains(e.relatedTarget as Node | null)) setMenu(undefined);
				});
				menu.addEventListener('keydown', (e) => {
					if (e.key !== 'Escape') return;
					setMenu('false');
					menuBtn.focus();
				});
				document.addEventListener('click', (e) => {
					if (!menu.contains(e.target as Node)) setMenu(undefined);
				});
			}

			// Menu mobile
			const btn = document.getElementById('mobile-menu-btn');
			const nav = document.getElementById('mobile-nav');
			if (btn && nav) {
				const setOpen = (open: boolean) => {
					nav.dataset.open = String(open);
					btn.setAttribute('aria-expanded', String(open));
					btn.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
				};
				btn.addEventListener('click', () => setOpen(nav.dataset.open !== 'true'));
				nav.addEventListener('click', (e) => {
					if ((e.target as HTMLElement).closest('a')) setOpen(false);
				});
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && nav.dataset.open === 'true') {
						setOpen(false);
						btn.focus();
					}
				});
			}
		</script>
		<SmoothScroll />
	</body>
</html>
