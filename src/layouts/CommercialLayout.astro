---
import '../styles/global.css';
import 'aos/dist/aos.css';
import { Briefcase, Menu, X, Code2 } from 'lucide-react';
import SmoothScroll from '@/components/SmoothScroll.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const currentYear = new Date().getFullYear();

const navLinks = [
	{ label: 'Présentation', href: '/#presentation' },
	{ label: 'Notre histoire', href: '/#histoire' },
	{ label: 'Contact', href: '/#contact' },
];
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<meta name="theme-color" content="#1c1917" />
	</head>
	<body class="commercial-page flex min-h-screen flex-col bg-stone-50 selection:bg-stone-900 selection:text-white">
		
		<!-- HEADER COMMERCIAL -->
		<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-stone-200">
			<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
				<a href="/" class="flex items-center gap-2 group">
					<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-stone-900 text-white transition-transform group-hover:scale-105">
						<Code2 size={20} />
					</div>
					<span class="text-lg font-extrabold text-stone-900 tracking-tight">SaberWeb<span class="text-stone-400">.dev</span></span>
				</a>

				<!-- Desktop Nav -->
				<nav class="hidden md:flex items-center gap-8">
					<a href="/#presentation" class="text-sm font-semibold text-stone-600 hover:text-stone-900 transition-colors">
						Présentation
					</a>
					<a href="/#histoire" class="text-sm font-semibold text-stone-600 hover:text-stone-900 transition-colors">
						Notre histoire
					</a>
					
					<!-- Mega Menu Galerie -->
					<div class="relative group">
						<button class="flex items-center gap-1 text-sm font-semibold text-stone-600 group-hover:text-stone-900 transition-colors pb-6 -mb-6">
							Galerie
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
						</button>
						
						<!-- Dropdown Panel -->
						<div class="absolute top-full left-1/2 -translate-x-1/2 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 w-[700px] z-[100]">
							<div class="rounded-2xl border border-stone-200 bg-white p-8 shadow-2xl grid grid-cols-3 gap-8">
								<!-- Colonne Standard -->
								<div>
									<a href="/galerie/standard" class="block mb-4">
										<h4 class="font-bold text-prussian-blue-600 hover:text-prussian-blue-500 transition-colors flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-prussian-blue-500"></div> Démo Standard</h4>
									</a>
									<ul class="space-y-3 text-sm text-stone-500 font-medium ml-4">
										<li><a href="/galerie/standard#fonctionnalites" class="hover:text-prussian-blue-500 transition-colors block">Fonctionnalités</a></li>
										<li><a href="/galerie/standard#technologies" class="hover:text-prussian-blue-500 transition-colors block">Technologies</a></li>
										<li><a href="/galerie/standard#couts" class="hover:text-prussian-blue-500 transition-colors block">Coûts détaillés</a></li>
									</ul>
								</div>
								
								<!-- Colonne Premium -->
								<div class="border-l border-stone-100 pl-8">
									<a href="/galerie/premium" class="block mb-4">
										<h4 class="font-bold text-brick-ember-500 hover:text-brick-ember-400 transition-colors flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-brick-ember-500"></div> Démo Premium</h4>
									</a>
									<ul class="space-y-3 text-sm text-stone-500 font-medium ml-4">
										<li><a href="/galerie/premium#fonctionnalites" class="hover:text-brick-ember-500 transition-colors block">Fonctionnalités</a></li>
										<li><a href="/galerie/premium#technologies" class="hover:text-brick-ember-500 transition-colors block">Technologies</a></li>
										<li><a href="/galerie/premium#couts" class="hover:text-brick-ember-500 transition-colors block">Coûts détaillés</a></li>
									</ul>
								</div>
								
								<!-- Colonne Diamant -->
								<div class="border-l border-stone-100 pl-8">
									<a href="/galerie/diamant" class="block mb-4">
										<h4 class="font-bold text-deep-teal-600 hover:text-deep-teal-500 transition-colors flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-deep-teal-500"></div> Démo Diamant</h4>
									</a>
									<ul class="space-y-3 text-sm text-stone-500 font-medium ml-4">
										<li><a href="/galerie/diamant#fonctionnalites" class="hover:text-deep-teal-500 transition-colors block">Fonctionnalités</a></li>
										<li><a href="/galerie/diamant#technologies" class="hover:text-deep-teal-500 transition-colors block">Technologies</a></li>
										<li><a href="/galerie/diamant#couts" class="hover:text-deep-teal-500 transition-colors block">Coûts détaillés</a></li>
									</ul>
								</div>
							</div>
						</div>
					</div>

					<a href="/#contact" class="text-sm font-semibold text-stone-600 hover:text-stone-900 transition-colors">
						Contact
					</a>
				</nav>

				<div class="hidden md:block">
					<a href="#contact" class="rounded-full bg-stone-900 px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-stone-800">
						Démarrer un projet
					</a>
				</div>

				<!-- Mobile Menu Toggle -->
				<button id="mobile-menu-btn" class="md:hidden text-stone-900 focus:outline-none">
					<span id="icon-menu"><Menu size={24} /></span>
					<span id="icon-close" class="hidden"><X size={24} /></span>
				</button>
			</div>

			<!-- Mobile Nav -->
			<div id="mobile-nav" class="hidden border-t border-stone-200 bg-white md:hidden">
				<nav class="flex flex-col px-6 py-4 gap-4">
					<a href="/#presentation" class="text-lg font-semibold text-stone-700 hover:text-stone-900">Présentation</a>
					<a href="/#histoire" class="text-lg font-semibold text-stone-700 hover:text-stone-900">Notre histoire</a>
					
					<div class="py-2 border-y border-stone-100">
						<p class="text-sm font-bold text-stone-400 mb-3 uppercase tracking-wider">Galerie Démos</p>
						<div class="flex flex-col gap-3 pl-4 border-l-2 border-stone-100">
							<a href="/galerie/standard" class="text-lg font-semibold text-prussian-blue-600">Standard</a>
							<a href="/galerie/premium" class="text-lg font-semibold text-brick-ember-600">Premium</a>
							<a href="/galerie/diamant" class="text-lg font-semibold text-deep-teal-600">Diamant</a>
						</div>
					</div>

					<a href="/#contact" class="text-lg font-semibold text-stone-700 hover:text-stone-900">Contact</a>

					<div class="mt-4 pt-4 border-t border-stone-100">
						<a href="#contact" class="block text-center rounded-xl bg-stone-900 px-5 py-3 text-sm font-bold text-white">
							Démarrer un projet
						</a>
					</div>
				</nav>
			</div>
		</header>

		<main class="flex-1">
			<slot />
		</main>

		<!-- FOOTER COMMERCIAL -->
		<footer class="bg-stone-900 text-stone-400 py-12">
			<div class="mx-auto max-w-6xl px-6 flex flex-col md:flex-row items-center justify-between gap-6">
				<div class="flex items-center gap-2">
					<Code2 size={20} class="text-white" />
					<span class="text-lg font-bold text-white">SaberWeb.dev</span>
				</div>
				<p class="text-sm">© {currentYear} Tous droits réservés.</p>
				<div class="flex gap-4">
					<a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LinkedIn</a>
					<a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a>
				</div>
			</div>
		</footer>

		<script>
			import AOS from 'aos';
			AOS.init({
				duration: 800,
				easing: 'ease-out-cubic',
				once: true,
				offset: 50,
			});

			const btn = document.getElementById('mobile-menu-btn');
			const nav = document.getElementById('mobile-nav');
			const iconMenu = document.getElementById('icon-menu');
			const iconClose = document.getElementById('icon-close');

			if (btn && nav && iconMenu && iconClose) {
				btn.addEventListener('click', () => {
					nav.classList.toggle('hidden');
					iconMenu.classList.toggle('hidden');
					iconClose.classList.toggle('hidden');
				});
			}
		</script>
		<SmoothScroll />
	</body>
</html>
