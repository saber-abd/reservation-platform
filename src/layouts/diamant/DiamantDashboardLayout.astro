---
// Layout de l'espace pro et de l'espace client Diamant. Il reprend les polices (Fraunces, Hanken Grotesk)
// et la palette du site public (jetons dx-* de diamant.css, section « Espaces connectés »).
// Coque : barre latérale repliable sur bureau (état mémorisé dans localStorage), tiroir sur mobile,
// barre du haut avec la palette de commandes (espace pro). La logique (garde de bannissement,
// nom du salon synchronisé, tiroir mobile) est inchangée.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk/index.css';
import '../../styles/diamant.css';
import { ArrowLeft, PanelLeftClose, PanelLeftOpen } from 'lucide-react';
import { getSiteConfig } from '@/config/site';

import DiamantClientBanGuard from '@/components/diamant/dashboard/DiamantClientBanGuard';
import DiamantToaster from '@/components/diamant/dashboard/kit/DiamantToaster';
import DiamantCommandPalette from '@/components/diamant/dashboard/kit/DiamantCommandPalette';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);

interface Props {
	title?: string;
}

const { title = 'Espace' } = Astro.props;

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';
const isClientSpace = currentPath.includes('/espace-client');
const espace = isClientSpace ? 'Espace client' : 'Espace pro';
const initiale = (siteConfig.business.name || 'O').trim().charAt(0).toUpperCase();
---

<!doctype html>
<html lang="fr" class="theme-diamant dashboard-diamant">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — {siteConfig.business.name}</title>
		<meta name="theme-color" content="#f5efe6" />
		<script is:inline>
			// Barre latérale repliée (préférence d'affichage) : posée avant le premier rendu, sans saut.
			try {
				if (localStorage.getItem('diamant_dash_replie') === '1') document.documentElement.setAttribute('data-dx-replie', 'true');
			} catch (e) {}

			function syncDiamantBusinessName() {
				try {
					var saved = localStorage.getItem('diamant_pro_profile');
					var name = null;
					if (saved) {
						var parsed = JSON.parse(saved);
						if (parsed && parsed.business_name) name = parsed.business_name;
					}
					if (!name) {
						var match = document.cookie.match(/(?:^|;\s*)diamant_business_name=([^;]+)/);
						if (match) name = decodeURIComponent(match[1]);
					}
					if (name) {
						document.querySelectorAll('[data-diamant-business-name]').forEach(function(el) {
							el.textContent = name;
						});
						document.querySelectorAll('[data-diamant-business-initial]').forEach(function(el) {
							el.textContent = name.trim().charAt(0).toUpperCase();
						});
					}
				} catch (e) {}
			}
			syncDiamantBusinessName();
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', syncDiamantBusinessName);
			}
			window.addEventListener('storage', function(e) {
				if (e.key === 'diamant_pro_profile') syncDiamantBusinessName();
			});
			window.addEventListener('diamant:profile-updated', syncDiamantBusinessName);

			// Détection rapide ban client
			try {
				if (window.location.pathname.indexOf('/espace-client') !== -1) {
					var bannedCookie = document.cookie.match(/(?:^|;\s*)diamant_banned_clients=([^;]+)/);
					var bList = [];
					if (bannedCookie) {
						bList = JSON.parse(decodeURIComponent(bannedCookie[1]));
					} else {
						var rawB = localStorage.getItem('diamant_banned_clients');
						if (rawB) bList = JSON.parse(rawB);
					}
					var uEmail = localStorage.getItem('diamant_client_email');
					if (uEmail && Array.isArray(bList)) {
						var isB = bList.some(function(b) {
							return (b.clientEmail && b.clientEmail.toLowerCase() === uEmail.toLowerCase()) ||
							       (b.email && b.email.toLowerCase() === uEmail.toLowerCase());
						});
						if (isB) document.documentElement.classList.add('diamant-client-banned');
					}
				}
			} catch (e) {}
		</script>
	</head>
	<body>
		<a href="#dashboard-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[90] focus:rounded-full focus:bg-dx-encre focus:px-4 focus:py-2 focus:text-sm focus:text-white">Aller au contenu</a>
		<div class="relative flex min-h-dvh">
			{/* Barre latérale (tiroir sur mobile, repliable sur bureau) */}
			<aside id="dash-drawer" data-open="false" class="dash-drawer dx-side relative z-10 flex shrink-0 flex-col md:sticky md:top-0 md:h-dvh md:self-start" aria-label="Navigation de l’espace">
				<div class="flex h-16 flex-none items-center gap-3 border-b border-dx-filet px-[18px]">
					<a href={`${basePath}/`} aria-label="Accueil du site" class="group flex min-w-0 items-center gap-3">
						<span class="dx-monogramme" aria-hidden="true" data-diamant-business-initial>{initiale}</span>
						<span class="dx-label dx-marque truncate text-[1.4rem] transition-colors group-hover:text-dx-terre" data-diamant-business-name>{siteConfig.business.name}</span>
					</a>
				</div>
				<div class="flex-1 overflow-y-auto overflow-x-hidden px-3 py-5">
					<slot name="sidebar" />
				</div>
				<div class="flex flex-none flex-col gap-1 border-t border-dx-filet p-3">
					<a href={`${basePath}/`} class="dx-nav-lien" title="Retour au site">
						<ArrowLeft size={17} />
						<span class="dx-label">Retour au site</span>
					</a>
					<button id="dx-replier" type="button" class="dx-nav-lien hidden w-full md:flex" aria-controls="dash-drawer" aria-expanded="true" title="Replier la barre latérale">
						<PanelLeftClose size={17} className="dx-si-deplie" />
						<PanelLeftOpen size={17} className="dx-si-replie" />
						<span class="dx-label">Replier le menu</span>
					</button>
				</div>
			</aside>

			{/* Contenu */}
			<main id="dx-main" class="relative min-w-0 flex-1 overflow-x-clip">
				<header class="dx-topbar">
					<button id="dash-menu-btn" type="button" class="dash-burger -ml-1.5 text-dx-encre md:hidden" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="dash-drawer">
						<span></span><span></span><span></span>
					</button>
					<a href={`${basePath}/`} class="dx-marque min-w-0 truncate text-[1.25rem] md:hidden" data-diamant-business-name>{siteConfig.business.name}</a>
					<p class="hidden min-w-0 items-baseline gap-2 truncate text-sm md:flex">
						<span class="text-dx-gris">{espace}</span>
						<span class="text-dx-sable" aria-hidden="true">/</span>
						<span class="truncate font-semibold text-dx-encre">{title}</span>
					</p>
					<div class="ml-auto flex items-center gap-3">
						{!isClientSpace && <DiamantCommandPalette client:idle basePath={basePath} />}
					</div>
				</header>

				<div class="mx-auto w-full max-w-[1280px] px-4 pb-32 pt-7 sm:px-6 md:px-10 md:pb-16 md:pt-10">
					<div id="dashboard-content">
						{isClientSpace ? (
							<DiamantClientBanGuard client:load basePath={basePath}>
								<slot />
							</DiamantClientBanGuard>
						) : (
							<slot />
						)}
					</div>
				</div>
			</main>
			<div id="dash-backdrop" class="dash-backdrop" data-open="false" aria-hidden="true"></div>
		</div>

		<DiamantToaster client:load />
	</body>
</html>

<style>
	/* Tiroir de navigation sur mobile : la barre latérale glisse depuis la gauche. */
	@media (max-width: 767px) {
		.dash-drawer {
			position: fixed;
			inset-block: 0;
			left: 0;
			z-index: 60;
			width: min(18rem, 85vw);
			transform: translateX(-100%);
			transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
		}
		.dash-drawer[data-open='true'] { transform: none; box-shadow: 0 30px 80px -30px rgb(26 20 17 / 0.5); }
		.dash-backdrop {
			position: fixed;
			inset: 0;
			z-index: 55;
			background: rgb(26 20 17 / 0.5);
			opacity: 0;
			visibility: hidden;
			transition: opacity 0.3s ease, visibility 0s linear 0.3s;
		}
		.dash-backdrop[data-open='true'] { opacity: 1; visibility: visible; transition: opacity 0.3s ease, visibility 0s; }
	}
	@media (min-width: 768px) { .dash-backdrop { display: none; } }

	.dash-burger { position: relative; width: 40px; height: 40px; border-radius: 999px; flex: none; }
	.dash-burger span {
		position: absolute;
		left: 11px;
		width: 18px;
		height: 1.5px;
		border-radius: 2px;
		background: currentColor;
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease;
	}
	.dash-burger span:nth-child(1) { top: 14px; }
	.dash-burger span:nth-child(2) { top: 19.5px; }
	.dash-burger span:nth-child(3) { top: 25px; }
	.dash-burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
	.dash-burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
	.dash-burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

	@media (prefers-reduced-motion: reduce) {
		.dash-drawer, .dash-backdrop, .dash-burger span { transition-duration: 0.01ms !important; }
	}
</style>

<script>
	const drawer = document.getElementById('dash-drawer');
	const backdrop = document.getElementById('dash-backdrop');
	const toggle = document.getElementById('dash-menu-btn');
	if (drawer && backdrop && toggle) {
		const setOpen = (open: boolean) => {
			drawer.dataset.open = String(open);
			backdrop.dataset.open = String(open);
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
		};
		toggle.addEventListener('click', () => setOpen(drawer.dataset.open !== 'true'));
		backdrop.addEventListener('click', () => setOpen(false));
		drawer.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('a')) setOpen(false);
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});
	}

	// Barre latérale repliable (bureau) : préférence d'affichage seulement.
	const replier = document.getElementById('dx-replier');
	if (replier) {
		const html = document.documentElement;
		const maj = () => {
			const replie = html.getAttribute('data-dx-replie') === 'true';
			replier.setAttribute('aria-expanded', String(!replie));
			replier.setAttribute('title', replie ? 'Déplier la barre latérale' : 'Replier la barre latérale');
			replier.setAttribute('aria-label', replie ? 'Déplier la barre latérale' : 'Replier la barre latérale');
		};
		maj();
		replier.addEventListener('click', () => {
			const replie = html.getAttribute('data-dx-replie') !== 'true';
			if (replie) html.setAttribute('data-dx-replie', 'true');
			else html.removeAttribute('data-dx-replie');
			try {
				localStorage.setItem('diamant_dash_replie', replie ? '1' : '0');
			} catch (e) {}
			maj();
		});
	}
</script>
