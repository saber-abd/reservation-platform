---
import '../../styles/diamant.css';
import { Scissors, ArrowLeft } from 'lucide-react';
import { getSiteConfig } from '@/config/site';

import DiamantClientBanGuard from '@/components/diamant/dashboard/DiamantClientBanGuard';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);

interface Props {
	title?: string;
}

const { title = 'Espace Prestige' } = Astro.props;

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';
const isClientSpace = currentPath.includes('/espace-client');
---

<!doctype html>
<html lang="fr" class="theme-diamant dashboard-diamant">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — Prestige Diamant</title>
		<meta name="theme-color" content="#fff7f1" />
		<script is:inline>
			function syncDiamantBusinessName() {
				try {
					var saved = localStorage.getItem('diamant_pro_profile');
					var name = null;
					if (saved) {
						var parsed = JSON.parse(saved);
						if (parsed && parsed.business_name) name = parsed.business_name;
					}
					if (!name) {
						var match = document.cookie.match(/(?:^|;\s*)diamant_business_name=([^;]+)/);
						if (match) name = decodeURIComponent(match[1]);
					}
					if (name) {
						document.querySelectorAll('[data-diamant-business-name]').forEach(function(el) {
							el.textContent = name;
						});
					}
				} catch (e) {}
			}
			syncDiamantBusinessName();
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', syncDiamantBusinessName);
			}
			window.addEventListener('storage', function(e) {
				if (e.key === 'diamant_pro_profile') syncDiamantBusinessName();
			});
			window.addEventListener('diamant:profile-updated', syncDiamantBusinessName);

			// Détection rapide ban client
			try {
				if (window.location.pathname.indexOf('/espace-client') !== -1) {
					var bannedCookie = document.cookie.match(/(?:^|;\s*)diamant_banned_clients=([^;]+)/);
					var bList = [];
					if (bannedCookie) {
						bList = JSON.parse(decodeURIComponent(bannedCookie[1]));
					} else {
						var rawB = localStorage.getItem('diamant_banned_clients');
						if (rawB) bList = JSON.parse(rawB);
					}
					var uEmail = localStorage.getItem('diamant_client_email');
					if (uEmail && Array.isArray(bList)) {
						var isB = bList.some(function(b) {
							return (b.clientEmail && b.clientEmail.toLowerCase() === uEmail.toLowerCase()) ||
							       (b.email && b.email.toLowerCase() === uEmail.toLowerCase());
						});
						if (isB) document.documentElement.classList.add('diamant-client-banned');
					}
				}
			} catch (e) {}
		</script>
	</head>
	<body class="bg-stone-50 text-stone-800 overflow-hidden font-coolvetica">
		<div class="flex h-screen relative">
			{/* Sidebar */}
			<aside id="dash-drawer" data-open="false" class="dash-drawer w-64 flex-shrink-0 border-r border-stone-200 bg-white flex flex-col shadow-sm z-10 relative" aria-label="Navigation de l’espace">
				<div class="p-5 border-b border-stone-100 flex items-center gap-3">
					<a href={`${basePath}/`} aria-label="Accueil" class="flex items-center gap-3 group">
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-deep-teal-400 to-deep-teal-600 text-white transition-transform group-hover:scale-105">
							<Scissors size={18} />
						</span>
						<span class="text-base font-bold tracking-widest text-stone-800 uppercase" data-diamant-business-name>{siteConfig.business.name}</span>
					</a>
				</div>
				<div class="flex-1 overflow-y-auto p-4">
					<slot name="sidebar" />
				</div>
				<div class="p-4 border-t border-stone-100">
					<a href={`${basePath}/`} class="flex items-center justify-center gap-2 rounded-xl border border-stone-200 bg-stone-50 px-4 py-2.5 text-sm font-bold uppercase tracking-wider text-stone-500 transition-colors hover:border-deep-teal-300 hover:text-deep-teal-600 hover:bg-deep-teal-50">
						<ArrowLeft size={15} />
						Retour au site
					</a>
				</div>
			</aside>

			{/* Main Content */}
			<main class="flex-1 overflow-y-auto bg-stone-50 relative z-10">
				{/* Mobile Header */}
				<header class="md:hidden sticky top-0 z-50 border-b border-stone-200 bg-white px-6 py-4 flex items-center justify-between shadow-sm">
					<a href={`${basePath}/`} aria-label="Accueil Prestige" class="flex items-center gap-3">
						<span class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-deep-teal-400 to-deep-teal-600 text-white">
							<Scissors size={16} />
						</span>
						<span class="text-base font-bold tracking-widest text-stone-800 uppercase" data-diamant-business-name>{siteConfig.business.name}</span>
					</a>
					<button id="dash-menu-btn" type="button" class="dash-burger text-stone-800" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="dash-drawer">
						<span></span><span></span><span></span>
					</button>
				</header>

				<div class="mx-auto max-w-6xl px-4 py-8 md:px-8 md:py-10">
				<div id="dashboard-content">
					{isClientSpace ? (
						<DiamantClientBanGuard client:load basePath={basePath}>
							<slot />
						</DiamantClientBanGuard>
					) : (
						<slot />
					)}
				</div>
				</div>
			</main>
			<div id="dash-backdrop" class="dash-backdrop" data-open="false" aria-hidden="true"></div>
		</div>

	</body>
</html>

<style>
	/* Tiroir de navigation sur mobile : la barre latérale glisse depuis la gauche. */
	@media (max-width: 767px) {
		.dash-drawer {
			position: fixed;
			inset-block: 0;
			left: 0;
			z-index: 60;
			width: min(18rem, 85vw);
			transform: translateX(-100%);
			transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
		}
		.dash-drawer[data-open='true'] { transform: none; }
		.dash-backdrop {
			position: fixed;
			inset: 0;
			z-index: 55;
			background: rgb(12 10 9 / 0.5);
			opacity: 0;
			visibility: hidden;
			transition: opacity 0.3s ease, visibility 0s linear 0.3s;
		}
		.dash-backdrop[data-open='true'] { opacity: 1; visibility: visible; transition: opacity 0.3s ease, visibility 0s; }
	}
	@media (min-width: 768px) { .dash-backdrop { display: none; } }

	.dash-burger { position: relative; width: 40px; height: 40px; border-radius: 10px; }
	.dash-burger span {
		position: absolute;
		left: 10px;
		width: 20px;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease;
	}
	.dash-burger span:nth-child(1) { top: 13px; }
	.dash-burger span:nth-child(2) { top: 19px; }
	.dash-burger span:nth-child(3) { top: 25px; }
	.dash-burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
	.dash-burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
	.dash-burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

	@media (prefers-reduced-motion: reduce) {
		.dash-drawer, .dash-backdrop, .dash-burger span { transition-duration: 0.01ms !important; }
	}
</style>

<script>
	const drawer = document.getElementById('dash-drawer');
	const backdrop = document.getElementById('dash-backdrop');
	const toggle = document.getElementById('dash-menu-btn');
	if (drawer && backdrop && toggle) {
		const setOpen = (open: boolean) => {
			drawer.dataset.open = String(open);
			backdrop.dataset.open = String(open);
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
		};
		toggle.addEventListener('click', () => setOpen(drawer.dataset.open !== 'true'));
		backdrop.addEventListener('click', () => setOpen(false));
		drawer.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('a')) setOpen(false);
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});
	}
</script>
