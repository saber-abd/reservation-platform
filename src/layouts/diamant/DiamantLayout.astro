---
// Layout du site public Diamant (salon de coiffure) : ivoire chaud, Fraunces + Hanken Grotesk,
// défilement lissé (Lenis) raccordé à GSAP ScrollTrigger. Animations communes à toutes les pages
// dans le script plus bas ; les sections animées de l'accueil ont leur propre script.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk/index.css';
import '../../styles/diamant.css';
import DiamantHeader from '@/components/diamant/DiamantHeader.astro';
import DiamantFooter from '@/components/diamant/DiamantFooter.astro';
import CookieBanner from '@/components/shared/CookieBanner.astro';
import SmoothScroll from '@/components/shared/SmoothScroll.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = 'Accueil',
	description = `${siteConfig.business.name}, salon de coiffure : coupe, couleur, coiffage. Tarifs affichés et réservation en ligne.`,
	noindex = false,
} = Astro.props;

const pageTitle = `${title} — ${siteConfig.business.name}`;
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);
---

<!doctype html>
<html lang="fr" class="theme-diamant site-diamant">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{pageTitle}</title>

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content={siteConfig.business.name} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />

		<meta name="theme-color" content="#f5efe6" />
		<script is:inline>
			document.documentElement.classList.add('js');
			// Filet de sécurité : si les animations n'ont pas démarré, tout s'affiche.
			setTimeout(function () { document.documentElement.classList.add('dia-secours'); }, 3500);
		</script>
	</head>
	<body class="flex min-h-screen flex-col">
		<DiamantHeader />

		<main id="contenu" class="relative flex-1 overflow-x-clip">
			<slot />
		</main>

		<DiamantFooter />

		<SmoothScroll />
		<CookieBanner policyHref="/cookies" />
		<script>
			// Animations communes du site public : apparitions (data-reveal), titres découpés en lignes
			// (data-split : au défilement ; data-split="load" : dès le chargement), logos et bandeaux
			// mis en pause hors de l'écran.
			import { initReveal, pauseOffscreen } from '@/lib/motion/reveal';
			import { gsap, MQ, SplitText, splitLines, wireScroll } from '@/lib/motion/gsap';

			initReveal();
			pauseOffscreen('.marquee, .dia-logo');

			const mm = gsap.matchMedia();
			mm.add(MQ.motion, () => {
				document.querySelectorAll<HTMLElement>('[data-split]').forEach((titre) => {
					if (titre.dataset.split !== 'load') {
						splitLines(titre);
						return;
					}
					SplitText.create(titre, {
						type: 'lines',
						mask: 'lines',
						autoSplit: true,
						onSplit: (self) => {
							titre.classList.add('is-split');
							return gsap.from(self.lines, { yPercent: 110, duration: 1.15, ease: 'power4.out', stagger: 0.1, delay: 0.1 });
						},
					});
				});
			});
			wireScroll();
		</script>
	</body>
</html>
