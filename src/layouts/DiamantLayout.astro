---
import '../styles/global.css';
import 'aos/dist/aos.css';
import DiamantHeader from '@/components/diamant/DiamantHeader.astro';
import DiamantFooter from '@/components/diamant/DiamantFooter.astro';
import SmoothScroll from '@/components/SmoothScroll.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = "Prestige",
	description = "L'excellence de la coiffure haut de gamme. Un service sur-mesure dans un cadre luxueux et raffiné, conçu pour sublimer votre allure.",
	noindex = false,
} = Astro.props;

const pageTitle = `${title} — ${siteConfig.business.name} Diamant`;
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);
---

<!doctype html>
<html lang="fr" class="theme-diamant">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{pageTitle}</title>
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="Prestige Diamant" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />

		<meta name="theme-color" content="#fff7f1" />
		<style is:global>
			.theme-diamant body { font-family: 'Lato', sans-serif; }
			.theme-diamant:not(.dashboard-diamant) h1, 
			.theme-diamant:not(.dashboard-diamant) h2, 
			.theme-diamant:not(.dashboard-diamant) h3,
			.theme-diamant:not(.dashboard-diamant) h4, 
			.theme-diamant:not(.dashboard-diamant) h5, 
			.theme-diamant:not(.dashboard-diamant) h6 {
				font-family: 'Monimer Serif', 'Lato', serif;
			}
			/* Animations section-fade */
			.section-fade {
				opacity: 0;
				transform: translateY(24px);
				transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1), transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
			}
			.section-fade.visible {
				opacity: 1;
				transform: translateY(0);
			}

			/* Hover sur les cards avec priorité face à AOS */
			.card-hover {
				transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.28s ease !important;
				will-change: transform;
			}
			.card-hover:hover,
			[data-aos].card-hover:hover,
			[data-aos].aos-animate.card-hover:hover,
			html:not(.no-js) [data-aos].card-hover.aos-animate:hover {
				transform: translateY(-5px) !important;
				box-shadow: 0 14px 34px -8px rgba(0, 0, 0, 0.12) !important;
			}
			li.card-hover:hover,
			[data-aos].card-hover:hover {
				border-color: #5eead4 !important;
			}
		</style>
	</head>
	<body class="flex min-h-screen flex-col bg-[#fff7f1] text-stone-800 antialiased font-sans">
		<DiamantHeader />
		
		<main class="flex-1 overflow-x-hidden relative">
			<slot />
		</main>
		
		<DiamantFooter />
		
		<script>
			import AOS from 'aos';

			function initAnimations() {
				AOS.init({
					duration: 700,
					easing: 'ease-out-cubic',
					once: true,
					offset: 60,
				});

				// Support des éléments avec classe .section-fade
				if ('IntersectionObserver' in window) {
					const observer = new IntersectionObserver((entries) => {
						entries.forEach(entry => {
							if (entry.isIntersecting) {
								entry.target.classList.add('visible');
								observer.unobserve(entry.target);
							}
						});
					}, {
						threshold: 0.1,
						rootMargin: "0px 0px -30px 0px"
					});

					document.querySelectorAll('.section-fade:not(.visible)').forEach(el => {
						observer.observe(el);
					});
				} else {
					document.querySelectorAll('.section-fade').forEach(el => {
						el.classList.add('visible');
					});
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initAnimations);
			} else {
				initAnimations();
			}
			document.addEventListener('astro:page-load', initAnimations);
		</script>
		<SmoothScroll />
	</body>
</html>
