---
import '../styles/global.css';
import { Scissors, ArrowLeft, Search } from 'lucide-react';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);

interface Props {
	title?: string;
}

const { title = 'Espace Prestige' } = Astro.props;

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';
---

<!doctype html>
<html lang="fr" class="theme-diamant">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — Prestige Diamant</title>
		<meta name="theme-color" content="#0c0a09" />
	</head>
	<body class="bg-stone-950 text-stone-300 selection:bg-jasmine-500/30 selection:text-jasmine-200 overflow-hidden font-sans">
		<div class="flex h-screen relative">
			{/* Décoration de fond globale */}
			<div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
				<div class="absolute -left-64 -top-64 w-[500px] h-[500px] bg-deep-teal-900/20 rounded-full blur-[120px]"></div>
				<div class="absolute -right-64 -bottom-64 w-[500px] h-[500px] bg-jasmine-900/10 rounded-full blur-[120px]"></div>
			</div>

			{/* Sidebar */}
			<aside class="w-64 flex-shrink-0 border-r border-white/10 bg-stone-950/80 backdrop-blur-xl flex flex-col hidden md:flex shadow-2xl z-10 relative">
				<div class="p-6 border-b border-white/10 flex items-center gap-3">
					<a href={`${basePath}/`} aria-label="Accueil Prestige" class="flex items-center gap-3 group">
						<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-deep-teal-500 to-deep-teal-800 text-jasmine-400 shadow-[0_0_20px_rgba(20,52,56,0.5)] group-hover:shadow-[0_0_30px_rgba(20,52,56,0.8)] transition-all">
							<Scissors size={20} />
						</span>
						<span class="text-xl font-bold tracking-widest text-white uppercase bg-clip-text text-transparent bg-gradient-to-r from-white to-stone-400">Prestige</span>
					</a>
				</div>
				<div class="flex-1 overflow-y-auto p-4 custom-scrollbar">
					<slot name="sidebar" />
				</div>
				<div class="p-4 border-t border-white/10">
					<a href={`${basePath}/`} class="flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-stone-900/50 px-4 py-3 text-sm font-bold uppercase tracking-wider text-stone-400 transition-colors hover:border-jasmine-400 hover:text-jasmine-300 hover:bg-stone-900">
						<ArrowLeft size={16} />
						Retour au site
					</a>
				</div>
			</aside>

			{/* Main Content */}
			<main class="flex-1 overflow-y-auto bg-stone-950/40 relative z-10 custom-scrollbar">
				{/* Mobile Header */}
				<header class="md:hidden sticky top-0 z-50 border-b border-white/10 bg-stone-950/80 backdrop-blur-md px-6 py-4 flex items-center justify-between shadow-lg">
					<a href={`${basePath}/`} aria-label="Accueil Prestige" class="flex items-center gap-3">
						<span class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-deep-teal-500 to-deep-teal-800 text-jasmine-400 shadow-[0_0_15px_rgba(20,52,56,0.5)]">
							<Scissors size={16} />
						</span>
						<span class="text-lg font-bold tracking-widest text-white uppercase">Prestige</span>
					</a>
				</header>
				<div class="mx-auto max-w-6xl px-4 py-8 md:px-8 md:py-12 relative z-10">
					{/* Global Search Bar */}
					<div class="mb-8 flex items-center gap-3 rounded-2xl border border-white/10 bg-stone-900/50 px-4 py-3 shadow-inner focus-within:border-jasmine-400 focus-within:ring-1 focus-within:ring-jasmine-400 transition-all">
						<Search size={18} className="text-stone-400" />
						<input 
							type="text" 
							placeholder="Rechercher un RDV, une date, un client, ou une prestation..." 
							class="w-full bg-transparent text-sm text-stone-200 placeholder-stone-500 focus:outline-none"
						/>
					</div>
					
					{/* For mobile, nav slot rendering */}
					<div class="md:hidden mb-8">
						<slot name="sidebar" />
					</div>
					<slot />
				</div>
			</main>
		</div>
		
		<style>
			/* Custom scrollbar for dark mode */
			.custom-scrollbar::-webkit-scrollbar {
				width: 6px;
				height: 6px;
			}
			.custom-scrollbar::-webkit-scrollbar-track {
				background: rgba(255, 255, 255, 0.02);
			}
			.custom-scrollbar::-webkit-scrollbar-thumb {
				background: rgba(255, 255, 255, 0.1);
				border-radius: 10px;
			}
			.custom-scrollbar::-webkit-scrollbar-thumb:hover {
				background: rgba(255, 255, 255, 0.2);
			}
		</style>
	</body>
</html>
