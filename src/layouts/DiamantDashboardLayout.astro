---
import '../styles/global.css';
import { Scissors, ArrowLeft } from 'lucide-react';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);

interface Props {
	title?: string;
}

const { title = 'Espace Prestige' } = Astro.props;

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';
---

<!doctype html>
<html lang="fr" class="theme-diamant dashboard-diamant">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — Prestige Diamant</title>
		<meta name="theme-color" content="#fff7f1" />
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
		<style is:global>
			.dashboard-diamant,
			.dashboard-diamant body,
			.theme-diamant.dashboard-diamant body { 
				font-family: 'Coolvetica', sans-serif !important; 
			}
			.dashboard-diamant h1, .dashboard-diamant h2, .dashboard-diamant h3,
			.dashboard-diamant h4, .dashboard-diamant h5, .dashboard-diamant h6,
			.dashboard-diamant .font-black, .dashboard-diamant .font-bold,
			.theme-diamant.dashboard-diamant h1, .theme-diamant.dashboard-diamant h2, .theme-diamant.dashboard-diamant h3,
			.theme-diamant.dashboard-diamant h4, .theme-diamant.dashboard-diamant h5, .theme-diamant.dashboard-diamant h6,
			.theme-diamant.dashboard-diamant .font-black, .theme-diamant.dashboard-diamant .font-bold {
				font-family: 'Coolvetica', sans-serif !important; 
			}
			.card-hover {
				transition: transform 0.25s ease, box-shadow 0.25s ease;
			}
			.card-hover:hover {
				transform: translateY(-3px);
				box-shadow: 0 10px 28px rgba(0,0,0,0.08);
			}
		</style>
		<script is:inline>
			function syncDiamantBusinessName() {
				try {
					var saved = localStorage.getItem('diamant_pro_profile');
					var name = null;
					if (saved) {
						var parsed = JSON.parse(saved);
						if (parsed && parsed.business_name) name = parsed.business_name;
					}
					if (!name) {
						var match = document.cookie.match(/(?:^|;\s*)diamant_business_name=([^;]+)/);
						if (match) name = decodeURIComponent(match[1]);
					}
					if (name) {
						document.querySelectorAll('[data-diamant-business-name]').forEach(function(el) {
							el.textContent = name;
						});
					}
				} catch (e) {}
			}
			syncDiamantBusinessName();
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', syncDiamantBusinessName);
			}
			window.addEventListener('storage', function(e) {
				if (e.key === 'diamant_pro_profile') syncDiamantBusinessName();
			});
			window.addEventListener('diamant:profile-updated', syncDiamantBusinessName);
		</script>
	</head>
	<body class="bg-stone-50 text-stone-800 overflow-hidden font-coolvetica">
		<div class="flex h-screen relative">
			{/* Sidebar */}
			<aside class="w-64 flex-shrink-0 border-r border-stone-200 bg-white flex flex-col hidden md:flex shadow-sm z-10 relative">
				<div class="p-5 border-b border-stone-100 flex items-center gap-3">
					<a href={`${basePath}/`} aria-label="Accueil" class="flex items-center gap-3 group">
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-deep-teal-400 to-deep-teal-600 text-white transition-transform group-hover:scale-105">
							<Scissors size={18} />
						</span>
						<span class="text-base font-bold tracking-widest text-stone-800 uppercase" data-diamant-business-name>{siteConfig.business.name}</span>
					</a>
				</div>
				<div class="flex-1 overflow-y-auto p-4">
					<slot name="sidebar" />
				</div>
				<div class="p-4 border-t border-stone-100">
					<a href={`${basePath}/`} class="flex items-center justify-center gap-2 rounded-xl border border-stone-200 bg-stone-50 px-4 py-2.5 text-sm font-bold uppercase tracking-wider text-stone-500 transition-colors hover:border-deep-teal-300 hover:text-deep-teal-600 hover:bg-deep-teal-50">
						<ArrowLeft size={15} />
						Retour au site
					</a>
				</div>
			</aside>

			{/* Main Content */}
			<main class="flex-1 overflow-y-auto bg-stone-50 relative z-10">
				{/* Mobile Header */}
				<header class="md:hidden sticky top-0 z-50 border-b border-stone-200 bg-white px-6 py-4 flex items-center justify-between shadow-sm">
					<a href={`${basePath}/`} aria-label="Accueil Prestige" class="flex items-center gap-3">
						<span class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-deep-teal-400 to-deep-teal-600 text-white">
							<Scissors size={16} />
						</span>
						<span class="text-base font-bold tracking-widest text-stone-800 uppercase" data-diamant-business-name>{siteConfig.business.name}</span>
					</a>
				</header>

				<div class="mx-auto max-w-6xl px-4 py-8 md:px-8 md:py-10">
				<div id="dashboard-content">
					<slot />
				</div>
				</div>
			</main>
		</div>

	</body>
</html>
