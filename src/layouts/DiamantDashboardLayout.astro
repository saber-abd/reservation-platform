---
import '../styles/global.css';
import { Scissors, ArrowLeft, Search } from 'lucide-react';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);

interface Props {
	title?: string;
}

const { title = 'Espace Prestige' } = Astro.props;

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';
---

<!doctype html>
<html lang="fr" class="theme-diamant">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — Prestige Diamant</title>
		<meta name="theme-color" content="#fff7f1" />
	</head>
	<body class="bg-stone-50 text-stone-800 overflow-hidden font-sans">
		<div class="flex h-screen relative">
			{/* Sidebar */}
			<aside class="w-64 flex-shrink-0 border-r border-stone-200 bg-white flex flex-col hidden md:flex shadow-sm z-10 relative">
				<div class="p-5 border-b border-stone-100 flex items-center gap-3">
					<a href={`${basePath}/`} aria-label="Accueil Prestige" class="flex items-center gap-3 group">
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-deep-teal-400 to-deep-teal-600 text-white transition-transform group-hover:scale-105">
							<Scissors size={18} />
						</span>
						<span class="text-base font-bold tracking-widest text-stone-800 uppercase">Prestige</span>
					</a>
				</div>
				<div class="flex-1 overflow-y-auto p-4">
					<slot name="sidebar" />
				</div>
				<div class="p-4 border-t border-stone-100">
					<a href={`${basePath}/`} class="flex items-center justify-center gap-2 rounded-xl border border-stone-200 bg-stone-50 px-4 py-2.5 text-sm font-bold uppercase tracking-wider text-stone-500 transition-colors hover:border-deep-teal-300 hover:text-deep-teal-600 hover:bg-deep-teal-50">
						<ArrowLeft size={15} />
						Retour au site
					</a>
				</div>
			</aside>

			{/* Main Content */}
			<main class="flex-1 overflow-y-auto bg-stone-50 relative z-10">
				{/* Mobile Header */}
				<header class="md:hidden sticky top-0 z-50 border-b border-stone-200 bg-white px-6 py-4 flex items-center justify-between shadow-sm">
					<a href={`${basePath}/`} aria-label="Accueil Prestige" class="flex items-center gap-3">
						<span class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-deep-teal-400 to-deep-teal-600 text-white">
							<Scissors size={16} />
						</span>
						<span class="text-base font-bold tracking-widest text-stone-800 uppercase">Prestige</span>
					</a>
				</header>

				<div class="mx-auto max-w-6xl px-4 py-8 md:px-8 md:py-10">
					{/* Barre de recherche fonctionnelle */}
					<div class="mb-8 flex items-center gap-3 rounded-xl border border-stone-200 bg-white px-4 py-3 shadow-sm focus-within:border-deep-teal-400 focus-within:ring-2 focus-within:ring-deep-teal-100 transition-all">
						<Search size={17} className="text-stone-400 shrink-0" />
						<input
							id="dashboard-search"
							type="text"
							placeholder="Rechercher un client, un RDV, une prestation..."
							class="w-full bg-transparent text-sm text-stone-700 placeholder-stone-400 focus:outline-none"
						/>
						<kbd class="hidden sm:inline-flex items-center gap-1 rounded border border-stone-200 px-2 py-0.5 text-xs text-stone-400 font-mono">Entrée</kbd>
					</div>
					
					{/* Mobile: nav slot */}
					<div class="md:hidden mb-8">
						<slot name="sidebar" />
					</div>
					<div id="dashboard-content">
						<slot />
					</div>
				</div>
			</main>
		</div>

		<script>
			// Barre de recherche fonctionnelle — filtre en temps réel
			const searchInput = document.getElementById('dashboard-search') as HTMLInputElement | null;
			
			if (searchInput) {
				function performSearch(query: string) {
					const q = query.toLowerCase().trim();
					// Cherche tous les éléments portant data-searchable
					const items = document.querySelectorAll('[data-searchable]');
					if (items.length === 0) return; // pas de contenu filtrable sur cette page
					
					items.forEach((item) => {
						const text = (item.textContent || '').toLowerCase();
						const el = item as HTMLElement;
						if (q === '' || text.includes(q)) {
							el.style.display = '';
						} else {
							el.style.display = 'none';
						}
					});

					// Afficher un message si aucun résultat
					let noResult = document.getElementById('search-no-result');
					const container = items[0]?.parentElement;
					const visible = Array.from(items).filter((el) => (el as HTMLElement).style.display !== 'none');
					
					if (q !== '' && visible.length === 0 && container) {
						if (!noResult) {
							noResult = document.createElement('p');
							noResult.id = 'search-no-result';
							noResult.className = 'text-sm text-stone-400 text-center py-8';
							noResult.textContent = 'Aucun résultat pour cette recherche.';
							container.appendChild(noResult);
						}
						noResult.style.display = '';
					} else if (noResult) {
						noResult.style.display = 'none';
					}
				}

				searchInput.addEventListener('input', (e) => {
					performSearch((e.target as HTMLInputElement).value);
				});

				searchInput.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') {
						searchInput.value = '';
						performSearch('');
					}
				});
			}
		</script>
	</body>
</html>
