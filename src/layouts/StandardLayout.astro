---
import '../styles/global.css';
import 'aos/dist/aos.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SmoothScroll from '@/components/SmoothScroll.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = siteConfig.business.name,
	description = siteConfig.business.description,
	noindex = false,
} = Astro.props;

const pageTitle = `${title} — ${siteConfig.business.activity}`;
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);
const basePath = "/demo-standard";
---

<!doctype html>
<html lang="fr" class="theme-standard scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{pageTitle}</title>
		<meta name="theme-color" content="#0f172a" />
	</head>
	<body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 font-sans selection:bg-blue-600 selection:text-white">
		<Header basePath={basePath} />
		<main class="flex-1 overflow-x-hidden">
			<slot />
		</main>
		<Footer basePath={basePath} />
		<script>
			import AOS from 'aos';

			AOS.init({
				duration: 800,
				easing: 'ease-out-cubic',
				once: true,
				offset: 50,
			});
		</script>
		<SmoothScroll />
	</body>
</html>
