---
import '@fontsource-variable/instrument-sans/index.css';
import '../../styles/standard.css';
import StandardHeader from '@/components/standard/StandardHeader.astro';
import Footer from '@/components/standard/StandardFooter.astro';
import CookieBanner from '@/components/shared/CookieBanner.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = siteConfig.business.name,
	description = siteConfig.business.description,
	noindex = false,
} = Astro.props;

const pageTitle = `${title} — ${siteConfig.business.activity}`;
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);
const basePath = "/demo-standard";
---

<!doctype html>
<html lang="fr" class="theme-standard">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{pageTitle}</title>
		<meta name="theme-color" content="#101b33" />
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body class="flex min-h-screen flex-col bg-paper text-ink font-sans">
		<a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">Aller au contenu</a>
		<StandardHeader basePath={basePath} />
		<main id="contenu" class="flex-1 overflow-x-clip">
			<slot />
		</main>
		<Footer basePath={basePath} />
		<script>
			import { initReveal, initCounters, pauseOffscreen } from '@/lib/motion/reveal';

			initReveal();
			initCounters();
			pauseOffscreen('.marquee');
		</script>
		<CookieBanner policyHref="/cookies" />
	</body>
</html>
