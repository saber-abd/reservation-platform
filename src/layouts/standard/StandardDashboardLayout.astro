---
// Layout des espaces authentifiés (dashboard pro + espace client) de la démo Standard.
// Distinct du layout public : pas d'en-tête ni de pied de page vitrine, mais une coque
// d'application (barre latérale sur bureau, barre du haut sur mobile).
// La navigation (îlot React) est passée par chaque page dans le slot « nav ».
import '@fontsource-variable/instrument-sans/index.css';
import '../../styles/standard.css';
import { getSiteConfig } from '@/config/site';
import StandardToaster from '@/components/standard/ui/StandardToaster';
const siteConfig = await getSiteConfig(Astro.url.pathname);

interface Props {
	title?: string;
}

const { title = 'Espace' } = Astro.props;

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';
const space = currentPath.includes('/espace-client') ? 'client' : 'pro';
const home = space === 'client' ? `${basePath}/espace-client` : `${basePath}/dashboard`;
---

<!doctype html>
<html lang="fr" class="theme-standard">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — {siteConfig.business.name}</title>
	</head>
	<body class="sa-body min-h-screen font-sans">
		<div class="sa-shell">
			<aside class="sa-side">
				<a href={home} class="sa-brand" aria-label={`${siteConfig.business.name}, ${space === 'client' ? 'espace client' : 'espace pro'}`}>
					<span class="st-logo-mark" aria-hidden="true">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="8" cy="8" r="6.2" /><path d="M8 4.6v6.8M4.6 8h6.8" /></svg>
					</span>
					<span class="min-w-0">
						<span class="sa-brand-name">{siteConfig.business.name}</span>
						<span class="sa-brand-space">{space === 'client' ? 'Espace client' : 'Espace pro'}</span>
					</span>
				</a>
				<slot name="nav" />
			</aside>
			<main class="sa-main">
				<div class="sa-content" data-space={space}>
					<slot />
				</div>
			</main>
		</div>
		<StandardToaster client:idle />
	</body>
</html>
