---
// Layout dédié aux espaces authentifiés (dashboard pro + espace client).
// Volontairement distinct du Layout public : pas de header/footer vitrine,
// juste une barre d'app minimale, pour bien différencier "site public" et "espace privé".
import '@fontsource-variable/instrument-sans/index.css';
import '../../styles/standard.css';
import { ArrowLeft } from 'lucide-react';
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig(Astro.url.pathname);

interface Props {
	title?: string;
}

const { title = 'Espace' } = Astro.props;

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';
---

<!doctype html>
<html lang="fr" class="theme-standard">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — {siteConfig.business.name}</title>
	</head>
	<body class="min-h-screen bg-paper font-sans text-ink">
		<header class="border-b border-rule bg-surface">
			<div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3">
				<a href={`${basePath}/`} aria-label={siteConfig.business.name} class="flex items-center gap-2">
					<span class="st-logo-mark" aria-hidden="true">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="8" cy="8" r="6.2" /><path d="M8 4.6v6.8M4.6 8h6.8" /></svg>
					</span>
					<span class="text-base font-bold tracking-[-0.03em] text-ink">{siteConfig.business.name}</span>
				</a>
				<div class="flex items-center gap-4">
					<a href={`${basePath}/`} class="flex items-center gap-1 text-xs font-medium text-ink-mute hover:text-brand">
						<ArrowLeft size={14} />
						Retour au site
					</a>
					<a href="/" class="flex items-center gap-1 rounded-md border border-rule px-3 py-1.5 text-xs font-semibold text-ink hover:bg-paper">
						Portfolio
					</a>
				</div>
			</div>
		</header>
		<main class="mx-auto max-w-5xl px-6 py-12">
			<slot />
		</main>
	</body>
</html>
