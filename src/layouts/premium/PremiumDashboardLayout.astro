---
import '@fontsource-variable/archivo/wdth.css';
import '../../styles/premium.css';
import { ArrowLeft, ChevronsLeft } from 'lucide-react';
import { getSiteConfig } from '@/config/site';
import PremiumToaster from '@/components/premium/ui/PremiumToaster';
const siteConfig = await getSiteConfig(Astro.url.pathname);

interface Props {
	title?: string;
}

const { title = 'Espace Pro' } = Astro.props;

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';
const isPreview = /^\/demo-[^/]+\/apercu(\/|$)/.test(currentPath);
---

<!doctype html>
<html lang="fr" class="theme-premium dashboard-premium">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — {siteConfig.business.name}</title>
		<meta name="theme-color" content="#121315" />
		<script is:inline>
			document.documentElement.classList.add('js');
			try {
				if (localStorage.getItem('premium_dash_sidebar') === 'replie') document.documentElement.dataset.peReplie = '1';
			} catch (e) {}
		</script>
	</head>
	<body class="pe-body">
		<div class="pe-shell">
			{/* Barre latérale carbone : logo, navigation (îlot), instrument date/heure, retour au site */}
			<aside id="dash-drawer" data-open="false" class="pe-side" aria-label="Navigation de l’espace">
				<div class="pe-side__logo">
					<a href={`${basePath}/`} aria-label={siteConfig.business.name} class="pe-side__marque">
						<i aria-hidden="true"></i>
						<span class="pe-side__nom">{siteConfig.business.name}</span>
					</a>
					<button id="pe-replier" type="button" class="pe-side__replier" aria-label="Réduire la barre latérale" aria-pressed="false">
						<ChevronsLeft />
					</button>
				</div>
				<div class="pe-side__nav">
					<slot name="sidebar" />
				</div>
				<div class="pe-side__bas">
					<div class="pe-horloge" aria-hidden="true">
						<span class="pe-horloge__date" data-horloge-date></span>
						<span class="pe-horloge__heure" data-horloge-heure></span>
					</div>
					<a href={`${basePath}/`} class="pe-retour" title="Retour au site">
						<ArrowLeft />
						<span>Retour au site</span>
					</a>
				</div>
			</aside>

			<main id="pe-main" class="pe-main">
				{/* En-tête mobile */}
				<header class="pe-topbar">
					<a href={`${basePath}/`} aria-label={siteConfig.business.name} class="pe-side__marque">
						<i aria-hidden="true"></i>
						<span class="pe-side__nom">{siteConfig.business.name}</span>
					</a>
					<button id="dash-menu-btn" type="button" class="pe-burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="dash-drawer">
						<span></span><span></span><span></span>
					</button>
				</header>
				{isPreview && (
					<div role="status" class="pe-apercu-bandeau">
						<p>Aperçu avec des données fictives : lecture seule, aucune modification n'est enregistrée.</p>
						<a href={`${basePath}/connexion`}>Se connecter</a>
					</div>
				)}
				<div class="pe-page">
					<slot />
				</div>
			</main>
			<div id="dash-backdrop" class="pe-fond" data-open="false" aria-hidden="true"></div>
		</div>
		<PremiumToaster client:load />
	</body>
</html>

<script>
	// Tiroir de navigation (mobile), repli de la barre latérale (bureau), petit instrument date / heure.
	const drawer = document.getElementById('dash-drawer');
	const backdrop = document.getElementById('dash-backdrop');
	const toggle = document.getElementById('dash-menu-btn');
	if (drawer && backdrop && toggle) {
		const setOpen = (open: boolean) => {
			drawer.dataset.open = String(open);
			backdrop.dataset.open = String(open);
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
		};
		toggle.addEventListener('click', () => setOpen(drawer.dataset.open !== 'true'));
		backdrop.addEventListener('click', () => setOpen(false));
		drawer.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('a')) setOpen(false);
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && drawer.dataset.open === 'true') {
				setOpen(false);
				toggle.focus();
			}
		});
	}

	const replier = document.getElementById('pe-replier');
	if (replier) {
		const root = document.documentElement;
		const sync = () => {
			const replie = root.dataset.peReplie === '1';
			replier.setAttribute('aria-pressed', String(replie));
			replier.setAttribute('aria-label', replie ? 'Déplier la barre latérale' : 'Réduire la barre latérale');
		};
		sync();
		replier.addEventListener('click', () => {
			const replie = root.dataset.peReplie !== '1';
			if (replie) root.dataset.peReplie = '1';
			else delete root.dataset.peReplie;
			try {
				localStorage.setItem('premium_dash_sidebar', replie ? 'replie' : 'ouvert');
			} catch (e) {}
			sync();
		});
	}

	const dateEl = document.querySelector<HTMLElement>('[data-horloge-date]');
	const heureEl = document.querySelector<HTMLElement>('[data-horloge-heure]');
	if (dateEl && heureEl) {
		const tick = () => {
			const d = new Date();
			dateEl.textContent = d.toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' });
			const h = String(d.getHours()).padStart(2, '0');
			const m = String(d.getMinutes()).padStart(2, '0');
			heureEl.innerHTML = `${h}<b>:</b>${m}`;
		};
		tick();
		window.setInterval(tick, 20_000);
	}
</script>
