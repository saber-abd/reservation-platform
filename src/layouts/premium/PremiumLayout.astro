---
import '../../styles/premium.css';
import 'aos/dist/aos.css';
import PremiumHeader from '@/components/premium/PremiumHeader.astro';
import PremiumFooter from '@/components/premium/PremiumFooter.astro';
import CookieBanner from '@/components/shared/CookieBanner.astro';
import SmoothScroll from '@/components/shared/SmoothScroll.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = "Garage Premium Auto",
	description = "Votre garage automobile de confiance pour l'entretien, le diagnostic et la réparation de votre véhicule.",
	noindex = false,
} = Astro.props;

const pageTitle = `${title} — Expertise Automobile`;
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);
---

<!doctype html>
<html lang="fr" class="theme-premium">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{pageTitle}</title>
		<meta name="theme-color" content="#1a1c29" />
	</head>
	<body class="flex min-h-screen flex-col bg-background text-foreground selection:bg-primary selection:text-white">
		<PremiumHeader />
		<main class="flex-1 overflow-x-hidden">
			<slot />
		</main>
		<PremiumFooter />
		<script>
			import AOS from 'aos';

			AOS.init({
				duration: 600,
				easing: 'ease-out',
				once: false,
				mirror: true,
				offset: 80,
			});
		</script>
		<SmoothScroll />
		<CookieBanner policyHref="/cookies" />
	</body>
</html>
