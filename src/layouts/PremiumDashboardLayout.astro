---
import '../styles/global.css';
import { Wrench, ArrowLeft, LogOut } from 'lucide-react';
import { getSiteConfig } from '@/config/site';
import SmoothScroll from '@/components/SmoothScroll.astro';
const siteConfig = await getSiteConfig(Astro.url.pathname);

interface Props {
	title?: string;
}

const { title = 'Espace Pro' } = Astro.props;

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';
---

<!doctype html>
<html lang="fr" class="theme-auto dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — {siteConfig.business.name}</title>
		<meta name="theme-color" content="#0c0a09" />
	</head>
	<body class="min-h-screen bg-stone-950 text-stone-300 font-sans selection:bg-primary selection:text-white">
		<header class="sticky top-0 z-50 border-b border-stone-800 bg-stone-950/80 backdrop-blur-md">
			<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
				<a href={`${basePath}/`} aria-label={siteConfig.business.name} class="flex items-center gap-3">
					<span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-white shadow-[0_0_15px_rgba(255,50,50,0.3)]">
						<Wrench size={20} />
					</span>
					<span class="text-xl font-black text-white tracking-widest uppercase font-[var(--font-heading)]">{siteConfig.business.name}</span>
				</a>
				<div class="flex items-center gap-6">
					<a href={`${basePath}/`} class="flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-stone-400 hover:text-primary transition-colors">
						<ArrowLeft size={16} />
						Retour au site
					</a>
                    <button class="flex items-center gap-2 rounded-xl bg-stone-900 border border-stone-700 px-4 py-2 text-sm font-bold text-white hover:bg-stone-800 hover:border-stone-500 transition-colors uppercase tracking-wider">
                        <LogOut size={16} />
                        Déconnexion
                    </button>
				</div>
			</div>
		</header>
		<main class="mx-auto max-w-7xl px-6 py-12">
			<slot />
		</main>
		<SmoothScroll />
	</body>
</html>
