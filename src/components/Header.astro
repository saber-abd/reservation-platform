---
import { Scissors, Menu, X } from 'lucide-react';
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig();
import HeaderAuthButton from '@/components/HeaderAuthButton';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white shadow-[0_4px_20px_-8px_rgba(28,25,23,0.15)]">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
		<a href="/" aria-label={siteConfig.business.name} class="flex items-center gap-2">
			<span class="flex h-9 w-9 items-center justify-center rounded-full bg-rose-600 text-white shadow-sm">
				<Scissors size={18} />
			</span>
			<span class="sr-only">{siteConfig.business.name}</span>
		</a>

		<!-- Desktop Nav -->
		<nav class="hidden items-center gap-8 md:flex">
			{
				siteConfig.nav.map((item) => (
					<a
						href={item.href}
						class:list={[
							'text-sm font-medium transition-colors hover:text-rose-600',
							currentPath === item.href ? 'text-rose-600' : 'text-stone-600',
						]}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-4">
			<!-- Bouton dynamique : avatar si connecté, connexion sinon -->
			<div class="hidden md:block">
				<HeaderAuthButton client:load />
			</div>

			<!-- Mobile Menu Toggle -->
			<button id="mobile-menu-btn" class="md:hidden text-stone-600 hover:text-rose-600 focus:outline-none">
				<Menu size={24} id="icon-menu" />
				<X size={24} id="icon-close" class="hidden" />
			</button>
		</div>
	</div>

	<!-- Mobile Nav -->
	<div id="mobile-nav" class="hidden border-t border-border bg-white md:hidden">
		<nav class="flex flex-col px-6 py-4 gap-4">
			{
				siteConfig.nav.map((item) => (
					<a
						href={item.href}
						class:list={[
							'text-lg font-medium transition-colors hover:text-rose-600',
							currentPath === item.href ? 'text-rose-600' : 'text-stone-600',
						]}
					>
						{item.label}
					</a>
				))
			}
			<div class="mt-4 pt-4 border-t border-border">
				<HeaderAuthButton client:load />
			</div>
		</nav>
	</div>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const nav = document.getElementById('mobile-nav');
	const iconMenu = document.getElementById('icon-menu');
	const iconClose = document.getElementById('icon-close');

	if (btn && nav && iconMenu && iconClose) {
		btn.addEventListener('click', () => {
			nav.classList.toggle('hidden');
			iconMenu.classList.toggle('hidden');
			iconClose.classList.toggle('hidden');
		});
	}
</script>
