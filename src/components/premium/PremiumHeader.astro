---
// En-tête du site Premium : transparent sur le héros, fond carbone qui descend au défilement,
// masqué quand on descend et rappelé quand on remonte. Menu plein écran sous 1100 px.
import { getSiteConfig } from '@/config/site';
import HeaderAuthButton from '@/components/premium/PremiumHeaderAuthButton';

const siteConfig = await getSiteConfig(Astro.url.pathname);
const basePath = '/demo-premium';
const courant = Astro.url.pathname.replace(/\/$/, '');
const estCourant = (href: string) => courant === `${basePath}${href}`.replace(/\/$/, '');
const liens = siteConfig.nav;
const liensBureau = liens.filter((l) => l.href !== '/reservation');
---

<header class="pa-header" data-header>
	<div class="pa-wrap pa-header__in">
		<a href={`${basePath}/`} class="pa-logo" aria-label={`${siteConfig.business.name}, accueil`}>
			<span class="pa-logo__mark" aria-hidden="true"></span>
			{siteConfig.business.name}
		</a>

		<nav class="pa-nav" aria-label="Navigation principale">
			{liensBureau.map((l) => (
				<a href={`${basePath}${l.href}`} aria-current={estCourant(l.href) ? 'page' : undefined}>{l.label}</a>
			))}
		</nav>

		<div class="pa-header__actions">
			<a href="/" class="pa-header__retour">← Toutes les démos</a>
			<div class="pa-auth theme-premium">
				<HeaderAuthButton client:idle basePath={basePath} />
			</div>
			<a href={`${basePath}/reservation`} class="pa-btn pa-header__cta" data-magnetic><span>Réserver</span></a>
		</div>

		<button type="button" class="pa-burger" data-burger aria-expanded="false" aria-controls="pa-menu">
			<span data-burger-label>Menu</span>
			<span class="pa-burger__bars" aria-hidden="true"><i></i><i></i></span>
		</button>
	</div>
</header>

<div id="pa-menu" class="pa-menu" data-open="false" aria-label="Menu" role="dialog" aria-modal="true">
	<nav class="pa-menu__liens" aria-label="Navigation mobile">
		{liens.map((l, i) => (
			<a
				href={`${basePath}${l.href}`}
				class="pa-menu__lien pa-menu__item"
				style={`--i:${i}`}
				aria-current={estCourant(l.href) ? 'page' : undefined}
			>
				<small>{String(i + 1).padStart(2, '0')}</small>{l.label}
			</a>
		))}
	</nav>
	<div class="pa-menu__bas pa-menu__item" style={`--i:${liens.length}`}>
		<p class="pa-tech">{siteConfig.business.address}</p>
		<a href={`tel:${siteConfig.business.phone.replace(/\s/g, '')}`} class="pa-h3">{siteConfig.business.phone}</a>
		<div class="pa-auth theme-premium">
			<HeaderAuthButton client:idle basePath={basePath} />
		</div>
		<a href="/" class="pa-tech">← Toutes les démos</a>
	</div>
</div>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
	const label = document.querySelector<HTMLElement>('[data-burger-label]');
	const menu = document.getElementById('pa-menu');

	if (header) {
		// Fond plein après 40 px ; masqué en descendant au-delà de 480 px, rappelé en remontant.
		let dernier = window.scrollY;
		let attente = false;
		const maj = () => {
			const y = window.scrollY;
			header.classList.toggle('is-scrolled', y > 40);
			if (Math.abs(y - dernier) > 6) {
				header.classList.toggle('is-hidden', y > dernier && y > 480);
				dernier = y;
			}
			attente = false;
		};
		maj();
		window.addEventListener(
			'scroll',
			() => {
				if (!attente) {
					attente = true;
					requestAnimationFrame(maj);
				}
			},
			{ passive: true },
		);
		// Un focus clavier dans l'en-tête le fait réapparaître.
		header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
	}

	if (header && burger && menu && label) {
		const lenis = () => (window as unknown as { lenis?: { stop(): void; start(): void } }).lenis;
		const ouvrir = (ouvert: boolean) => {
			menu.dataset.open = String(ouvert);
			burger.setAttribute('aria-expanded', String(ouvert));
			label.textContent = ouvert ? 'Fermer' : 'Menu';
			header.classList.toggle('is-open', ouvert);
			document.documentElement.style.overflow = ouvert ? 'hidden' : '';
			if (ouvert) {
				lenis()?.stop();
				menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
			} else {
				lenis()?.start();
			}
		};
		burger.addEventListener('click', () => ouvrir(menu.dataset.open !== 'true'));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && menu.dataset.open === 'true') {
				ouvrir(false);
				burger.focus();
			}
		});
		window.matchMedia('(min-width: 1100px)').addEventListener('change', (e) => {
			if (e.matches) ouvrir(false);
		});
	}
</script>
