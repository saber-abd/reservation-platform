---
// L'atelier en chiffres : quatre cadrans SVG dont l'aiguille et l'arc montent à l'entrée dans l'écran
// (Motion inView + animate ; valeurs fictives, la démo représente un commerce imaginaire).
const jauges = [
	{ valeur: 4, max: 6, unite: 'ponts', titre: 'Ponts élévateurs', texte: 'Deux réservés aux entretiens courts, pour ne pas immobiliser votre voiture une journée pour une vidange.' },
	{ valeur: 96, max: 100, unite: '%', titre: 'Rendus le jour annoncé', texte: 'Sur l’année écoulée. Si une pièce manque, vous êtes prévenu avant midi.' },
	{ valeur: 48, max: 72, unite: 'h', titre: 'Délai pour un rendez-vous', texte: 'En moyenne entre la réservation en ligne et l’entrée à l’atelier.' },
	{ valeur: 12, max: 24, unite: 'mois', titre: 'Garantie', texte: 'Pièces et main-d’œuvre, sur toutes les réparations mécaniques.' },
];

// Graduations : 11 traits répartis sur l'arc de 270° (de 135° à 405°, sens horaire).
const graduations = Array.from({ length: 11 }, (_, k) => {
	const a = ((135 + 27 * k) * Math.PI) / 180;
	const fort = k % 5 === 0;
	const r1 = fort ? 60 : 66;
	const r2 = 74;
	return {
		fort,
		x1: (100 + r1 * Math.cos(a)).toFixed(2),
		y1: (100 + r1 * Math.sin(a)).toFixed(2),
		x2: (100 + r2 * Math.cos(a)).toFixed(2),
		y2: (100 + r2 * Math.sin(a)).toFixed(2),
	};
});
---

<section class="pa-section" aria-labelledby="chiffres-titre">
	<div class="pa-wrap">
		<div class="pa-grid">
			<p class="pa-num pa-col-num"><b>01</b> L'atelier</p>
			<div class="pa-col-main">
				<h2 id="chiffres-titre" class="pa-h2" data-lines>
					<span class="pa-line"><span>Quatre ponts,</span></span>
					<span class="pa-line"><span>cinq techniciens.</span></span>
				</h2>
				<p class="pa-text mt-6" data-reveal>
					L'atelier tient sur 600 m² : une zone de réception où l'on fait le tour du véhicule avec vous,
					la mécanique au fond, une aire de lavage séparée. <strong>Les chiffres ci-dessous sont suivis chaque mois.</strong>
				</p>
			</div>
		</div>

		<div class="pa-gauges mt-12 md:mt-16">
			{jauges.map((j) => (
				<div class="pa-gauge is-armed" style={`--p:${(j.valeur / j.max).toFixed(4)}`} data-gauge data-valeur={j.valeur}>
					<div class="pa-gauge__cadran">
						<svg viewBox="0 0 200 200" role="img" aria-label={`${j.titre} : ${j.valeur} ${j.unite}`}>
							<circle class="pa-gauge__piste" cx="100" cy="100" r="82" pathLength="100" transform="rotate(135 100 100)" />
							<circle class="pa-gauge__val" cx="100" cy="100" r="82" pathLength="100" transform="rotate(135 100 100)" />
							{graduations.map((g) => (
								<line class:list={['pa-gauge__tick', g.fort && 'pa-gauge__tick--fort']} x1={g.x1} y1={g.y1} x2={g.x2} y2={g.y2} />
							))}
							<g class="pa-gauge__aiguille"><line x1="100" y1="112" x2="100" y2="40" /></g>
							<circle class="pa-gauge__axe" cx="100" cy="100" r="6" />
						</svg>
						<div class="pa-gauge__lecture" aria-hidden="true"><span data-lecture>{j.valeur}</span><small>{j.unite}</small></div>
					</div>
					<p><strong>{j.titre}</strong>{j.texte}</p>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	import { animate, inView } from 'motion';
	import { prefersReducedMotion } from '@/lib/motion/reveal';

	const jauges = document.querySelectorAll<HTMLElement>('[data-gauge]');
	if (!prefersReducedMotion()) {
		jauges.forEach((jauge, i) => {
			const cible = Number(getComputedStyle(jauge).getPropertyValue('--p')) || 0;
			const valeur = Number(jauge.dataset.valeur) || 0;
			const lecture = jauge.querySelector<HTMLElement>('[data-lecture]');
			if (lecture) lecture.textContent = '0';
			inView(
				jauge,
				() => {
					// L'aiguille dépasse légèrement puis revient se poser, comme un compte-tours.
					animate(0, 1, {
						duration: 1.8,
						delay: i * 0.12,
						ease: [0.34, 1.32, 0.64, 1],
						onUpdate: (v) => {
							jauge.style.setProperty('--t', String(cible * v));
							if (lecture) lecture.textContent = String(Math.max(0, Math.round(valeur * Math.min(v, 1))));
						},
					});
				},
				{ amount: 0.5 },
			);
		});
	}
</script>
