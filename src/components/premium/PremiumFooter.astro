---
// Pied de page : coordonnées, horaires, liens ; grand nom du garage en filigrane.
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);
const basePath = '/demo-premium';
const { business } = siteConfig;
const annee = new Date().getFullYear();
---

<footer class="pa-footer">
	<div class="pa-wrap pa-footer__cols">
		<div>
			<a href={`${basePath}/`} class="pa-logo"><span class="pa-logo__mark" aria-hidden="true"></span>{business.name}</a>
			<p class="pa-text mt-5 max-w-[38ch]">
				Garage indépendant : entretien, diagnostic, mécanique, pneumatiques et lavage. Devis écrit avant chaque intervention.
			</p>
			<a href={`${basePath}/reservation`} class="pa-link mt-6">
				Réserver un créneau
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
			</a>
		</div>

		<div>
			<p class="pa-num">Plan du site</p>
			<ul>
				{siteConfig.nav.map((l) => <li><a href={`${basePath}${l.href}`}>{l.label}</a></li>)}
			</ul>
		</div>

		<div>
			<p class="pa-num">Atelier</p>
			<ul>
				<li>{business.address}</li>
				<li><a href={`tel:${business.phone.replace(/\s/g, '')}`}>{business.phone}</a></li>
				<li><a href={`mailto:${business.email}`}>{business.email}</a></li>
			</ul>
			<table class="pa-horaires mt-6 text-sm">
				<caption class="sr-only">Horaires d'ouverture</caption>
				<tbody>
					{business.openingHours.map((h) => (
						<tr><th scope="row">{h.day}</th><td>{h.hours}</td></tr>
					))}
				</tbody>
			</table>
		</div>

		<div>
			<p class="pa-num">Informations</p>
			<ul>
				<li><a href={`${basePath}/mentions-legales`}>Mentions légales</a></li>
				<li><a href={`${basePath}/politique-de-confidentialite`}>Confidentialité</a></li>
				<li><a href={`${basePath}/conditions-utilisation`}>Conditions d'utilisation</a></li>
				<li><a href={`${basePath}/connexion`}>Espace client</a></li>
			</ul>
		</div>
	</div>

	<div class="pa-footer__marque" aria-hidden="true">
		<div class="pa-wrap"><p>{business.name}</p></div>
	</div>

	<div class="pa-wrap pa-footer__bas">
		<p class="pa-tech">© {annee} {business.name} · Démonstration, commerce fictif</p>
		<a href="/" class="pa-tech">← Retour aux démos</a>
	</div>
</footer>
