---
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig(Astro.url.pathname);

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-background">
	<div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:grid-cols-2 md:grid-cols-4">
		<div>
			<p class="text-xl font-black text-foreground uppercase tracking-widest font-[var(--font-heading)]">{siteConfig.business.name}</p>
			<p class="mt-4 text-sm text-muted-foreground font-medium leading-relaxed">L'excellence mécanique à votre service. Diagnostic, réparation et préparation haute performance.</p>
		</div>

		<div>
			<p class="text-sm font-bold text-foreground uppercase tracking-wider">Navigation</p>
			<ul class="mt-6 space-y-3 text-sm text-muted-foreground font-medium">
				<li><a href={`${basePath}/`} class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-primary"></span>Accueil</a></li>
				<li><a href={`${basePath}/services`} class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-primary"></span>Arsenal Mécanique</a></li>
				<li><a href={`${basePath}/a-propos`} class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-primary"></span>Notre Histoire</a></li>
				<li><a href={`${basePath}/contact`} class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-primary"></span>Contact</a></li>
			</ul>
		</div>

		<div>
			<p class="text-sm font-bold text-foreground uppercase tracking-wider">Contact & Horaires</p>
			<ul class="mt-6 space-y-2 text-sm text-muted-foreground font-medium">
				<li class="flex items-start gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0 text-primary"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
					{siteConfig.business.address}
				</li>
				<li class="flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
					{siteConfig.business.phone}
				</li>
				<li class="flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
					{siteConfig.business.email}
				</li>
			</ul>
		</div>

		<div>
			<p class="text-sm font-bold text-foreground uppercase tracking-wider">Informations Légales</p>
			<ul class="mt-6 space-y-3 text-sm text-muted-foreground font-medium">
				<li><a href={`${basePath}/mentions-legales`} class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-primary"></span>Mentions Légales</a></li>
				<li><a href={`${basePath}/politique-de-confidentialite`} class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-primary"></span>Confidentialité</a></li>
				<li><a href={`${basePath}/conditions-utilisation`} class="hover:text-primary transition-colors flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-primary"></span>Conditions d'Utilisation</a></li>
			</ul>
		</div>
	</div>

	<div class="border-t border-border bg-card/50">
		<div class="mx-auto max-w-6xl px-6 py-6 flex flex-col sm:flex-row items-center justify-between">
			<div class="text-xs font-bold text-muted-foreground uppercase tracking-widest">
				© {year} {siteConfig.business.name}. Tous droits réservés.
			</div>
			<div class="flex items-center gap-6 mt-4 sm:mt-0 text-muted-foreground">
				<a href="/" aria-label="Instagram" class="hover:text-primary transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
						<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
						<line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
					</svg>
				</a>
				<a href="/" aria-label="LinkedIn" class="hover:text-primary transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
						<rect width="4" height="12" x="2" y="9"/>
						<circle cx="4" cy="4" r="2"/>
					</svg>
				</a>
			</div>
		</div>
	</div>
</footer>
