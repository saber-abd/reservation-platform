---
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig();

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-stone-50">
	<div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 sm:grid-cols-2 md:grid-cols-4">
		<div>
			<p class="text-lg font-bold text-stone-900">{siteConfig.business.name}</p>
			<p class="mt-2 text-sm text-stone-500">{siteConfig.business.tagline}</p>
		</div>

		<div>
			<p class="text-sm font-semibold text-stone-900">Navigation</p>
			<ul class="mt-2 space-y-2 text-sm text-stone-500">
				<li><a href="/" class="hover:text-rose-600 transition-colors">Accueil</a></li>
				<li><a href="/services" class="hover:text-rose-600 transition-colors">Services</a></li>
				<li><a href="/a-propos" class="hover:text-rose-600 transition-colors">À propos</a></li>
				<li><a href="/contact" class="hover:text-rose-600 transition-colors">Contact</a></li>
			</ul>
		</div>

		<div>
			<p class="text-sm font-semibold text-stone-900">Contact & Horaires</p>
			<ul class="mt-2 space-y-1 text-sm text-stone-500">
				<li>{siteConfig.business.address}</li>
				<li>{siteConfig.business.phone}</li>
				<li>{siteConfig.business.email}</li>
			</ul>
			<ul class="mt-4 space-y-1 text-sm text-stone-500">
				{
					siteConfig.business.openingHours.map((slot) => (
						<li class="flex justify-between gap-4">
							<span>{slot.day}</span>
							<span>{slot.hours}</span>
						</li>
					))
				}
			</ul>
		</div>

		<div>
			<p class="text-sm font-semibold text-stone-900">Informations Légales</p>
			<ul class="mt-2 space-y-2 text-sm text-stone-500">
				<li><a href="/mentions-legales" class="hover:text-rose-600 transition-colors">Mentions Légales</a></li>
				<li><a href="/politique-de-confidentialite" class="hover:text-rose-600 transition-colors">Politique de Confidentialité</a></li>
				<li><a href="/conditions-utilisation" class="hover:text-rose-600 transition-colors">Conditions d'Utilisation</a></li>
			</ul>
		</div>
	</div>

	<div class="border-t border-border px-6 py-6 flex flex-col sm:flex-row items-center justify-between mx-auto max-w-6xl">
		<div class="text-xs text-stone-400">
			© {year} {siteConfig.business.name}. Tous droits réservés.
		</div>
		<div class="flex items-center gap-4 mt-4 sm:mt-0 text-stone-400">
			<a href="/" aria-label="Instagram" class="hover:text-rose-600 transition-colors">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
					<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
					<line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
				</svg>
			</a>
			<a href="/" aria-label="LinkedIn" class="hover:text-rose-600 transition-colors">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
					<rect width="4" height="12" x="2" y="9"/>
					<circle cx="4" cy="4" r="2"/>
				</svg>
			</a>
		</div>
	</div>
</footer>
