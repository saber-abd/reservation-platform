---
// Navigation flottante en pilule. Elle s'efface quand on descend et revient dès qu'on remonte.
// Sous 1024 px : nom du salon, bouton Réserver et menu déroulant.
import HeaderAuthButton from '@/components/diamant/DiamantHeaderAuthButton';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);
const base = '/demo-diamant';
const chemin = Astro.url.pathname.replace(/\/$/, '') || base;

const liens = [
	{ href: `${base}/`, label: 'Accueil', actif: chemin === base },
	{ href: `${base}/services`, label: 'Prestations', actif: chemin === `${base}/services` },
	{ href: `${base}/a-propos`, label: 'Le salon', actif: chemin === `${base}/a-propos` },
	{ href: `${base}/contact`, label: 'Contact', actif: chemin === `${base}/contact` },
];
---

<header class="dia-entete" id="diamant-header" data-cache="false">
	<div class="dia-entete__pilule">
		<a href={`${base}/`} class="dia-entete__marque" aria-label={`${siteConfig.business.name}, accueil`}>
			<span data-diamant-business-name>{siteConfig.business.name}</span>
		</a>

		<nav class="dia-entete__nav" aria-label="Navigation principale">
			{liens.map((l) => (
				<a href={l.href} aria-current={l.actif ? 'page' : undefined}>{l.label}</a>
			))}
		</nav>

		<div class="flex items-center gap-2">
			<div class="hidden lg:block">
				<HeaderAuthButton client:load basePath={base} />
			</div>
			<a href={`${base}/reservation`} class="dia-btn dia-btn--sm">
				Réserver
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
			</a>
			<button type="button" class="dia-burger lg:hidden" id="mobile-menu-btn" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu">
				<span></span><span></span>
			</button>
		</div>
	</div>

	<div class="dia-menu lg:hidden" id="mobile-menu" data-open="false">
		<div>
			<nav aria-label="Navigation mobile">
				{liens.map((l, i) => (
					<a href={l.href} class="dia-menu__lien dia-menu__item" style={`--i:${i}`} aria-current={l.actif ? 'page' : undefined}>
						{l.label}<span aria-hidden="true">0{i + 1}</span>
					</a>
				))}
				<a href={`${base}/reservation`} class="dia-menu__lien dia-menu__item" style="--i:4">Réserver en ligne<span aria-hidden="true">05</span></a>
				<div class="dia-menu__item mt-6" style="--i:5">
					<HeaderAuthButton client:visible basePath={base} />
				</div>
				<p class="dia-menu__item mt-6 text-sm text-[#6e6157]" style="--i:6">
					<a href="/" class="dia-lien">Retour au portfolio</a>
				</p>
			</nav>
		</div>
	</div>
</header>

<script is:inline>
	// Nom de l'établissement : modifiable depuis l'espace pro (localStorage) ou par cookie.
	function syncDiamantBusinessName() {
		try {
			var saved = localStorage.getItem('diamant_pro_profile');
			var name = null;
			if (saved) {
				var parsed = JSON.parse(saved);
				if (parsed && parsed.business_name) name = parsed.business_name;
			}
			if (!name) {
				var match = document.cookie.match(/(?:^|;\s*)diamant_business_name=([^;]+)/);
				if (match) name = decodeURIComponent(match[1]);
			}
			if (name) {
				document.querySelectorAll('[data-diamant-business-name]').forEach(function(el) {
					// Ne réécrit que si le nom diffère : un titre déjà découpé par l'animation reste intact.
					if (el.textContent !== name) el.textContent = name;
				});
			}
		} catch (e) {}
	}
	syncDiamantBusinessName();
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', syncDiamantBusinessName);
	}
	window.addEventListener('storage', function(e) {
		if (e.key === 'diamant_pro_profile') syncDiamantBusinessName();
	});
	window.addEventListener('diamant:profile-updated', syncDiamantBusinessName);
</script>

<script>
	const entete = document.getElementById('diamant-header');
	const btn = document.getElementById('mobile-menu-btn');
	const menu = document.getElementById('mobile-menu');

	function setMenuOpen(open: boolean) {
		if (!btn || !menu) return;
		menu.dataset.open = String(open);
		btn.setAttribute('aria-expanded', String(open));
		btn.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
		if (open && entete) entete.dataset.cache = 'false';
	}
	btn?.addEventListener('click', () => setMenuOpen(menu?.dataset.open !== 'true'));
	menu?.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).closest('a')) setMenuOpen(false);
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && menu?.dataset.open === 'true') {
			setMenuOpen(false);
			btn?.focus();
		}
	});

	// La pilule s'efface en descendant (au-delà de 200 px) et revient en remontant.
	if (entete) {
		let dernier = window.scrollY;
		let attente = false;
		const maj = () => {
			attente = false;
			const y = window.scrollY;
			const delta = y - dernier;
			if (Math.abs(delta) < 6) return;
			const cacher = delta > 0 && y > 200 && menu?.dataset.open !== 'true';
			entete.dataset.cache = String(cacher);
			dernier = y;
		};
		window.addEventListener('scroll', () => {
			if (!attente) {
				attente = true;
				requestAnimationFrame(maj);
			}
		}, { passive: true });
		// Un lien focalisé au clavier ne doit jamais être caché.
		entete.addEventListener('focusin', () => { entete.dataset.cache = 'false'; });
	}
</script>
