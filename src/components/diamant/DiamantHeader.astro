---
import HeaderAuthButton from '@/components/diamant/DiamantHeaderAuthButton';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/95 backdrop-blur-sm border-b border-stone-200" id="diamant-header">
	<div class="mx-auto max-w-7xl px-6">
		<div class="flex h-18 items-center justify-between py-4">
			<!-- Logo -->
			<a href="/demo-diamant/" class="flex items-center gap-3 group">
				<div class="w-9 h-9 rounded-xl bg-gradient-to-br from-deep-teal-400 to-deep-teal-600 flex items-center justify-center transition-transform group-hover:scale-105">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/>
						<line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/>
						<line x1="8.12" y1="8.12" x2="12" y2="12"/>
					</svg>
				</div>
				<span class="text-lg font-bold tracking-widest text-stone-800 uppercase" data-diamant-business-name>
					{siteConfig.business.name}
				</span>
			</a>

			<!-- Navigation Desktop -->
			<nav class="hidden md:flex items-center gap-8">
				<a href="/demo-diamant/" class="text-sm font-medium text-stone-600 hover:text-deep-teal-500 transition-colors tracking-wide uppercase">Accueil</a>
				<a href="/demo-diamant/services" class="text-sm font-medium text-stone-600 hover:text-deep-teal-500 transition-colors tracking-wide uppercase">Services</a>
				<a href="/demo-diamant/a-propos" class="text-sm font-medium text-stone-600 hover:text-deep-teal-500 transition-colors tracking-wide uppercase">La Maison</a>
				<a href="/demo-diamant/contact" class="text-sm font-medium text-stone-600 hover:text-deep-teal-500 transition-colors tracking-wide uppercase">Contact</a>
				<a href="/demo-diamant/reservation" class="text-sm font-medium text-stone-600 hover:text-deep-teal-500 transition-colors tracking-wide uppercase">Réserver</a>
			</nav>

			<!-- CTA & Auth -->
			<div class="flex items-center gap-4">
				<a
					href="/"
					class="hidden xl:inline-flex items-center justify-center px-3 py-1 rounded-full border border-stone-200 text-stone-500 font-semibold text-[11px] tracking-wider uppercase hover:text-stone-800 hover:bg-stone-50 transition-colors"
				>
					Retour Portfolio
				</a>
				<div class="hidden sm:block">
					<HeaderAuthButton client:load basePath="/demo-diamant" />
				</div>
				<a
					href="/demo-diamant/reservation"
					class="hidden md:inline-flex items-center justify-center px-5 py-2 rounded-full bg-deep-teal-500 text-white font-bold text-sm tracking-wide hover:bg-deep-teal-400 transition-colors"
				>
					Réserver
				</a>
				
				<!-- Bouton menu mobile : les trois barres se transforment en croix -->
				<button type="button" class="burger md:hidden" id="mobile-menu-btn" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu">
					<span></span><span></span><span></span>
				</button>
			</div>
		</div>
	</div>

	<!-- Mobile Menu -->
	<div class="mobile-panel md:hidden" id="mobile-menu" data-open="false">
		<div class="overflow-hidden">
			<nav class="px-6 pb-6 pt-2" aria-label="Navigation mobile">
			<a href="/demo-diamant/" class="mobile-item flex items-center justify-between border-b border-stone-100 py-3.5 text-sm font-semibold uppercase tracking-widest text-stone-700" style="--i:0">Accueil<span aria-hidden="true" class="text-stone-300">→</span></a>
			<a href="/demo-diamant/services" class="mobile-item flex items-center justify-between border-b border-stone-100 py-3.5 text-sm font-semibold uppercase tracking-widest text-stone-700" style="--i:1">Services<span aria-hidden="true" class="text-stone-300">→</span></a>
			<a href="/demo-diamant/a-propos" class="mobile-item flex items-center justify-between border-b border-stone-100 py-3.5 text-sm font-semibold uppercase tracking-widest text-stone-700" style="--i:2">La Maison<span aria-hidden="true" class="text-stone-300">→</span></a>
			<a href="/demo-diamant/contact" class="mobile-item flex items-center justify-between border-b border-stone-100 py-3.5 text-sm font-semibold uppercase tracking-widest text-stone-700" style="--i:3">Contact<span aria-hidden="true" class="text-stone-300">→</span></a>
			<a href="/demo-diamant/reservation" class="mobile-item flex items-center justify-between border-b border-stone-100 py-3.5 text-sm font-semibold uppercase tracking-widest text-stone-700" style="--i:4">Réserver<span aria-hidden="true" class="text-stone-300">→</span></a>
			<div class="mobile-item mt-5 sm:hidden" style="--i:5">
				<HeaderAuthButton client:visible basePath="/demo-diamant" />
			</div>
			<div class="mobile-item mt-4 grid grid-cols-2 gap-3" style="--i:6">
				<a href="/demo-diamant/reservation" class="rounded-full bg-stone-900 py-3 text-center text-sm font-bold text-white">Réserver</a>
				<a href="/" class="rounded-full border border-stone-200 py-3 text-center text-sm font-bold text-stone-500">Portfolio</a>
			</div>
			</nav>
		</div>
	</div>
</header>

<script is:inline>
	// Synchronisation dynamique du nom de l'établissement (Démo Diamant)
	function syncDiamantBusinessName() {
		try {
			var saved = localStorage.getItem('diamant_pro_profile');
			var name = null;
			if (saved) {
				var parsed = JSON.parse(saved);
				if (parsed && parsed.business_name) name = parsed.business_name;
			}
			if (!name) {
				var match = document.cookie.match(/(?:^|;\s*)diamant_business_name=([^;]+)/);
				if (match) name = decodeURIComponent(match[1]);
			}
			if (name) {
				document.querySelectorAll('[data-diamant-business-name]').forEach(function(el) {
					el.textContent = name;
				});
			}
		} catch (e) {}
	}
	syncDiamantBusinessName();
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', syncDiamantBusinessName);
	}
	window.addEventListener('storage', function(e) {
		if (e.key === 'diamant_pro_profile') syncDiamantBusinessName();
	});
	window.addEventListener('diamant:profile-updated', syncDiamantBusinessName);

	// Mobile menu toggle
	const btn = document.getElementById('mobile-menu-btn');
	const menu = document.getElementById('mobile-menu');
	function setMenuOpen(open) {
		if (!btn || !menu) return;
		menu.dataset.open = String(open);
		btn.setAttribute('aria-expanded', String(open));
		btn.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
	}
	btn?.addEventListener('click', () => setMenuOpen(menu?.dataset.open !== 'true'));
	menu?.addEventListener('click', (e) => { if (e.target.closest('a')) setMenuOpen(false); });
	document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenuOpen(false); });

	// Ombre légère au scroll
	const header = document.getElementById('diamant-header');
	if (header) {
		window.addEventListener('scroll', () => {
			if (window.scrollY > 10) {
				header.classList.add('shadow-sm');
			} else {
				header.classList.remove('shadow-sm');
			}
		}, { passive: true });
	}
</script>

<style>
	/* Burger -> croix */
	.burger {
		position: relative;
		width: 44px;
		height: 44px;
		border-radius: 9999px;
		color: var(--color-stone-700);
		transition: background-color 0.2s ease;
	}
	.burger:hover { background: var(--color-stone-100); }
	.burger span {
		position: absolute;
		left: 12px;
		width: 20px;
		height: 1.5px;
		border-radius: 2px;
		background: currentColor;
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease;
	}
	.burger span:nth-child(1) { top: 16px; }
	.burger span:nth-child(2) { top: 21.5px; }
	.burger span:nth-child(3) { top: 27px; }
	.burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
	.burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; transform: scaleX(0); }
	.burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

	/* Panneau qui se déplie (hauteur animée), liens en cascade */
	.mobile-panel {
		display: grid;
		grid-template-rows: 0fr;
		background: #fff;
		border-top: 1px solid transparent;
		transition: grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease;
	}
	.mobile-panel[data-open='true'] { grid-template-rows: 1fr; border-top-color: var(--color-stone-200); }
	.mobile-item {
		opacity: 0;
		transform: translateY(-6px);
		transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.mobile-panel[data-open='true'] .mobile-item {
		opacity: 1;
		transform: none;
		transition-delay: calc(70ms + var(--i, 0) * 50ms);
	}
	@media (prefers-reduced-motion: reduce) {
		.burger span, .mobile-panel, .mobile-item { transition-duration: 0.01ms !important; transition-delay: 0ms !important; }
	}
</style>
