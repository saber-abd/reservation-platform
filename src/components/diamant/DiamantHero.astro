---
// Héros de l'accueil : très grand titre serif révélé ligne par ligne au chargement (SplitText),
// photo du salon dévoilée par un masque qui remonte (clip-path), puis légère parallaxe au défilement.
// Le logo animé (Diamant3DLogo) est posé à cheval sur la photo et mène à la réservation.
import DiamantPicture from '@/components/diamant/DiamantPicture.astro';
import Diamant3DLogo from '@/components/diamant/Diamant3DLogo';
import { images } from '@/components/diamant/images';
import { getSiteConfig } from '@/config/site';

interface Props {
	nbPrestations: number;
}

const { nbPrestations } = Astro.props;
const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);
const { business } = siteConfig;
const base = '/demo-diamant';
const ville = business.address.split(',').pop()?.replace(/\d{5}/, '').trim() || business.address;
const tel = business.phone.replace(/[^\d+]/g, '');
---

<section class="dia-hero" data-hero aria-labelledby="hero-titre">
	<div class="dia-wrap">
		<div class="dia-hero__haut">
			<div>
				<p class="dia-num mb-8" data-hero-fade><b>{business.activity}</b> {ville}</p>
				<h1 id="hero-titre" class="dia-display" data-hero-titre>
					Coupe, couleur,<br />coiffage.<br /><em>Sans attente.</em>
				</h1>
			</div>
			<div class="dia-hero__infos">
				<p class="dia-lead" data-hero-fade>
					On vous reçoit à l'heure réservée. La prestation, sa durée et son prix
					s'affichent avant de valider le créneau.
				</p>
				<div class="flex flex-wrap gap-3" data-hero-fade>
					<a href={`${base}/reservation`} class="dia-btn">
						Réserver un créneau
						<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
					</a>
					<a href="#prestations" class="dia-btn dia-btn--ligne">Les tarifs</a>
				</div>
				<dl class="dia-hero__fiche" data-hero-fade>
					<div>
						<dt>Adresse</dt>
						<dd>{business.address}</dd>
					</div>
					<div>
						<dt>Téléphone</dt>
						<dd><a href={`tel:${tel}`} class="dia-chiffre">{business.phone}</a></dd>
					</div>
					{business.openingHours[0] && (
						<div>
							<dt>{business.openingHours[0].day}</dt>
							<dd class="dia-chiffre">{business.openingHours[0].hours}</dd>
						</div>
					)}
					<div>
						<dt>Prestations</dt>
						<dd>{nbPrestations} à la carte</dd>
					</div>
				</dl>
			</div>
		</div>

		<div class="dia-hero__bas">
			<div class="dia-hero__media" data-hero-media>
				<div class="dia-hero__parallaxe" data-hero-parallaxe>
					<DiamantPicture {...images.hero} sizes="(min-width: 1440px) 1340px, 94vw" prioritaire />
				</div>
			</div>
			<a href={`${base}/reservation`} class="dia-hero__badge" aria-label="Réserver un rendez-vous">
				<span class="block h-full w-full" data-hero-fade><Diamant3DLogo name={business.name} /></span>
			</a>
		</div>
	</div>
</section>

<script>
	import { gsap, MQ, SplitText } from '@/lib/motion/gsap';

	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const titre = hero?.querySelector<HTMLElement>('[data-hero-titre]');
	const media = hero?.querySelector<HTMLElement>('[data-hero-media]');
	const parallaxe = hero?.querySelector<HTMLElement>('[data-hero-parallaxe]');

	if (hero && titre && media && parallaxe) {
		const mm = gsap.matchMedia();
		mm.add(MQ.motion, () => {
			const img = parallaxe.querySelector('img');
			const fades = hero.querySelectorAll('[data-hero-fade]');

			SplitText.create(titre, {
				type: 'lines',
				mask: 'lines',
				autoSplit: true,
				onSplit: (self) => {
					titre.classList.add('is-split');
					return gsap.from(self.lines, { yPercent: 112, duration: 1.25, ease: 'power4.out', stagger: 0.11, delay: 0.1 });
				},
			});

			// Masque qui remonte, photo qui se pose (léger dézoom), textes secondaires en cascade.
			gsap.fromTo(media, { clipPath: 'inset(100% 0% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.5, ease: 'expo.inOut', delay: 0.35 });
			if (img) gsap.fromTo(img, { scale: 1.3 }, { scale: 1, duration: 2, ease: 'expo.out', delay: 0.4 });
			gsap.fromTo(fades, { autoAlpha: 0, y: 18 }, { autoAlpha: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08, delay: 0.55 });
			document.documentElement.classList.add('dia-hero-ok');

			// Parallaxe : la photo glisse plus lentement que la page.
			gsap.fromTo(parallaxe, { yPercent: -6 }, {
				yPercent: 6,
				ease: 'none',
				scrollTrigger: { trigger: media, start: 'top bottom', end: 'bottom top', scrub: true },
			});

			return () => document.documentElement.classList.remove('dia-hero-ok');
		});
	}
</script>
