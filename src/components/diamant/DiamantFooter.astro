---
// Pied de page sombre : coordonnées, horaires, liens, puis le nom du salon en très grand,
// ajusté à la largeur de la page et révélé lettre par lettre à son arrivée dans l'écran (SplitText).
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);
const { business } = siteConfig;
const annee = new Date().getFullYear();
const base = '/demo-diamant';
const tel = business.phone.replace(/[^\d+]/g, '');
---

<footer class="dia-pied dia-sombre">
	<div class="dia-wrap">
		<div class="dia-pied__colonnes">
			<div class="col-span-2 lg:col-span-1">
				<p class="dia-pied__titre">Le salon</p>
				<address class="not-italic text-[#b5a898]">
					{business.address}<br />
					<a href={`tel:${tel}`}>{business.phone}</a><br />
					<a href={`mailto:${business.email}`}>{business.email}</a>
				</address>
				<a href={`${base}/reservation`} class="dia-btn mt-7">
					Prendre rendez-vous
					<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
				</a>
			</div>

			<div>
				<p class="dia-pied__titre">Horaires</p>
				<dl class="grid gap-2 text-[#b5a898]">
					{business.openingHours.map((h) => (
						<div>
							<dt class="text-[#f1e9dd]">{h.day}</dt>
							<dd class="dia-chiffre">{h.hours}</dd>
						</div>
					))}
				</dl>
			</div>

			<nav aria-label="Pages du site">
				<p class="dia-pied__titre">Pages</p>
				<ul>
					<li><a href={`${base}/services`}>Prestations et tarifs</a></li>
					<li><a href={`${base}/a-propos`}>Le salon</a></li>
					<li><a href={`${base}/contact`}>Contact et accès</a></li>
					<li><a href={`${base}/reservation`}>Réserver en ligne</a></li>
					<li><a href="/">Retour au portfolio</a></li>
				</ul>
			</nav>

			<nav aria-label="Compte et informations">
				<p class="dia-pied__titre">Compte</p>
				<ul>
					<li><a href={`${base}/connexion`}>Se connecter</a></li>
					<li><a href={`${base}/inscription`}>Créer un compte</a></li>
					<li><a href={`${base}/espace-client`}>Espace client</a></li>
					<li><a href={`${base}/dashboard`}>Espace professionnel</a></li>
				</ul>
				<ul class="mt-6">
					<li><a href={`${base}/mentions-legales`}>Mentions légales</a></li>
					<li><a href={`${base}/politique-de-confidentialite`}>Confidentialité</a></li>
					<li><a href={`${base}/conditions-utilisation`}>Conditions d'utilisation</a></li>
				</ul>
			</nav>
		</div>

		<p class="dia-pied__nom" data-pied-nom><span data-diamant-business-name>{business.name}</span></p>

		<div class="dia-pied__bas">
			<p>&copy; {annee} <span data-diamant-business-name>{business.name}</span>. Tous droits réservés.</p>
			<p>Démo Diamant, plateforme de réservation</p>
		</div>
	</div>
</footer>

<script>
	import { gsap, MQ, SplitText } from '@/lib/motion/gsap';

	const bloc = document.querySelector<HTMLElement>('[data-pied-nom]');
	const nom = bloc?.querySelector<HTMLElement>('span');

	if (bloc && nom) {
		// Le nom occupe toute la largeur disponible, quelle que soit sa longueur.
		const ajuster = () => {
			bloc.style.fontSize = '';
			const dispo = bloc.clientWidth;
			const actuel = nom.getBoundingClientRect().width;
			if (!dispo || !actuel) return;
			const taille = parseFloat(getComputedStyle(bloc).fontSize);
			bloc.style.fontSize = `${Math.min(taille * (dispo / actuel) * 0.98, 560)}px`;
		};
		ajuster();
		document.fonts?.ready.then(ajuster);
		let attente = 0;
		window.addEventListener('resize', () => {
			cancelAnimationFrame(attente);
			attente = requestAnimationFrame(ajuster);
		});

		const mm = gsap.matchMedia();
		mm.add(MQ.motion, () => {
			SplitText.create(nom, {
				// Pas de masque : il rognerait les débords des lettres (Fraunces, approche serrée).
				type: 'chars',
				autoSplit: true,
				onSplit: (self) =>
					gsap.from(self.chars, {
						yPercent: 45,
						autoAlpha: 0,
						duration: 1.1,
						ease: 'power3.out',
						stagger: 0.05,
						scrollTrigger: { trigger: bloc, start: 'top 92%', once: true },
					}),
			});
		});
	}
</script>
