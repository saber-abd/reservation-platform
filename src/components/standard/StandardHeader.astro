---
import { Wrench, Menu, X } from 'lucide-react';
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig(Astro.url.pathname);

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';
---

<header class="sticky top-0 z-50 bg-white border-b border-frosted-blue-200 shadow-sm">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
		<a href={`${basePath}/`} aria-label={siteConfig.business.name} class="flex items-center gap-3">
			<span class="flex h-10 w-10 items-center justify-center rounded-xl bg-cerulean text-white shadow-sm">
				<Wrench size={20} />
			</span>
			<span class="text-xl font-black text-oxford-navy tracking-tight">{siteConfig.business.name}</span>
		</a>

		<!-- Desktop Nav -->
		<nav class="hidden items-center gap-8 md:flex">
			{
				siteConfig.nav.map((item) => (
					<a
						href={`${basePath}${item.href}`}
						class:list={[
							'text-sm font-bold uppercase tracking-wider transition-colors hover:text-punch-red',
							currentPath === item.href ? 'text-cerulean' : 'text-oxford-navy',
						]}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-4">
			<div class="hidden md:flex items-center gap-4">
				{basePath && (
					<a href="/" class="rounded-xl border-2 border-cerulean/20 px-4 py-2 text-sm font-bold text-cerulean hover:bg-cerulean/10 transition-colors">
						← Retour
					</a>
				)}
			</div>

			<!-- Mobile Menu Toggle -->
			<button id="mobile-menu-btn" class="md:hidden text-oxford-navy hover:text-cerulean focus:outline-none">
				<span id="icon-menu"><Menu size={24} /></span>
				<span id="icon-close" class="hidden"><X size={24} /></span>
			</button>
		</div>
	</div>

	<!-- Mobile Nav -->
	<div id="mobile-nav" class="hidden border-t border-frosted-blue-200 bg-white md:hidden">
		<nav class="flex flex-col px-6 py-4 gap-4">
			{
				siteConfig.nav.map((item) => (
					<a
						href={`${basePath}${item.href}`}
						class:list={[
							'text-lg font-bold uppercase transition-colors hover:text-punch-red',
							currentPath === item.href ? 'text-cerulean' : 'text-oxford-navy',
						]}
					>
						{item.label}
					</a>
				))
			}
			<div class="mt-4 pt-4 border-t border-frosted-blue-200">
				{basePath && (
					<a href="/" class="mb-2 block rounded-xl border-2 border-cerulean/20 px-4 py-3 text-center text-sm font-bold text-cerulean hover:bg-cerulean/10">
						← Retour au Portfolio
					</a>
				)}
			</div>
		</nav>
	</div>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const nav = document.getElementById('mobile-nav');
	const iconMenu = document.getElementById('icon-menu');
	const iconClose = document.getElementById('icon-close');

	if (btn && nav && iconMenu && iconClose) {
		btn.addEventListener('click', () => {
			nav.classList.toggle('hidden');
			iconMenu.classList.toggle('hidden');
			iconClose.classList.toggle('hidden');
		});
	}
</script>
