---
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig(Astro.url.pathname);

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';

const year = new Date().getFullYear();
const phoneHref = `tel:${siteConfig.business.phone.replace(/\s+/g, '')}`;
---

<footer class="st-footer">
	<div class="st-container grid gap-x-10 gap-y-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.4fr_0.8fr_1.2fr_1.2fr]">
		<div>
			<p class="text-2xl font-bold tracking-[-0.04em] text-ink">{siteConfig.business.name}</p>
			<p class="mt-3 max-w-[30ch] leading-relaxed">
				{siteConfig.business.activity} à domicile et en atelier. Devis annoncé avant toute réparation.
			</p>
			<a href={`${basePath}/reservation`} class="st-link st-link--on mt-6 font-semibold text-brand">
				Réserver une intervention
			</a>
		</div>

		<nav aria-label="Pied de page">
			<p class="st-footer-title">Le site</p>
			<ul class="space-y-2.5">
				<li><a href={`${basePath}/`} class="st-link">Accueil</a></li>
				<li><a href={`${basePath}/services`} class="st-link">Services</a></li>
				<li><a href={`${basePath}/a-propos`} class="st-link">À propos</a></li>
				<li><a href={`${basePath}/contact`} class="st-link">Contact</a></li>
				<li><a href={`${basePath}/connexion`} class="st-link">Espace professionnel</a></li>
			</ul>
		</nav>

		<div>
			<p class="st-footer-title">Atelier</p>
			<address class="space-y-2.5 not-italic">
				<p class="max-w-[24ch]">{siteConfig.business.address}</p>
				<p><a href={phoneHref} class="st-link st-num">{siteConfig.business.phone}</a></p>
				<p><a href={`mailto:${siteConfig.business.email}`} class="st-link break-all">{siteConfig.business.email}</a></p>
			</address>
		</div>

		<div>
			<p class="st-footer-title">Horaires</p>
			<dl class="st-num">
				{
					siteConfig.business.openingHours.map((slot) => (
						<div class="flex justify-between gap-4 border-b border-rule py-2 first:pt-0">
							<dt>{slot.day}</dt>
							<dd class="font-medium text-ink">{slot.hours}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>

	<div class="border-t border-rule">
		<div class="st-container flex flex-col gap-4 py-6 text-sm text-ink-mute md:flex-row md:items-center md:justify-between">
			<p>© {year} {siteConfig.business.name}. Tous droits réservés.</p>
			<ul class="flex flex-wrap gap-x-6 gap-y-2">
				<li><a href={`${basePath}/mentions-legales`} class="st-link">Mentions légales</a></li>
				<li><a href={`${basePath}/politique-de-confidentialite`} class="st-link">Confidentialité</a></li>
				<li><a href={`${basePath}/conditions-utilisation`} class="st-link">CGU</a></li>
				<li><a href="/" class="st-link">Instagram</a></li>
				<li><a href="/" class="st-link">LinkedIn</a></li>
			</ul>
		</div>
	</div>
</footer>
