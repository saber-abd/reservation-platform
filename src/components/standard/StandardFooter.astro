---
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig(Astro.url.pathname);

const currentPath = Astro.url.pathname;
const basePathMatch = currentPath.match(/^\/(demo-[^/]+)/);
const basePath = basePathMatch ? `/${basePathMatch[1]}` : '';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white">
	<div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 sm:grid-cols-2 md:grid-cols-4">
		<!-- Brand & Description -->
		<div class="flex flex-col gap-4">
			<div>
				<p class="text-2xl font-black text-slate-900 tracking-tight">{siteConfig.business.name}</p>
				<p class="mt-2 text-sm font-medium text-slate-500">{siteConfig.business.tagline}</p>
			</div>
			<p class="text-sm text-slate-500 leading-relaxed">
				Nous nous engageons à vous offrir le meilleur service possible, avec transparence et professionnalisme.
			</p>
		</div>

		<!-- Navigation -->
		<div>
			<p class="text-sm font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
				Navigation
			</p>
			<ul class="mt-6 space-y-3 text-sm font-medium text-slate-600">
				<li>
					<a href={`${basePath}/`} class="group flex items-center gap-2 hover:text-blue-600 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 group-hover:text-blue-600 transition-colors"><path d="m9 18 6-6-6-6"/></svg>
						Accueil
					</a>
				</li>
				<li>
					<a href={`${basePath}/services`} class="group flex items-center gap-2 hover:text-blue-600 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 group-hover:text-blue-600 transition-colors"><path d="m9 18 6-6-6-6"/></svg>
						Services
					</a>
				</li>
				<li>
					<a href={`${basePath}/a-propos`} class="group flex items-center gap-2 hover:text-blue-600 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 group-hover:text-blue-600 transition-colors"><path d="m9 18 6-6-6-6"/></svg>
						À propos
					</a>
				</li>
				<li>
					<a href={`${basePath}/contact`} class="group flex items-center gap-2 hover:text-blue-600 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 group-hover:text-blue-600 transition-colors"><path d="m9 18 6-6-6-6"/></svg>
						Contact
					</a>
				</li>
			</ul>
		</div>

		<!-- Contact & Horaires -->
		<div>
			<p class="text-sm font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
				Contact
			</p>
			<ul class="mt-6 space-y-4 text-sm font-medium text-slate-600">
				<li class="flex items-start gap-3">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 shrink-0 mt-0.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
					<span>{siteConfig.business.address}</span>
				</li>
				<li class="flex items-center gap-3">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
					<span>{siteConfig.business.phone}</span>
				</li>
				<li class="flex items-center gap-3">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
					<span>{siteConfig.business.email}</span>
				</li>
			</ul>
		</div>

		<!-- Informations Légales & Horaires -->
		<div>
			<p class="text-sm font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
				Horaires
			</p>
			<ul class="mt-6 space-y-2 text-sm text-slate-600">
				{
					siteConfig.business.openingHours.map((slot) => (
						<li class="flex justify-between items-center gap-4 py-1 border-b border-slate-100 last:border-0">
							<span class="font-medium">{slot.day}</span>
							<span class="text-slate-500">{slot.hours}</span>
						</li>
					))
				}
			</ul>

			<div class="mt-8">
				<p class="text-sm font-bold uppercase tracking-wider text-slate-900">Légal</p>
				<ul class="mt-4 space-y-2 text-sm font-medium text-slate-600">
					<li><a href={`${basePath}/mentions-legales`} class="hover:text-blue-600 transition-colors">Mentions Légales</a></li>
					<li><a href={`${basePath}/politique-de-confidentialite`} class="hover:text-blue-600 transition-colors">Confidentialité</a></li>
					<li><a href={`${basePath}/conditions-utilisation`} class="hover:text-blue-600 transition-colors">CGU</a></li>
				</ul>
			</div>
		</div>
	</div>

	<div class="border-t border-slate-100 bg-slate-50 px-6 py-6 flex flex-col sm:flex-row items-center justify-between mx-auto max-w-6xl">
		<div class="text-sm font-medium text-slate-500">
			© {year} {siteConfig.business.name}. Tous droits réservés.
		</div>
		<div class="flex items-center gap-4 mt-4 sm:mt-0 text-slate-400">
			<a href="/" aria-label="Instagram" class="hover:text-blue-600 transition-colors hover:scale-110 transform">
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
					<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
					<line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
				</svg>
			</a>
			<a href="/" aria-label="LinkedIn" class="hover:text-blue-600 transition-colors hover:scale-110 transform">
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
					<rect width="4" height="12" x="2" y="9"/>
					<circle cx="4" cy="4" r="2"/>
				</svg>
			</a>
		</div>
	</div>
</footer>
