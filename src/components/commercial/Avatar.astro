---
// Photo de profil ronde ; affiche les initiales tant qu'aucune photo n'est fournie.
interface Props {
	photo: string;
	initiales: string;
	prenom: string;
	size: number;
	class?: string;
}

const { photo, initiales, prenom, size, class: className = '' } = Astro.props;
---

{photo ? (
	<img
		src={photo}
		alt={`Photo de ${prenom}`}
		width={size}
		height={size}
		loading="lazy"
		decoding="async"
		class={`rounded-full object-cover ${className}`}
		style={`width:${size}px;height:${size}px`}
	/>
) : (
	<div
		role="img"
		aria-label={`Initiales de ${prenom}`}
		class={`flex items-center justify-center rounded-full bg-gradient-to-br from-stone-800 to-rose-600 font-bold text-white ${className}`}
		style={`width:${size}px;height:${size}px;font-size:${Math.round(size / 3)}px`}
	>
		{initiales}
	</div>
)}
