---
// Gabarit commun des pages légales de la page commerciale.
// Les informations manquantes sont signalées par <mark class="a-completer"> : à remplir avant mise en production.
import CommercialLayout from '@/layouts/commercial/CommercialLayout.astro';

interface Props {
	title: string;
	description: string;
	updated: string;
}

const { title, description, updated } = Astro.props;

const pages = [
	{ label: 'Mentions légales', href: '/mentions-legales' },
	{ label: 'CGU', href: '/cgu' },
	{ label: 'Données personnelles', href: '/confidentialite' },
	{ label: 'Cookies', href: '/cookies' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---

<CommercialLayout title={`${title} | SaberWeb.dev`} description={description}>
	<section class="border-b border-stone-200 bg-white">
		<div class="mx-auto max-w-3xl px-6 py-14 sm:py-20">
			<p class="text-sm text-stone-500">Informations légales</p>
			<h1 class="mt-2 text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">{title}</h1>
			<p class="mt-3 text-stone-600">{description}</p>
			<p class="mt-2 text-sm text-stone-400">Dernière mise à jour : {updated}</p>
			<nav class="mt-8 flex flex-wrap gap-2" aria-label="Pages légales">
				{pages.map((p) => (
					<a href={p.href} aria-current={current === p.href ? 'page' : undefined} class="rounded-full border border-stone-200 px-4 py-1.5 text-sm font-semibold text-stone-600 transition-colors hover:border-stone-900 hover:text-stone-900 aria-[current=page]:border-stone-900 aria-[current=page]:bg-stone-900 aria-[current=page]:text-white">
						{p.label}
					</a>
				))}
			</nav>
		</div>
	</section>

	<article class="legal-prose mx-auto max-w-3xl px-6 py-14">
		<slot />
	</article>
</CommercialLayout>

<style>
	.legal-prose :global(h2) {
		margin-top: 2.5rem;
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-stone-900);
	}
	.legal-prose :global(h2:first-child) {
		margin-top: 0;
	}
	.legal-prose :global(h3) {
		margin-top: 1.5rem;
		font-weight: 700;
		color: var(--color-stone-800);
	}
	.legal-prose :global(p),
	.legal-prose :global(ul) {
		margin-top: 0.75rem;
		line-height: 1.7;
		color: var(--color-stone-600);
	}
	.legal-prose :global(ul) {
		list-style: disc;
		padding-left: 1.25rem;
	}
	.legal-prose :global(li + li) {
		margin-top: 0.35rem;
	}
	.legal-prose :global(strong) {
		color: var(--color-stone-800);
	}
	.legal-prose :global(a) {
		color: var(--color-rose-700);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.legal-prose :global(table) {
		width: 100%;
		margin-top: 1rem;
		border-collapse: collapse;
		font-size: 0.875rem;
	}
	.legal-prose :global(th),
	.legal-prose :global(td) {
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--color-stone-200);
		text-align: left;
		vertical-align: top;
		color: var(--color-stone-600);
	}
	.legal-prose :global(th) {
		background: var(--color-stone-100);
		color: var(--color-stone-800);
	}
	.legal-prose :global(.table-wrap) {
		overflow-x: auto;
	}
	.legal-prose :global(mark.a-completer) {
		background: #fef3c7;
		color: #92400e;
		border-radius: 4px;
		padding: 0 4px;
		font-weight: 600;
	}
</style>
