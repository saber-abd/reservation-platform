---
// Gabarit commun des pages légales de la page commerciale.
// Les informations manquantes sont signalées par <mark class="a-completer"> : à remplir avant mise en production.
import CommercialLayout from '@/layouts/commercial/CommercialLayout.astro';

interface Props {
	title: string;
	description: string;
	updated: string;
}

const { title, description, updated } = Astro.props;

const pages = [
	{ label: 'Mentions légales', href: '/mentions-legales' },
	{ label: 'CGU', href: '/cgu' },
	{ label: 'Données personnelles', href: '/confidentialite' },
	{ label: 'Cookies', href: '/cookies' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---

<CommercialLayout title={`${title} | SaberWeb.dev`} description={description}>
	<section class="conteneur entete-page">
		<p class="repere num">Informations légales</p>
		<h1 class="titre-xl mt-4 max-w-[18ch]" data-split>{title}</h1>
		<p class="chapo mt-6 max-w-2xl">{description}</p>
		<p class="mt-2 text-sm text-stone-500">Dernière mise à jour&nbsp;: {updated}</p>
		<nav class="mt-10 flex flex-wrap gap-2 border-t border-encre pt-6" aria-label="Pages légales">
			{pages.map((p) => (
				<a href={p.href} aria-current={current === p.href ? 'page' : undefined} class="rounded-full border border-filet px-4 py-1.5 text-sm font-medium text-gris transition-colors hover:border-encre hover:text-encre aria-[current=page]:border-encre aria-[current=page]:bg-encre aria-[current=page]:text-papier">
					{p.label}
				</a>
			))}
		</nav>
	</section>

	<article class="legal-prose conteneur pb-24">
		<div class="max-w-3xl">
			<slot />
		</div>
	</article>
</CommercialLayout>

<style>
	.legal-prose :global(h2) {
		margin-top: 2.5rem;
		font-family: var(--font-heading);
		font-size: 1.45rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--color-encre);
	}
	.legal-prose :global(h2:first-child) {
		margin-top: 0;
	}
	.legal-prose :global(h3) {
		margin-top: 1.5rem;
		font-weight: 600;
		color: var(--color-encre);
	}
	.legal-prose :global(p),
	.legal-prose :global(ul) {
		margin-top: 0.75rem;
		line-height: 1.7;
		color: var(--color-gris);
	}
	.legal-prose :global(ul) {
		list-style: disc;
		padding-left: 1.25rem;
	}
	.legal-prose :global(li + li) {
		margin-top: 0.35rem;
	}
	.legal-prose :global(strong) {
		color: var(--color-stone-800);
	}
	.legal-prose :global(a) {
		color: var(--color-accent-fonce);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.legal-prose :global(table) {
		width: 100%;
		margin-top: 1rem;
		border-collapse: collapse;
		font-size: 0.875rem;
	}
	.legal-prose :global(th),
	.legal-prose :global(td) {
		padding: 0.6rem 0.75rem;
		border-bottom: 1px solid var(--color-filet);
		text-align: left;
		vertical-align: top;
		color: var(--color-stone-600);
	}
	.legal-prose :global(th) {
		color: var(--color-encre);
		border-bottom-color: var(--color-encre);
	}
	.legal-prose :global(.table-wrap) {
		overflow-x: auto;
	}
	.legal-prose :global(mark.a-completer) {
		background: #fef3c7;
		color: #92400e;
		border-radius: 4px;
		padding: 0 4px;
		font-weight: 600;
	}
</style>
