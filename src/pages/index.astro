---
// Accueil de SaberWeb.dev. Les prix, durées et contenus des formules viennent de src/data/devis.json
// (via components/commercial/offre.ts) ; les captures sont celles des démos refaites.
// Animations : GSAP (ScrollTrigger, SplitText) dans le <script> en bas de page, toutes dans
// gsap.matchMedia() ; épinglage des formules et colonne collante au-dessus de 992 px seulement.
import CommercialLayout from '@/layouts/commercial/CommercialLayout.astro';
import Avatar from '@/components/commercial/Avatar.astro';
import BrandIcon from '@/components/commercial/BrandIcon.astro';
import CadreNavigateur from '@/components/commercial/CadreNavigateur.astro';
import CadreTelephone from '@/components/commercial/CadreTelephone.astro';
import { membres } from '@/components/commercial/equipe';
import { contact } from '@/components/commercial/contact';
import { paliers, devis, descriptionService, formulesIncluant } from '@/components/commercial/offre';
import { formatEuros } from '@/lib/devis';
import { ArrowRight, ArrowUpRight, Phone } from 'lucide-react';

const [standard, premium, diamant] = paliers;
const pad = (n: number) => String(n).padStart(2, '0');

// Bandeau : ce que contiennent les formules, dans l'ordre où elles l'ajoutent.
const bandeau = diamant.contenu.map((c) => c.service.nom);

// Colonne collante : une ligne par outil, avec la capture correspondante.
type Fonction = { id: string; titre: string; texte: string; formules: string; capture: { demo?: 'premium' | 'diamant'; file: string; url: string } };
const fonctions: Fonction[] = [
	{
		id: 'reservation',
		titre: 'Réservation en ligne',
		texte: `${descriptionService('resa-agenda')} En Premium et Diamant, les créneaux suivent vos disponibilités et les doubles réservations sont bloquées.`,
		formules: 'Toutes les formules',
		capture: { file: 'standard-reservation', url: 'demo-standard/reservation' },
	},
	{ id: 'dashboard', titre: 'Tableau de bord', texte: descriptionService('dashboard'), formules: formulesIncluant('dashboard'), capture: { file: 'premium-tableau', url: 'demo-premium/dashboard' } },
	{ id: 'statistiques', titre: 'Statistiques', texte: descriptionService('statistiques'), formules: formulesIncluant('statistiques'), capture: { file: 'premium-stats', url: 'demo-premium/dashboard/statistiques' } },
	{ id: 'espace-client', titre: 'Espace client', texte: descriptionService('espace-client'), formules: formulesIncluant('espace-client'), capture: { demo: 'premium', file: 'espace-client', url: 'demo-premium/espace-client' } },
	{ id: 'messagerie', titre: 'Messagerie', texte: descriptionService('messagerie'), formules: formulesIncluant('messagerie'), capture: { demo: 'diamant', file: 'messagerie', url: 'demo-diamant/dashboard/messages' } },
	{ id: 'fidelite', titre: 'Fidélité', texte: descriptionService('fidelite'), formules: formulesIncluant('fidelite'), capture: { demo: 'diamant', file: 'fidelite-client', url: 'demo-diamant/espace-client/fidelite' } },
	{ id: 'equipe-droits', titre: 'Équipe et droits', texte: descriptionService('equipe-droits'), formules: formulesIncluant('equipe-droits'), capture: { demo: 'diamant', file: 'permissions', url: 'demo-diamant/dashboard/droits' } },
	{ id: 'moderation', titre: 'Modération des clients', texte: descriptionService('moderation'), formules: formulesIncluant('moderation'), capture: { demo: 'diamant', file: 'moderation-clients', url: 'demo-diamant/dashboard/clients' } },
];

const maintenance = devis.services.find((s) => s.id === 'maintenance');
const maintenanceMin = maintenance?.formules.standard?.mensuel?.min;

const etapes = [
	{
		titre: 'On en parle',
		texte: 'Un appel pour comprendre votre métier, vos prestations et la façon dont vous prenez les rendez-vous aujourd’hui. Vous repartez avec la formule qui vous convient et un devis détaillé, ligne par ligne.',
		meta: 'Gratuit, sans engagement',
	},
	{
		titre: 'On construit',
		texte: 'Maquette des pages principales, validée avec vous, puis développement du site et des outils de la formule. Vos textes et vos photos sont intégrés au fur et à mesure.',
		meta: `${standard.jours} de travail en Standard, ${diamant.jours} en Diamant`,
	},
	{
		titre: 'On met en ligne',
		texte: `${descriptionService('recette')} Le site tourne ensuite sur votre nom de domaine et vos propres comptes.`,
		meta: maintenanceMin !== undefined ? `Maintenance en option, dès ${formatEuros(maintenanceMin)} par mois` : 'Maintenance en option',
	},
];

const faq = [
	{
		volet: 'Avant le projet',
		questions: [
			{
				q: 'Combien de temps faut-il pour avoir mon site ?',
				r: `Le devis compte ${standard.jours} de travail pour un site Standard, ${premium.jours} pour Premium et ${diamant.jours} pour Diamant, hors options. Le calendrier dépend surtout de la date à laquelle vos textes et vos photos sont prêts ; il est fixé avec vous au moment du devis.`,
			},
			{
				q: 'Dois-je fournir les textes et les photos ?',
				r: 'Oui, par défaut : vous connaissez votre métier mieux que nous. Si vous préférez, la rédaction des textes à partir d’un entretien existe en option dans le simulateur de devis.',
			},
			{
				q: 'Quelle formule choisir ?',
				r: 'Standard si vous voulez un site et des rendez-vous qui arrivent dans votre agenda Google. Premium si vos clients doivent avoir un compte, un historique et des points de fidélité. Diamant si vous travaillez à plusieurs et devez répartir les accès. En cas de doute, le premier appel sert à ça.',
			},
		],
	},
	{
		volet: 'Après la mise en ligne',
		questions: [
			{
				q: 'Quels sont les frais une fois le site en ligne ?',
				r: `Hébergement, nom de domaine et services tiers : environ ${standard.frais} en Standard, ${premium.frais} en Premium et ${diamant.frais} en Diamant. Ils sont payés sur vos propres comptes ou refacturés à l’identique, sans marge.`,
			},
			{
				q: 'Pourrai-je modifier mes prestations et mes horaires ?',
				r: 'En Premium et Diamant, oui : le tableau de bord gère les prestations, les prix, les photos et les disponibilités. En Standard, les rendez-vous arrivent dans votre Google Agenda et les modifications du site passent par nous.',
			},
			{
				q: 'Qui s’occupe des mises à jour ?',
				r: `Nous, si vous prenez l’option maintenance : ${descriptionService('maintenance').replace(/^./, (c) => c.toLowerCase())} Elle coûte ${standard.maintenance} en Standard et jusqu’à ${diamant.maintenance} en Diamant.`,
			},
		],
	},
];
---

<CommercialLayout
	footerCta={false}
	title="SaberWeb.dev | Sites vitrines et réservation en ligne pour indépendants"
	description="Sites vitrines avec prise de rendez-vous en ligne pour les commerces et les indépendants : trois formules, de l’agenda Google à la plateforme avec espace client et gestion d’équipe."
>
	<!-- HÉROS -->
	<section id="presentation" class="hero" data-hero aria-labelledby="hero-titre">
		<div class="conteneur">
			<h1 id="hero-titre" class="hero-titre" data-hero-titre>
				Un site qui prend les rendez-vous <span class="accent">pour vous.</span>
			</h1>

			<div class="hero-grille">
				<div class="hero-texte">
					<p class="chapo" data-hero-fade>
						Nous construisons des sites vitrines avec réservation en ligne pour les coiffeurs, les garages,
						les dépanneurs et les autres indépendants. Trois formules, de l’agenda Google à la plateforme
						avec espace client et équipe. Les trois démos sont en ligne : vous pouvez les essayer.
					</p>
					<div class="hero-actions" data-hero-fade>
						<a href="#tarification" class="btn btn-dark btn-lg">
							Voir les formules <ArrowRight size={17} class="btn-arrow" />
						</a>
						<a href="/devis" class="btn btn-outline btn-lg">Simuler un devis</a>
					</div>
					<a href="#histoire" class="hero-duo" data-hero-fade>
						<span class="hero-duo-photos">
							{membres.map((m) => (
								<Avatar photo={m.photo} initiales={m.initiales} prenom={m.prenom} size={52} class="ring-[3px] ring-papier" />
							))}
						</span>
						<span>
							<span class="block font-medium text-encre">{membres.map((m) => m.prenom).join(' et ')}</span>
							<span class="block text-sm text-gris">Vos deux interlocuteurs, du premier appel à la mise en ligne.</span>
						</span>
					</a>
				</div>

				<div class="hero-visuel" data-hero-visuel>
					<a href="/galerie/premium" class="hero-cadre hero-cadre-premium" data-hero-cadre aria-label="Formule Premium : voir le détail">
						<CadreNavigateur file="premium-accueil" alt="Accueil de la démo Premium, un garage" url="saberweb.dev/demo-premium" sizes="(min-width: 992px) 34vw, 60vw" sombre />
					</a>
					<a href="/galerie/diamant" class="hero-cadre hero-cadre-diamant" data-hero-cadre aria-label="Formule Diamant : voir le détail">
						<CadreNavigateur file="diamant-accueil" alt="Accueil de la démo Diamant, un salon de coiffure" url="saberweb.dev/demo-diamant" sizes="(min-width: 992px) 46vw, 86vw" prioritaire />
					</a>
					<a href="/galerie/standard" class="hero-cadre hero-tel" data-hero-cadre aria-label="Formule Standard : voir le détail">
						<CadreTelephone file="standard-mobile" alt="La démo Standard, un dépanneur informatique, sur téléphone" sizes="(min-width: 992px) 13vw, 30vw" />
					</a>
					<ul class="hero-legendes" data-hero-fade aria-hidden="true">
						<li><b>Standard</b> dépannage informatique</li>
						<li><b>Premium</b> garage</li>
						<li><b>Diamant</b> salon de coiffure</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- BANDEAU DÉFILANT -->
	<div class="bandeau marquee" aria-label="Ce que contiennent les formules">
		<div class="marquee-track">
			{[0, 1].map((copie) => (
				<ul class="bandeau-groupe" aria-hidden={copie === 1 ? 'true' : undefined}>
					{bandeau.map((nom) => <li>{nom}</li>)}
				</ul>
			))}
		</div>
	</div>

	<!-- TROIS FORMULES : section épinglée sur bureau -->
	<section id="tarification" class="formules" data-formules aria-labelledby="formules-titre">
		<div class="conteneur formules-intro">
			<h2 id="formules-titre" class="titre-xl" data-reveal>Trois formules. Chacune reprend la précédente et y ajoute des outils.</h2>
			<p class="chapo" data-reveal data-reveal-delay="100">
				Les prix ci-dessous sont la main d’œuvre des prestations incluses, sans option. Les frais de
				fonctionnement (hébergement, nom de domaine, e-mails) sont à votre nom et sans marge.
			</p>
		</div>

		<div class="formules-scene" data-formules-scene>
			<nav class="formules-crans conteneur" aria-label="Aller à une formule">
				<span class="formules-piste" aria-hidden="true"><span class="formules-barre" data-formules-barre></span></span>
				{paliers.map((p, i) => (
					<a href={`#formule-${p.id}`} class:list={['formules-cran', { 'is-actif': i === 0 }]} data-cran={i}>
						<span class="num">{pad(i + 1)}</span> {p.nom}
					</a>
				))}
			</nav>

			<div class="formules-paliers conteneur">
				{paliers.map((p, i) => (
					<article id={`formule-${p.id}`} class:list={['palier', { 'is-actif': i === 0 }]} data-palier aria-labelledby={`palier-${p.id}`}>
						<div class="palier-ecran" data-palier-ecran>
							<CadreNavigateur file={`${p.id}-accueil`} alt={`Accueil de la démo ${p.nom}`} url={`saberweb.dev/demo-${p.id}`} sizes="(min-width: 992px) 52vw, 92vw" sombre={p.id === 'premium'} />
						</div>
						<div class="palier-texte">
							<div class="palier-tete" data-palier-tete>
								<p class="repere num">{pad(i + 1)} / {pad(paliers.length)}</p>
								<h3 id={`palier-${p.id}`} class="palier-nom">{p.nom}</h3>
								<p class="palier-accroche">{p.accroche}</p>
								<p class="palier-prix">
									<span class="palier-montant num">dès {p.prixBase}</span>
									<span class="palier-frais">puis {p.frais} de frais de fonctionnement</span>
								</p>
							</div>
							{i > 0 && <p class="palier-herite">Tout {paliers[i - 1].nom}, plus :</p>}
							<ul class="palier-liste">
								{p.contenu.map((c) => (
									<li class:list={['palier-item', c.nouveau ? 'est-nouveau' : 'est-herite']} data-service={c.service.id}>{c.service.nom}</li>
								))}
							</ul>
							<div class="palier-actions" data-palier-actions>
								<a href={p.demo} class="btn btn-dark">Voir la démo <ArrowUpRight size={16} class="btn-arrow" /></a>
								<a href={p.detail} class="btn btn-outline">Le détail de {p.nom}</a>
								<a href={p.devisHref} class="lien">Demander un devis <ArrowRight size={15} /></a>
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- FONCTIONNALITÉS : colonne collante -->
	<section id="fonctionnalites" class="fonctions" data-fonctions aria-labelledby="fonctions-titre">
		<div class="conteneur fonctions-grille">
			<div class="fonctions-visuel" aria-hidden="true">
				<div class="fonctions-collant">
					<div class="fonctions-pile">
						{fonctions.map((f, i) => (
							<div class:list={['fonctions-img', { 'is-actif': i === 0 }]} data-fonction-img>
								<CadreNavigateur demo={f.capture.demo} file={f.capture.file} alt="" url={`saberweb.dev/${f.capture.url}`} sizes="(min-width: 1312px) 640px, 48vw" />
							</div>
						))}
					</div>
					<p class="fonctions-legende"><span data-fonction-legende>{fonctions[0].titre}</span> <span class="num" data-fonction-num>01 / {pad(fonctions.length)}</span></p>
				</div>
			</div>

			<div>
				<h2 id="fonctions-titre" class="titre-xl" data-split>Ce que voient vos clients, et ce que vous gérez.</h2>
				<p class="chapo mt-6 max-w-xl" data-reveal>
					Les écrans ci-contre viennent des démos. Chaque outil indique les formules qui l’incluent ;
					le reste existe en option dans le simulateur de devis.
				</p>
				<ol class="fonctions-liste" data-fonctions-liste>
					{fonctions.map((f, i) => (
						<li class:list={['fonction', { 'is-actif': i === 0 }]} data-fonction data-titre={f.titre}>
							<span class="repere num">{pad(i + 1)}</span>
							<div>
								<h3 class="fonction-titre">{f.titre}</h3>
								<p class="fonction-texte">{f.texte}</p>
								<p class="fonction-formules">{f.formules}</p>
								<div class="fonction-capture">
									<CadreNavigateur demo={f.capture.demo} file={f.capture.file} alt={`Capture : ${f.titre}`} sizes="92vw" petit />
								</div>
							</div>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<!-- MÉTHODE : trois étapes, trait qui se dessine -->
	<section class="methode" data-methode aria-labelledby="methode-titre">
		<div class="conteneur">
			<div class="methode-tete">
				<h2 id="methode-titre" class="titre-xl" data-split>Comment se passe un projet.</h2>
				<p class="chapo" data-reveal>Trois étapes, avec les mêmes deux personnes du début à la fin.</p>
			</div>
			<div class="methode-piste">
				<svg class="methode-trait" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
					<path d="M0 30 C 150 4, 300 56, 450 30 S 750 4, 900 30 S 1110 50, 1200 30" pathLength="1" data-trait />
				</svg>
				<span class="methode-trait-v" aria-hidden="true"><span data-trait-v></span></span>
				<ol class="methode-etapes">
					{etapes.map((e, i) => (
						<li class="etape" data-etape>
							<span class="etape-point" aria-hidden="true"></span>
							<p class="repere num">{pad(i + 1)}</p>
							<h3 class="etape-titre">{e.titre}</h3>
							<p class="etape-texte">{e.texte}</p>
							<p class="etape-meta">{e.meta}</p>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<!-- QUI SOMMES-NOUS : fond sombre -->
	<section id="histoire" class="equipe sur-nuit" aria-labelledby="equipe-titre">
		<div class="conteneur">
			<div class="equipe-tete">
				<h2 id="equipe-titre" class="titre-xl" data-split>
					{membres.map((m) => m.prenom).join(' et ')}. L’un construit l’outil, l’autre vérifie qu’il sert votre activité.
				</h2>
			</div>
			<div class="equipe-grille" data-reveal-group>
				{membres.map((m, i) => (
					<article class="membre">
						<div class="membre-tete">
							<Avatar photo={m.photo} initiales={m.initiales} prenom={m.prenom} size={112} class="shrink-0" />
							<div>
								<p class="repere num">{pad(i + 1)}</p>
								<h3 class="titre-l">{m.prenom}</h3>
								<p class="text-stone-400">{m.role}</p>
							</div>
						</div>
						<p class="membre-texte">{m.accroche}</p>
						<ul class="membre-competences">
							{m.competences.slice(0, 5).map((c) => <li>{c}</li>)}
						</ul>
						<a href={m.linkedin} target="_blank" rel="noopener noreferrer" class="lien" aria-label={`Profil LinkedIn de ${m.prenom}`}>
							<BrandIcon name="linkedin" size={15} /> LinkedIn
						</a>
					</article>
				))}
			</div>
			<p class="mt-14" data-reveal>
				<a href="/notre-histoire" class="btn btn-ghost-dark btn-lg">Notre histoire <ArrowRight size={17} class="btn-arrow" /></a>
			</p>
		</div>
	</section>

	<!-- FAQ : deux volets -->
	<section class="faq" aria-labelledby="faq-titre">
		<div class="conteneur">
			<div class="faq-tete">
				<h2 id="faq-titre" class="titre-xl" data-reveal>Questions fréquentes</h2>
				<p class="chapo" data-reveal data-reveal-delay="100">Une autre question ? <a href="/contact" class="lien">Écrivez-nous</a>, ou appelez le <a href={contact.telephoneHref} class="lien num">{contact.telephone}</a>.</p>
			</div>
			<div class="faq-volets">
				{faq.map((v) => (
					<div class="faq-volet" data-reveal>
						<h3 class="faq-volet-titre">{v.volet}</h3>
						{v.questions.map((item) => (
							<details class="faq-item">
								<summary>
									{item.q}
									<span class="faq-plus" aria-hidden="true"></span>
								</summary>
								<p>{item.r}</p>
							</details>
						))}
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- APPEL FINAL -->
	<section id="contact" class="final" aria-labelledby="final-titre">
		<div class="conteneur">
			<h2 id="final-titre" class="titre-geant" data-split>Parlons de votre activité.</h2>
			<div class="final-bas">
				<p class="chapo" data-reveal>
					Un premier appel suffit en général pour savoir quelle formule vous convient.
					Vous pouvez aussi estimer le prix vous-même avec le <a href="/devis" class="lien">simulateur de devis</a>.
				</p>
				<div class="final-actions" data-reveal data-reveal-delay="100">
					<a href="/contact" class="btn btn-accent btn-lg">Nous écrire <ArrowRight size={17} class="btn-arrow" /></a>
					<a href={contact.telephoneHref} class="btn btn-outline btn-lg num"><Phone size={16} /> {contact.telephone}</a>
					<a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg"><BrandIcon name="whatsapp" size={18} /> WhatsApp</a>
				</div>
			</div>
		</div>
	</section>
</CommercialLayout>

<script>
	import { gsap, ScrollTrigger, SplitText, MQ, wireScroll } from '@/lib/motion/gsap';

	const racine = document.documentElement;
	const mm = gsap.matchMedia();

	// ---------- Héros : titre ligne par ligne, cadres qui montent, parallaxe au défilement ----------
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	mm.add(MQ.motion, () => {
		if (!hero) return;
		const titre = hero.querySelector<HTMLElement>('[data-hero-titre]')!;
		const fades = hero.querySelectorAll('[data-hero-fade]');
		const cadres = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-cadre]'));
		const visuel = hero.querySelector<HTMLElement>('[data-hero-visuel]')!;

		SplitText.create(titre, {
			type: 'lines',
			mask: 'lines',
			autoSplit: true,
			onSplit: (self) => {
				titre.classList.add('is-split');
				return gsap.from(self.lines, { yPercent: 112, duration: 1.2, ease: 'power4.out', stagger: 0.1, delay: 0.05 });
			},
		});
		gsap.fromTo(fades, { autoAlpha: 0, y: 18 }, { autoAlpha: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08, delay: 0.45 });
		gsap.fromTo(cadres, { autoAlpha: 0, y: 80 }, { autoAlpha: 1, y: 0, duration: 1.4, ease: 'expo.out', stagger: 0.12, delay: 0.3 });
		racine.classList.add('cm-hero-ok');

		// Les trois cadres glissent à des vitesses différentes (1 ScrollTrigger).
		const [cPremium, cDiamant, cTel] = cadres;
		gsap.timeline({ scrollTrigger: { trigger: visuel, start: 'top 60%', end: 'bottom top', scrub: true } })
			.to(cPremium, { yPercent: -14, ease: 'none' }, 0)
			.to(cDiamant, { yPercent: -5, ease: 'none' }, 0)
			.to(cTel, { yPercent: -22, ease: 'none' }, 0);

		// Les titres [data-split] sont révélés par le layout.
		return () => racine.classList.remove('cm-hero-ok');
	});

	// ---------- Trois formules : section épinglée (bureau) ----------
	const formules = document.querySelector<HTMLElement>('[data-formules]');
	if (formules) {
		const scene = formules.querySelector<HTMLElement>('[data-formules-scene]')!;
		const barre = formules.querySelector<HTMLElement>('[data-formules-barre]');
		const crans = Array.from(formules.querySelectorAll<HTMLAnchorElement>('[data-cran]'));
		const articles = Array.from(formules.querySelectorAll<HTMLElement>('[data-palier]'));
		const n = articles.length;

		mm.add(MQ.desktop, () => {
			formules.classList.add('is-pinned');
			const parts = articles.map((el) => ({
				el,
				tete: Array.from(el.querySelectorAll<HTMLElement>('[data-palier-tete] > *')),
				items: Array.from(el.querySelectorAll<HTMLElement>('.palier-item')),
				herites: Array.from(el.querySelectorAll<HTMLElement>('.palier-item.est-herite')),
				nouveaux: Array.from(el.querySelectorAll<HTMLElement>('.palier-item.est-nouveau')),
				actions: el.querySelector<HTMLElement>('[data-palier-actions]')!,
				ecran: el.querySelector<HTMLElement>('[data-palier-ecran]')!,
				img: el.querySelector<HTMLElement>('[data-palier-ecran] img'),
			}));

			let courant = -1;
			const marquer = (i: number) => {
				if (i === courant) return;
				courant = i;
				articles.forEach((a, j) => a.classList.toggle('is-actif', j === i));
				crans.forEach((c, j) => {
					c.classList.toggle('is-actif', j === i);
					if (j === i) c.setAttribute('aria-current', 'step');
					else c.removeAttribute('aria-current');
				});
			};

			// Masques toujours animés avec fromTo et des chaînes complètes (le navigateur abrège la valeur relue).
			const cache = 'inset(100.000% 0.000% 0.000% 0.000% round 14px)';
			const visible = 'inset(0.000% 0.000% 0.000% 0.000% round 14px)';
			parts.slice(1).forEach((p) => {
				gsap.set([...p.tete, ...p.items, p.actions], { autoAlpha: 0 });
				gsap.set(p.ecran, { clipPath: cache });
			});
			if (barre) gsap.set(barre, { scaleX: 0 });

			const tl = gsap.timeline({
				defaults: { ease: 'none' },
				scrollTrigger: {
					trigger: scene,
					pin: true,
					start: 'top top',
					end: () => `+=${n * window.innerHeight}`,
					scrub: 0.6,
					anticipatePin: 1,
					invalidateOnRefresh: true,
					snap: { snapTo: 'labelsDirectional', duration: { min: 0.25, max: 0.8 }, delay: 0.12, ease: 'power2.inOut', inertia: false },
					onUpdate: () => marquer(Math.max(0, Math.min(n - 1, Math.round(tl.time())))),
				},
			});
			tl.addLabel('p0', 0);
			if (barre) tl.fromTo(barre, { scaleX: 0 }, { scaleX: 1, duration: n - 1, immediateRender: false }, 0);

			for (let i = 1; i < n; i++) {
				const a = parts[i - 1];
				const b = parts[i];
				const garde = new Set(b.items.map((x) => x.dataset.service));
				const partants = a.items.filter((x) => !garde.has(x.dataset.service));
				tl.to([...a.tete, a.actions], { autoAlpha: 0, y: -22, duration: 0.3, stagger: 0.02 }, i - 0.8)
					.to(partants, { autoAlpha: 0, x: 12, duration: 0.2 }, i - 0.8)
					.fromTo(b.ecran, { clipPath: cache }, { clipPath: visible, duration: 0.7, ease: 'power2.inOut', immediateRender: false }, i - 0.8);
				if (b.img) tl.fromTo(b.img, { scale: 1.08 }, { scale: 1, duration: 0.8, ease: 'power2.out', immediateRender: false }, i - 0.8);
				// La liste s'allonge : les lignes reprises restent en place, les nouvelles arrivent une à une.
				tl.set(a.items, { autoAlpha: 0 }, i - 0.5)
					.set(b.herites, { autoAlpha: 1 }, i - 0.5)
					.fromTo(b.tete, { autoAlpha: 0, y: 22 }, { autoAlpha: 1, y: 0, duration: 0.35, stagger: 0.03, immediateRender: false }, i - 0.5)
					.fromTo(b.nouveaux, { autoAlpha: 0, x: -14 }, { autoAlpha: 1, x: 0, duration: 0.25, stagger: 0.035, immediateRender: false }, i - 0.45)
					.fromTo(b.actions, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.3, immediateRender: false }, i - 0.3)
					.addLabel(`p${i}`, i);
			}
			tl.to({}, { duration: 0.45 });
			marquer(0);

			// Les crans mènent directement au palier voulu.
			const allerA = (e: Event) => {
				const i = Number((e.currentTarget as HTMLElement).dataset.cran);
				const st = tl.scrollTrigger;
				if (!st) return;
				e.preventDefault();
				const y = st.start + (st.end - st.start) * (tl.labels[`p${i}`] / tl.duration());
				const lenis = (window as any).lenis;
				if (lenis?.scrollTo) lenis.scrollTo(y, { duration: 1.2 });
				else window.scrollTo({ top: y, behavior: 'smooth' });
			};
			crans.forEach((c) => c.addEventListener('click', allerA));

			return () => {
				crans.forEach((c) => c.removeEventListener('click', allerA));
				formules.classList.remove('is-pinned');
			};
		});
	}

	// ---------- Fonctionnalités : la capture collante suit la ligne au milieu de l'écran (bureau) ----------
	const fonctions = document.querySelector<HTMLElement>('[data-fonctions]');
	if (fonctions) {
		const liste = fonctions.querySelector<HTMLElement>('[data-fonctions-liste]')!;
		const lignes = Array.from(fonctions.querySelectorAll<HTMLElement>('[data-fonction]'));
		const images = Array.from(fonctions.querySelectorAll<HTMLElement>('[data-fonction-img]'));
		const legende = fonctions.querySelector<HTMLElement>('[data-fonction-legende]');
		const numero = fonctions.querySelector<HTMLElement>('[data-fonction-num]');
		const total = String(lignes.length).padStart(2, '0');

		mm.add('(min-width: 992px)', () => {
			let actif = 0;
			const activer = (i: number) => {
				if (i === actif) return;
				actif = i;
				lignes.forEach((l, j) => l.classList.toggle('is-actif', j === i));
				images.forEach((im, j) => im.classList.toggle('is-actif', j === i));
				if (legende) legende.textContent = lignes[i].dataset.titre ?? '';
				if (numero) numero.textContent = `${String(i + 1).padStart(2, '0')} / ${total}`;
			};
			fonctions.classList.add('is-js');
			const suivre = () => {
				const milieu = window.innerHeight / 2;
				let meilleure = 0;
				let ecart = Infinity;
				lignes.forEach((l, i) => {
					const r = l.getBoundingClientRect();
					const d = Math.abs(r.top + r.height / 2 - milieu);
					if (d < ecart) {
						ecart = d;
						meilleure = i;
					}
				});
				activer(meilleure);
			};
			ScrollTrigger.create({ trigger: liste, start: 'top 60%', end: 'bottom 40%', onUpdate: suivre, onToggle: suivre });
			const surLigne = (e: Event) => activer(lignes.indexOf(e.currentTarget as HTMLElement));
			lignes.forEach((l) => l.addEventListener('focusin', surLigne));
			return () => {
				lignes.forEach((l) => l.removeEventListener('focusin', surLigne));
				fonctions.classList.remove('is-js');
			};
		});
	}

	// ---------- Méthode : le trait se dessine au fil du défilement ----------
	const methode = document.querySelector<HTMLElement>('[data-methode]');
	if (methode) {
		const trait = methode.querySelector<SVGPathElement>('[data-trait]');
		const traitV = methode.querySelector<HTMLElement>('[data-trait-v]');
		const etapes = Array.from(methode.querySelectorAll<HTMLElement>('[data-etape]'));
		const piste = methode.querySelector<HTMLElement>('.methode-piste')!;
		const atteindre = (p: number) => etapes.forEach((e, i) => e.classList.toggle('is-atteint', p >= (i === 0 ? 0.02 : i / (etapes.length - 1)) - 0.04));

		mm.add(MQ.desktop.replace('992', '768'), () => {
			if (!trait) return;
			methode.classList.add('is-anime');
			gsap.fromTo(trait, { strokeDashoffset: 1 }, {
				strokeDashoffset: 0,
				ease: 'none',
				scrollTrigger: { trigger: piste, start: 'top 75%', end: 'bottom 55%', scrub: 0.5, onUpdate: (st) => atteindre(st.progress) },
			});
			return () => methode.classList.remove('is-anime');
		});
		mm.add(MQ.mobile.replace('991.98', '767.98'), () => {
			if (!traitV) return;
			methode.classList.add('is-anime');
			gsap.fromTo(traitV, { scaleY: 0 }, {
				scaleY: 1,
				ease: 'none',
				scrollTrigger: { trigger: piste, start: 'top 70%', end: 'bottom 60%', scrub: 0.5, onUpdate: (st) => atteindre(st.progress) },
			});
			return () => methode.classList.remove('is-anime');
		});
	}

	wireScroll();
</script>
