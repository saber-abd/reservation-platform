---
// Accueil de SaberWeb.dev. Les prix, durées et contenus des formules viennent de src/data/devis.json
// (via components/commercial/offre.ts) ; les captures sont celles des démos refaites.
// Animations : GSAP (ScrollTrigger, SplitText) dans le <script> en bas de page, toutes dans
// gsap.matchMedia() ; épinglage des formules et colonne collante au-dessus de 992 px seulement.
import CommercialLayout from '@/layouts/commercial/CommercialLayout.astro';
import Avatar from '@/components/commercial/Avatar.astro';
import BrandIcon from '@/components/commercial/BrandIcon.astro';
import CadreNavigateur from '@/components/commercial/CadreNavigateur.astro';
import CadreTelephone from '@/components/commercial/CadreTelephone.astro';
import { membres } from '@/components/commercial/equipe';
import { contact } from '@/components/commercial/contact';
import { paliers, devis, descriptionService, estInclus, MENTION_PAIEMENT, fr } from '@/components/commercial/offre';
import { formatEuros, type FormuleId } from '@/lib/devis';
import { ArrowRight, ArrowUpRight, Phone, Check, CalendarCheck, ShieldCheck, Gem, MessagesSquare, PenTool, Rocket } from 'lucide-react';

const [standard, premium, diamant] = paliers;
const pad = (n: number) => String(n).padStart(2, '0');
const icones = { standard: CalendarCheck, premium: ShieldCheck, diamant: Gem };

// Bandeau : ce que contiennent les formules, avec la couleur de la formule qui l'ajoute.
const bandeau = diamant.contenu.map((c) => ({
	nom: c.service.nom,
	formule: paliers.find((p) => estInclus(c.service, p.id))?.id ?? 'diamant',
}));

// Formules qui incluent un service (une pastille de couleur par formule).
const formulesDe = (ids: string[]): FormuleId[] =>
	paliers.filter((p) => ids.some((id) => {
		const s = devis.services.find((x) => x.id === id);
		return s ? estInclus(s, p.id) : false;
	})).map((p) => p.id);
const nomFormule = (id: FormuleId) => paliers.find((p) => p.id === id)!.nom;

// Colonne collante : une ligne par outil, avec la capture correspondante.
type Fonction = { id: string; titre: string; texte: string; formules: FormuleId[]; capture: { demo?: 'premium' | 'diamant'; file: string; url: string } };
const fonctions: Fonction[] = [
	{
		id: 'reservation',
		titre: 'Réservation en ligne',
		texte: `${descriptionService('resa-agenda')} En Premium et Diamant, les créneaux suivent vos disponibilités et les doubles réservations sont bloquées.`,
		formules: formulesDe(['resa-agenda', 'resa-base']),
		capture: { file: 'standard-reservation', url: 'demo-standard/reservation' },
	},
	{ id: 'dashboard', titre: 'Tableau de bord', texte: descriptionService('dashboard'), formules: formulesDe(['dashboard']), capture: { file: 'premium-tableau', url: 'demo-premium/dashboard' } },
	{ id: 'statistiques', titre: 'Statistiques', texte: descriptionService('statistiques'), formules: formulesDe(['statistiques']), capture: { file: 'premium-stats', url: 'demo-premium/dashboard/statistiques' } },
	{ id: 'espace-client', titre: 'Espace client', texte: descriptionService('espace-client'), formules: formulesDe(['espace-client']), capture: { demo: 'premium', file: 'espace-client', url: 'demo-premium/espace-client' } },
	{ id: 'messagerie', titre: 'Messagerie', texte: descriptionService('messagerie'), formules: formulesDe(['messagerie']), capture: { demo: 'diamant', file: 'messagerie', url: 'demo-diamant/dashboard/messages' } },
	{ id: 'fidelite', titre: 'Fidélité', texte: descriptionService('fidelite'), formules: formulesDe(['fidelite']), capture: { demo: 'diamant', file: 'fidelite-client', url: 'demo-diamant/espace-client/fidelite' } },
	{ id: 'equipe-droits', titre: 'Équipe et droits', texte: descriptionService('equipe-droits'), formules: formulesDe(['equipe-droits']), capture: { demo: 'diamant', file: 'permissions', url: 'demo-diamant/dashboard/droits' } },
	{ id: 'moderation', titre: 'Modération des clients', texte: descriptionService('moderation'), formules: formulesDe(['moderation']), capture: { demo: 'diamant', file: 'moderation-clients', url: 'demo-diamant/dashboard/clients' } },
];

const maintenance = devis.services.find((s) => s.id === 'maintenance');
const maintenanceMin = maintenance?.formules.standard?.mensuel?.min;

const etapes = [
	{
		icone: MessagesSquare,
		titre: 'On en parle',
		texte: 'Un appel pour comprendre votre métier, vos prestations et la façon dont vous prenez les rendez-vous aujourd’hui. Vous repartez avec la formule qui vous convient et un devis détaillé, ligne par ligne.',
		meta: 'Gratuit, sans engagement',
	},
	{
		icone: PenTool,
		titre: 'On construit',
		texte: 'Maquette des pages principales, validée avec vous, puis développement du site et des outils de la formule. Vos textes et vos photos sont intégrés au fur et à mesure.',
		meta: `${standard.jours} en Standard, ${diamant.jours} en Diamant`,
	},
	{
		icone: Rocket,
		titre: 'On met en ligne',
		texte: `${descriptionService('recette')} Le site tourne ensuite sur votre nom de domaine et vos propres comptes.`,
		meta: maintenanceMin !== undefined ? `Maintenance en option, dès ${formatEuros(maintenanceMin)} par mois` : 'Maintenance en option',
	},
];

const faq = [
	{
		volet: 'Avant le projet',
		questions: [
			{
				q: 'Combien de temps faut-il pour avoir mon site ?',
				r: `Le devis compte ${standard.jours} de travail pour un site Standard, ${premium.jours} pour Premium et ${diamant.jours} pour Diamant, hors options. Le calendrier dépend surtout de la date à laquelle vos textes et vos photos sont prêts ; il est fixé avec vous au moment du devis.`,
			},
			{
				q: 'Dois-je fournir les textes et les photos ?',
				r: 'Oui, par défaut : vous connaissez votre métier mieux que nous. Si vous préférez, la rédaction des textes à partir d’un entretien existe en option dans le simulateur de devis.',
			},
			{
				q: 'Quelle formule choisir ?',
				r: 'Standard si vous voulez un site et des rendez-vous qui arrivent dans votre agenda Google. Premium si vos clients doivent avoir un compte, un historique et des points de fidélité. Diamant si vous travaillez à plusieurs et devez répartir les accès. En cas de doute, le premier appel sert à ça.',
			},
		],
	},
	{
		volet: 'Après la mise en ligne',
		questions: [
			{
				q: 'Quels sont les frais une fois le site en ligne ?',
				r: `Hébergement, nom de domaine et services tiers : environ ${standard.frais} en Standard, ${premium.frais} en Premium et ${diamant.frais} en Diamant. Ils sont payés sur vos propres comptes ou refacturés à l’identique, sans marge.`,
			},
			{
				q: 'Pourrai-je modifier mes prestations et mes horaires ?',
				r: 'En Premium et Diamant, oui : le tableau de bord gère les prestations, les prix, les photos et les disponibilités. En Standard, les rendez-vous arrivent dans votre Google Agenda et les modifications du site passent par nous.',
			},
			{
				q: 'Qui s’occupe des mises à jour ?',
				r: `Nous, si vous prenez l’option maintenance : ${descriptionService('maintenance').replace(/^./, (c) => c.toLowerCase())} Elle coûte ${standard.maintenance} en Standard et jusqu’à ${diamant.maintenance} en Diamant.`,
			},
		],
	},
];

// Éventail du héros : Diamant au fond, Premium, puis Standard devant.
const eventail = [
	{ id: 'diamant', file: 'diamant-accueil', alt: 'Accueil de la démo Diamant, un salon de coiffure', sombre: false },
	{ id: 'premium', file: 'premium-accueil', alt: 'Accueil de la démo Premium, un garage', sombre: true },
	{ id: 'standard', file: 'standard-accueil', alt: 'Accueil de la démo Standard, un dépanneur informatique', sombre: false },
];
const metiers: Record<FormuleId, string> = { standard: 'dépannage informatique', premium: 'garage', diamant: 'salon de coiffure' };
---

<CommercialLayout
	footerCta={false}
	title="SaberWeb.dev | Sites vitrines et réservation en ligne pour indépendants"
	description="Sites vitrines avec prise de rendez-vous en ligne pour les commerces et les indépendants : trois formules, de l’agenda Google à la plateforme avec espace client et gestion d’équipe."
>
	<!-- HÉROS -->
	<section id="presentation" class="hero" data-hero aria-labelledby="hero-titre">
		<div class="conteneur hero-grille">
			<div class="hero-texte">
				<h1 id="hero-titre" class="hero-titre" data-hero-titre>
					Un site qui prend les rendez-vous <span class="hero-souligne">pour vous.<svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M2 9 C 50 2, 120 2, 198 7" /></svg></span>
				</h1>
				<p class="chapo" data-hero-fade>
					Nous construisons des sites vitrines avec réservation en ligne pour les coiffeurs, les garages,
					les dépanneurs et les autres indépendants. Trois formules, de l’agenda Google à la plateforme
					avec espace client et équipe. Les trois démos sont en ligne : vous pouvez les essayer.
				</p>
				<div class="hero-actions" data-hero-fade>
					<a href="#tarification" class="btn btn-rose btn-lg">
						Voir les formules <ArrowRight size={17} class="btn-arrow" />
					</a>
					<a href="/devis" class="btn btn-outline btn-lg">Simuler un devis</a>
				</div>
				<a href="#histoire" class="hero-duo" data-hero-fade>
					<span class="hero-duo-photos">
						{membres.map((m) => (
							<Avatar photo={m.photo} initiales={m.initiales} prenom={m.prenom} size={48} class="ring-[3px] ring-white" />
						))}
					</span>
					<span>
						<span class="block font-semibold text-stone-900">{membres.map((m) => m.prenom).join(' et ')}</span>
						<span class="block text-sm text-stone-500">Vos deux interlocuteurs, du premier appel à la mise en ligne.</span>
					</span>
				</a>
			</div>

			<div class="hero-visuel" data-hero-visuel>
				<div class="hero-panneau" data-hero-panneau>
					<div class="hero-eventail" data-hero-eventail>
						{eventail.map((v, i) => (
							<a href={`/galerie/${v.id}`} class={`hero-cadre hero-cadre-${i + 1}`} data-hero-cadre aria-label={`Formule ${nomFormule(v.id as FormuleId)} : voir le détail`}>
								<CadreNavigateur file={v.file} alt={v.alt} url={`saberweb.dev/demo-${v.id}`} sizes="(min-width: 992px) 34vw, 70vw" sombre={v.sombre} prioritaire={i === 0} />
							</a>
						))}
						<a href="/galerie/standard" class="hero-tel" data-hero-cadre aria-label="Formule Standard sur téléphone : voir le détail">
							<CadreTelephone file="standard-mobile" alt="La démo Standard sur téléphone" sizes="(min-width: 992px) 9vw, 18vw" />
						</a>
					</div>
				</div>
				<ul class="hero-legendes" data-hero-fade aria-label="Les trois démos">
					{paliers.map((p) => (
						<li class={`f-${p.id}`}><span class="pastille"></span><b>{p.nom}</b> {metiers[p.id]}</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<!-- BANDEAU DÉFILANT -->
	<div class="bandeau marquee" aria-label="Ce que contiennent les formules">
		<div class="marquee-track">
			{[0, 1].map((copie) => (
				<ul class="bandeau-groupe" aria-hidden={copie === 1 ? 'true' : undefined}>
					{bandeau.map((b) => <li class={`f-${b.formule}`}><span class="pastille"></span>{b.nom}</li>)}
				</ul>
			))}
		</div>
	</div>

	<!-- TROIS FORMULES : section épinglée sur bureau -->
	<section id="tarification" class="formules" data-formules data-actif="standard" aria-labelledby="formules-titre">
		<div class="conteneur section-tete formules-intro">
			<h2 id="formules-titre" class="titre-xl" data-reveal>Trois formules. Chacune reprend la précédente et y ajoute des outils.</h2>
			<p class="chapo" data-reveal data-reveal-delay="100">
				Les prix ci-dessous sont la main d’œuvre des prestations incluses, sans option. Les frais de
				fonctionnement (hébergement, nom de domaine, e-mails) sont à votre nom et sans marge.
			</p>
		</div>

		<div class="formules-scene" data-formules-scene>
			<nav class="formules-crans conteneur" aria-label="Aller à une formule">
				<span class="formules-onglets">
					{paliers.map((p, i) => (
						<a href={`#formule-${p.id}`} class:list={['formules-cran', `f-${p.id}`, { 'is-actif': i === 0 }]} data-cran={i}>
							<span class="num">{pad(i + 1)}</span> {p.nom}
						</a>
					))}
				</span>
				<span class="formules-piste" aria-hidden="true"><span class="formules-barre" data-formules-barre></span></span>
			</nav>

			<div class="conteneur min-h-0">
				<div class="formules-paliers" data-formules-paliers>
					{paliers.map((p, i) => {
						const Icone = icones[p.id];
						return (
							<article id={`formule-${p.id}`} class:list={['palier', `f-${p.id}`, { 'is-actif': i === 0 }]} data-palier aria-labelledby={`palier-${p.id}`}>
								<div class="palier-ecran" data-palier-ecran>
									<CadreNavigateur file={`${p.id}-accueil`} alt={`Accueil de la démo ${p.nom}`} url={`saberweb.dev/demo-${p.id}`} sizes="(min-width: 992px) 46vw, 88vw" sombre={p.id === 'premium'} />
								</div>
								<div class="palier-texte">
									<div class="palier-tete" data-palier-tete>
										<div class="palier-haut">
											<span class="palier-icone" aria-hidden="true"><Icone size={22} /></span>
											<span class="palier-etape num">{pad(i + 1)} / {pad(paliers.length)}</span>
										</div>
										<h3 id={`palier-${p.id}`} class="palier-nom">Formule <span>{p.nom}</span></h3>
										<p class="palier-accroche">{p.accroche}</p>
										<p class="palier-prix">
											<span class="palier-montant num">dès {p.prixBase}</span>
											<span class="palier-frais">puis {p.frais} de frais</span>
										</p>
										<p class="palier-paiement">{fr(MENTION_PAIEMENT)}</p>
									</div>
									{i > 0 && <p class="palier-herite">Tout {paliers[i - 1].nom}, plus :</p>}
									<ul class="palier-liste">
										{p.contenu.map((c) => (
											<li class:list={['palier-item', c.nouveau ? 'est-nouveau' : 'est-herite']} data-service={c.service.id}>
												<span class="palier-coche" aria-hidden="true"><Check size={12} strokeWidth={3} /></span>
												{c.service.nom}
											</li>
										))}
									</ul>
									<div class="palier-actions" data-palier-actions>
										<a href={p.demo} class="btn btn-f">Voir la démo <ArrowUpRight size={16} class="btn-arrow" /></a>
										<a href={p.detail} class="btn btn-f-outline">Le détail de {p.nom}</a>
										<a href={p.devisHref} class="lien">Simuler un devis <ArrowRight size={15} /></a>
									</div>
								</div>
							</article>
						);
					})}
				</div>
			</div>
		</div>
	</section>

	<!-- FONCTIONNALITÉS : colonne collante -->
	<section id="fonctionnalites" class="fonctions section" data-fonctions aria-labelledby="fonctions-titre">
		<div class="conteneur fonctions-grille">
			<div class="fonctions-visuel" aria-hidden="true">
				<div class="fonctions-collant">
					<div class="fonctions-pile">
						{fonctions.map((f, i) => (
							<div class:list={['fonctions-img', { 'is-actif': i === 0 }]} data-fonction-img>
								<CadreNavigateur demo={f.capture.demo} file={f.capture.file} alt="" url={`saberweb.dev/${f.capture.url}`} sizes="(min-width: 1216px) 540px, 44vw" />
							</div>
						))}
					</div>
					<p class="fonctions-legende"><span data-fonction-legende>{fonctions[0].titre}</span> <span class="num text-stone-400" data-fonction-num>01 / {pad(fonctions.length)}</span></p>
				</div>
			</div>

			<div>
				<h2 id="fonctions-titre" class="titre-xl" data-split>Ce que voient vos clients, et ce que vous gérez.</h2>
				<p class="chapo mt-6 max-w-xl" data-reveal>
					Les écrans ci-contre viennent des démos. Chaque outil indique les formules qui l’incluent ;
					le reste existe en option dans le simulateur de devis.
				</p>
				<ol class="fonctions-liste" data-fonctions-liste>
					{fonctions.map((f, i) => (
						<li class:list={['fonction', { 'is-actif': i === 0 }]} data-fonction data-titre={f.titre}>
							<span class="repere num">{pad(i + 1)}</span>
							<div>
								<h3 class="fonction-titre">{f.titre}</h3>
								<p class="fonction-texte">{f.texte}</p>
								<ul class="fonction-formules" aria-label="Formules qui l’incluent">
									{f.formules.map((id) => <li class={`f-${id}`}><span class="pastille"></span>{nomFormule(id)}</li>)}
								</ul>
								<div class="fonction-capture">
									<CadreNavigateur demo={f.capture.demo} file={f.capture.file} alt={`Capture : ${f.titre}`} sizes="92vw" petit />
								</div>
							</div>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<!-- MÉTHODE : trois étapes, trait qui se dessine -->
	<section class="methode section" data-methode aria-labelledby="methode-titre">
		<div class="conteneur">
			<div class="section-tete">
				<h2 id="methode-titre" class="titre-xl" data-split>Comment se passe un projet.</h2>
				<p class="chapo" data-reveal>Trois étapes, avec les mêmes deux personnes du début à la fin.</p>
			</div>
			<div class="methode-piste" data-methode-piste>
				<div class="methode-trait" aria-hidden="true">
					<svg viewBox="0 0 1000 64" preserveAspectRatio="none"><path class="trait-fond" d="M0 32 C 160 6, 340 58, 500 32 S 840 6, 1000 32" /></svg>
					<div class="methode-trait-plein" data-trait>
						<svg viewBox="0 0 1000 64" preserveAspectRatio="none"><path class="trait-plein" d="M0 32 C 160 6, 340 58, 500 32 S 840 6, 1000 32" /></svg>
					</div>
				</div>
				<span class="methode-trait-v" aria-hidden="true"><span data-trait-v></span></span>
				<ol class="methode-etapes">
					{etapes.map((e, i) => (
						<li class="etape" data-etape>
							<span class="etape-icone" aria-hidden="true">
								<e.icone size={26} />
								<span class="etape-numero">{i + 1}</span>
							</span>
							<div class="etape-carte">
								<h3 class="etape-titre">{e.titre}</h3>
								<p class="etape-texte">{e.texte}</p>
								<p class="etape-meta">{e.meta}</p>
							</div>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<!-- QUI SOMMES-NOUS : fond sombre -->
	<section id="histoire" class="section sur-nuit" aria-labelledby="equipe-titre">
		<div class="conteneur">
			<div class="section-tete">
				<h2 id="equipe-titre" class="titre-xl" data-split>
					{membres.map((m) => m.prenom).join(' et ')}. L’un construit l’outil, l’autre vérifie qu’il sert votre activité.
				</h2>
				<p class="chapo" data-reveal>Un profil technique et un profil business : vous parlez directement aux personnes qui font le site.</p>
			</div>
			<div class="equipe-grille" data-reveal-group>
				{membres.map((m) => (
					<article class="membre">
						<div class="membre-tete">
							<Avatar photo={m.photo} initiales={m.initiales} prenom={m.prenom} size={88} class="shrink-0 ring-4 ring-white/10" />
							<div>
								<h3 class="titre-l">{m.prenom}</h3>
								<p class="membre-role">{m.role}</p>
							</div>
						</div>
						<p class="membre-texte">{m.accroche}</p>
						<ul class="membre-competences">
							{m.competences.slice(0, 5).map((c) => <li>{c}</li>)}
						</ul>
						<a href={m.linkedin} target="_blank" rel="noopener noreferrer" class="lien" aria-label={`Profil LinkedIn de ${m.prenom}`}>
							<BrandIcon name="linkedin" size={15} /> LinkedIn
						</a>
					</article>
				))}
			</div>
			<p class="mt-12" data-reveal>
				<a href="/notre-histoire" class="btn btn-light btn-lg">Notre histoire <ArrowRight size={17} class="btn-arrow" /></a>
			</p>
		</div>
	</section>

	<!-- FAQ : deux volets -->
	<section class="section" aria-labelledby="faq-titre">
		<div class="conteneur">
			<div class="section-tete">
				<h2 id="faq-titre" class="titre-xl" data-reveal>Questions fréquentes</h2>
				<p class="chapo" data-reveal data-reveal-delay="100">Une autre question ? <a href="/contact" class="lien">Écrivez-nous</a>, ou appelez le <a href={contact.telephoneHref} class="lien num">{contact.telephone}</a>.</p>
			</div>
			<div class="faq-volets">
				{faq.map((v) => (
					<div class="faq-volet" data-reveal>
						<h3 class="faq-volet-titre">{v.volet}</h3>
						{v.questions.map((item) => (
							<details class="faq-item">
								<summary>
									{item.q}
									<span class="faq-plus" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg></span>
								</summary>
								<p>{item.r}</p>
							</details>
						))}
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- APPEL FINAL -->
	<section id="contact" class="conteneur pb-24" aria-labelledby="final-titre">
		<div class="final-carte sur-nuit" data-reveal>
			<span class="trois-teintes" aria-hidden="true"><i></i><i></i><i></i></span>
			<h2 id="final-titre" class="titre-geant mt-8" data-split>Parlons de votre activité.</h2>
			<div class="final-bas">
				<p class="chapo">
					Un premier appel suffit en général pour savoir quelle formule vous convient.
					Vous pouvez aussi estimer le prix vous-même avec le <a href="/devis" class="lien">simulateur de devis</a>.
				</p>
				<div class="final-actions">
					<a href="/contact" class="btn btn-light btn-lg">Nous écrire <ArrowRight size={17} class="btn-arrow" /></a>
					<a href={contact.telephoneHref} class="btn btn-ghost-dark btn-lg num"><Phone size={16} /> {contact.telephone}</a>
					<a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg"><BrandIcon name="whatsapp" size={18} /> WhatsApp</a>
				</div>
			</div>
		</div>
	</section>
</CommercialLayout>

<style>
	/* Trait de la méthode : dessiné au défilement si le mouvement est autorisé (sinon entier). */
	@media (prefers-reduced-motion: no-preference) {
		:global(html.js) [data-trait],
		:global(html.js) [data-trait-v] { --p: 0; }
	}
</style>

<script>
	import { gsap, ScrollTrigger, SplitText, MQ, wireScroll } from '@/lib/motion/gsap';

	const racine = document.documentElement;
	const mm = gsap.matchMedia();

	// ---------- Héros : titre ligne par ligne, captures qui arrivent en éventail ----------
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	mm.add(MQ.motion, () => {
		if (!hero) return;
		const titre = hero.querySelector<HTMLElement>('[data-hero-titre]')!;
		const fades = hero.querySelectorAll('[data-hero-fade]');
		const cadres = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-cadre]'));
		const visuel = hero.querySelector<HTMLElement>('[data-hero-visuel]')!;
		const souligne = hero.querySelector<SVGPathElement>('.hero-souligne path');

		SplitText.create(titre, {
			type: 'lines',
			mask: 'lines',
			autoSplit: true,
			onSplit: (self) => {
				titre.classList.add('is-split');
				return gsap.from(self.lines, { yPercent: 112, duration: 1.1, ease: 'power4.out', stagger: 0.09, delay: 0.05 });
			},
		});
		if (souligne) {
			// Trait sous « pour vous. » : longueur réelle mesurée, pas d'arrondi au pixel.
			const l = souligne.getTotalLength();
			gsap.fromTo(souligne, { strokeDasharray: l, strokeDashoffset: l }, { strokeDashoffset: 0, duration: 0.9, ease: 'power2.inOut', delay: 0.8, autoRound: false });
		}
		gsap.fromTo(fades, { autoAlpha: 0, y: 18 }, { autoAlpha: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08, delay: 0.4 });
		gsap.fromTo(cadres, { autoAlpha: 0, y: 60 }, { autoAlpha: 1, y: 0, duration: 1.2, ease: 'expo.out', stagger: 0.12, delay: 0.25 });
		racine.classList.add('cm-hero-ok');

		// Au défilement, l'éventail se resserre légèrement (1 ScrollTrigger).
		const [c1, c2, c3, tel] = cadres;
		gsap.timeline({ scrollTrigger: { trigger: visuel, start: 'top 30%', end: 'bottom top', scrub: true } })
			.to(c1, { yPercent: -6, ease: 'none' }, 0)
			.to(c3, { yPercent: 6, ease: 'none' }, 0)
			.to(tel, { yPercent: -18, ease: 'none' }, 0)
			.to(c2, { yPercent: 0, ease: 'none' }, 0);

		return () => racine.classList.remove('cm-hero-ok');
	});

	// Inclinaison de l'éventail au pointeur (souris uniquement). On écoute le panneau fixe,
	// jamais l'élément incliné, sinon la zone de survol bouge sous la souris.
	mm.add(`${MQ.motion} and (hover: hover) and (pointer: fine)`, () => {
		const panneau = document.querySelector<HTMLElement>('[data-hero-panneau]');
		const eventail = document.querySelector<HTMLElement>('[data-hero-eventail]');
		if (!panneau || !eventail) return;
		let frame = 0;
		let px = 0;
		let py = 0;
		const bouge = (e: PointerEvent) => {
			px = e.clientX;
			py = e.clientY;
			if (frame) return;
			frame = requestAnimationFrame(() => {
				frame = 0;
				const r = panneau.getBoundingClientRect();
				const x = Math.max(-0.5, Math.min(0.5, (px - r.left) / r.width - 0.5));
				const y = Math.max(-0.5, Math.min(0.5, (py - r.top) / r.height - 0.5));
				eventail.style.setProperty('--ry', `${(x * 8).toFixed(2)}deg`);
				eventail.style.setProperty('--rx', `${(-y * 6).toFixed(2)}deg`);
			});
		};
		const sort = () => {
			eventail.style.setProperty('--ry', '0deg');
			eventail.style.setProperty('--rx', '0deg');
		};
		panneau.addEventListener('pointermove', bouge, { passive: true });
		panneau.addEventListener('pointerleave', sort);
		return () => {
			panneau.removeEventListener('pointermove', bouge);
			panneau.removeEventListener('pointerleave', sort);
			if (frame) cancelAnimationFrame(frame);
			sort();
		};
	});

	// ---------- Trois formules : section épinglée (bureau) ----------
	const formules = document.querySelector<HTMLElement>('[data-formules]');
	if (formules) {
		const scene = formules.querySelector<HTMLElement>('[data-formules-scene]')!;
		const barre = formules.querySelector<HTMLElement>('[data-formules-barre]');
		const crans = Array.from(formules.querySelectorAll<HTMLAnchorElement>('[data-cran]'));
		const articles = Array.from(formules.querySelectorAll<HTMLElement>('[data-palier]'));
		const ids = articles.map((a) => a.id.replace('formule-', ''));
		const n = articles.length;

		mm.add(MQ.desktop, () => {
			formules.classList.add('is-pinned');
			const parts = articles.map((el) => ({
				el,
				tete: Array.from(el.querySelectorAll<HTMLElement>('[data-palier-tete] > *')),
				items: Array.from(el.querySelectorAll<HTMLElement>('.palier-item')),
				herites: Array.from(el.querySelectorAll<HTMLElement>('.palier-item.est-herite')),
				nouveaux: Array.from(el.querySelectorAll<HTMLElement>('.palier-item.est-nouveau')),
				actions: el.querySelector<HTMLElement>('[data-palier-actions]')!,
				ecran: el.querySelector<HTMLElement>('[data-palier-ecran]')!,
				img: el.querySelector<HTMLElement>('[data-palier-ecran] img'),
			}));

			let courant = -1;
			const marquer = (i: number) => {
				if (i === courant) return;
				courant = i;
				formules.dataset.actif = ids[i];
				articles.forEach((a, j) => a.classList.toggle('is-actif', j === i));
				crans.forEach((c, j) => {
					c.classList.toggle('is-actif', j === i);
					if (j === i) c.setAttribute('aria-current', 'step');
					else c.removeAttribute('aria-current');
				});
			};

			// Masques toujours animés avec fromTo et des chaînes complètes (le navigateur abrège la valeur relue).
			const cache = 'inset(100.000% 0.000% 0.000% 0.000% round 20px)';
			const visible = 'inset(0.000% 0.000% 0.000% 0.000% round 20px)';
			parts.slice(1).forEach((p) => {
				gsap.set([...p.tete, ...p.items, p.actions], { autoAlpha: 0 });
				gsap.set(p.ecran, { clipPath: cache });
			});
			if (barre) gsap.set(barre, { scaleX: 1 / n });

			// Pendant un défilement lancé par un cran, l'aimantation est suspendue (sinon elle
			// ramène la page vers le palier quitté).
			let programme = false;
			let positions: number[] = [];

			const tl = gsap.timeline({
				defaults: { ease: 'none' },
				scrollTrigger: {
					trigger: scene,
					pin: true,
					start: 'top top',
					end: () => `+=${n * window.innerHeight}`,
					scrub: 0.6,
					anticipatePin: 1,
					invalidateOnRefresh: true,
					snap: {
						snapTo: (valeur: number) => {
							if (programme || !positions.length) return valeur;
							// Palier suivant dans le sens du défilement (comme « labelsDirectional »).
							const sens = tl.scrollTrigger?.direction ?? 1;
							const candidats = positions.filter((p) => (sens > 0 ? p >= valeur - 0.002 : p <= valeur + 0.002));
							const liste = candidats.length ? candidats : positions;
							return liste.reduce((a, b) => (Math.abs(b - valeur) < Math.abs(a - valeur) ? b : a));
						},
						duration: { min: 0.25, max: 0.8 },
						delay: 0.12,
						ease: 'power2.inOut',
						inertia: false,
					},
					onUpdate: () => marquer(Math.max(0, Math.min(n - 1, Math.round(tl.time())))),
				},
			});
			tl.addLabel('p0', 0);
			if (barre) tl.fromTo(barre, { scaleX: 1 / n }, { scaleX: 1, duration: n - 1, immediateRender: false }, 0);

			for (let i = 1; i < n; i++) {
				const a = parts[i - 1];
				const b = parts[i];
				const garde = new Set(b.items.map((x) => x.dataset.service));
				const partants = a.items.filter((x) => !garde.has(x.dataset.service));
				tl.to([...a.tete, a.actions], { autoAlpha: 0, y: -18, duration: 0.3, stagger: 0.02 }, i - 0.8)
					.to(partants, { autoAlpha: 0, x: 12, duration: 0.2 }, i - 0.8)
					.fromTo(b.ecran, { clipPath: cache }, { clipPath: visible, duration: 0.7, ease: 'power2.inOut', immediateRender: false }, i - 0.8);
				if (b.img) tl.fromTo(b.img, { scale: 1.08 }, { scale: 1, duration: 0.8, ease: 'power2.out', immediateRender: false }, i - 0.8);
				// La liste s'allonge : les lignes reprises restent en place, les nouvelles arrivent une à une.
				tl.set(a.items, { autoAlpha: 0 }, i - 0.5)
					.set(b.herites, { autoAlpha: 1 }, i - 0.5)
					.fromTo(b.tete, { autoAlpha: 0, y: 18 }, { autoAlpha: 1, y: 0, duration: 0.35, stagger: 0.03, immediateRender: false }, i - 0.5)
					.fromTo(b.nouveaux, { autoAlpha: 0, x: -14 }, { autoAlpha: 1, x: 0, duration: 0.25, stagger: 0.035, immediateRender: false }, i - 0.45)
					.fromTo(b.actions, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.3, immediateRender: false }, i - 0.3)
					.addLabel(`p${i}`, i);
			}
			tl.to({}, { duration: 0.45 });
			positions = Array.from({ length: n }, (_, i) => tl.labels[`p${i}`] / tl.duration());
			marquer(0);

			// Les crans mènent directement au palier voulu.
			// stopPropagation : Lenis (option anchors) écoute les clics sur les liens « #… » au niveau
			// de la fenêtre et lançait son propre défilement vers l'article, en haut de la scène.
			let fin = 0;
			const allerA = (e: Event) => {
				const i = Number((e.currentTarget as HTMLElement).dataset.cran);
				const st = tl.scrollTrigger;
				if (!st) return;
				e.preventDefault();
				e.stopPropagation();
				const y = Math.round(st.start + (st.end - st.start) * positions[i]);
				programme = true;
				window.clearTimeout(fin);
				const terminer = () => {
					window.clearTimeout(fin);
					fin = window.setTimeout(() => (programme = false), 200);
				};
				const lenis = (window as any).lenis;
				if (lenis?.scrollTo) {
					lenis.scrollTo(y, { duration: 1.1, force: true, onComplete: terminer });
					fin = window.setTimeout(() => (programme = false), 2000);
				} else {
					window.scrollTo({ top: y, behavior: 'smooth' });
					fin = window.setTimeout(() => (programme = false), 1200);
				}
			};
			crans.forEach((c) => c.addEventListener('click', allerA));

			return () => {
				crans.forEach((c) => c.removeEventListener('click', allerA));
				formules.classList.remove('is-pinned');
				window.clearTimeout(fin);
			};
		});
	}

	// ---------- Fonctionnalités : la capture collante suit la ligne au milieu de l'écran (bureau) ----------
	const fonctions = document.querySelector<HTMLElement>('[data-fonctions]');
	if (fonctions) {
		const liste = fonctions.querySelector<HTMLElement>('[data-fonctions-liste]')!;
		const lignes = Array.from(fonctions.querySelectorAll<HTMLElement>('[data-fonction]'));
		const images = Array.from(fonctions.querySelectorAll<HTMLElement>('[data-fonction-img]'));
		const legende = fonctions.querySelector<HTMLElement>('[data-fonction-legende]');
		const numero = fonctions.querySelector<HTMLElement>('[data-fonction-num]');
		const total = String(lignes.length).padStart(2, '0');

		mm.add('(min-width: 992px)', () => {
			let actif = 0;
			const activer = (i: number) => {
				if (i === actif) return;
				actif = i;
				lignes.forEach((l, j) => l.classList.toggle('is-actif', j === i));
				images.forEach((im, j) => im.classList.toggle('is-actif', j === i));
				if (legende) legende.textContent = lignes[i].dataset.titre ?? '';
				if (numero) numero.textContent = `${String(i + 1).padStart(2, '0')} / ${total}`;
			};
			fonctions.classList.add('is-js');
			const suivre = () => {
				const milieu = window.innerHeight / 2;
				let meilleure = 0;
				let ecart = Infinity;
				lignes.forEach((l, i) => {
					const r = l.getBoundingClientRect();
					const d = Math.abs(r.top + r.height / 2 - milieu);
					if (d < ecart) {
						ecart = d;
						meilleure = i;
					}
				});
				activer(meilleure);
			};
			ScrollTrigger.create({ trigger: liste, start: 'top 60%', end: 'bottom 40%', onUpdate: suivre, onToggle: suivre });
			const surLigne = (e: Event) => activer(lignes.indexOf(e.currentTarget as HTMLElement));
			lignes.forEach((l) => l.addEventListener('focusin', surLigne));
			return () => {
				lignes.forEach((l) => l.removeEventListener('focusin', surLigne));
				fonctions.classList.remove('is-js');
			};
		});
	}

	// ---------- Méthode : le trait se dessine au fil du défilement ----------
	// Le trait plein est dévoilé par un masque (clip-path) piloté par la variable --p, de 0 à 1.
	// (L'ancienne version animait stroke-dashoffset de 1 à 0 avec pathLength="1" : GSAP arrondit
	// les valeurs en px au pixel près, la valeur passait donc directement de 1 à 0 et le trait
	// apparaissait d'un coup.)
	const methode = document.querySelector<HTMLElement>('[data-methode]');
	if (methode) {
		const trait = methode.querySelector<HTMLElement>('[data-trait]');
		const traitV = methode.querySelector<HTMLElement>('[data-trait-v]');
		const etapes = Array.from(methode.querySelectorAll<HTMLElement>('[data-etape]'));
		const piste = methode.querySelector<HTMLElement>('[data-methode-piste]')!;
		const atteindre = (p: number) => etapes.forEach((e, i) => e.classList.toggle('is-atteint', p >= (i === 0 ? 0.01 : i / (etapes.length - 1) - 0.03)));

		const dessiner = (cible: HTMLElement | null, start: string, end: string) => {
			if (!cible) return;
			methode.classList.add('is-anime');
			const etat = { p: 0 };
			const rendre = () => {
				cible.style.setProperty('--p', etat.p.toFixed(4));
				atteindre(etat.p);
			};
			rendre();
			gsap.to(etat, {
				p: 1,
				ease: 'none',
				onUpdate: rendre,
				scrollTrigger: { trigger: piste, start, end, scrub: 0.6 },
			});
			return () => {
				methode.classList.remove('is-anime');
				cible.style.removeProperty('--p');
			};
		};
		mm.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => dessiner(trait, 'top 85%', 'top 25%'));
		mm.add('(max-width: 767.98px) and (prefers-reduced-motion: no-preference)', () => dessiner(traitV, 'top 75%', 'bottom 55%'));
	}

	wireScroll();
</script>
