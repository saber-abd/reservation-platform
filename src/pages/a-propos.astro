---
import Layout from '@/layouts/Layout.astro';
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig();
---

<Layout title="À propos" description={`En savoir plus sur ${siteConfig.business.name}.`}>
	<section class="mx-auto max-w-6xl px-6 py-20">
		<div class="grid items-center gap-10 md:grid-cols-2">
			<div data-aos="fade-right">
				<h1 class="text-3xl font-bold text-stone-900 md:text-4xl">À propos</h1>
				<p class="mt-4 text-stone-500">{siteConfig.business.description}</p>
				<p class="mt-4 text-stone-500">
					Notre équipe met un point d'honneur à vous offrir un accueil chaleureux et des prestations
					de qualité, dans un cadre pensé pour votre confort.
				</p>
				<a
					href="/reservation"
					class="mt-6 inline-block rounded-xl bg-rose-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-rose-700"
				>
					Réserver maintenant
				</a>
			</div>
			<div class="overflow-hidden rounded-2xl shadow-xl" data-aos="fade-left">
				<img src="/images/about_salon.jpg" alt="Notre équipe" class="aspect-square w-full object-cover" />
			</div>
		</div>
	</section>

	<!-- Notre histoire -->
	<section class="bg-stone-50 py-20">
		<div class="mx-auto max-w-3xl px-6" data-aos="fade-up">
			<h2 class="text-2xl font-bold text-stone-900 md:text-3xl">Notre histoire</h2>
			<p class="mt-4 text-stone-500">{siteConfig.about.story}</p>
		</div>
	</section>

	<!-- Nos objectifs et motivations -->
	<section class="mx-auto max-w-6xl px-6 py-20">
		<h2 class="text-2xl font-bold text-stone-900 md:text-3xl" data-aos="fade-up">Nos objectifs et motivations</h2>
		<div class="mt-10 grid gap-6 md:grid-cols-3">
			{
				siteConfig.about.objectives.map((objective, index) => (
					<div
						class="rounded-xl border border-border bg-white p-6 shadow-sm"
						data-aos="fade-up"
						data-aos-delay={index * 75}
					>
						<p class="font-semibold text-stone-900">{objective.title}</p>
						<p class="mt-2 text-sm text-stone-500">{objective.description}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- Diplômes et certifications -->
	<section class="bg-stone-50 py-20">
		<div class="mx-auto max-w-3xl px-6">
			<h2 class="text-2xl font-bold text-stone-900 md:text-3xl" data-aos="fade-up">Diplômes et certifications</h2>
			<ul class="mt-8 space-y-4">
				{
					siteConfig.about.diplomas.map((diploma, index) => (
						<li
							class="flex items-center justify-between rounded-xl border border-border bg-white p-4 shadow-sm"
							data-aos="fade-up"
							data-aos-delay={index * 75}
						>
							<div>
								<p class="font-medium text-stone-900">{diploma.title}</p>
								<p class="text-sm text-stone-500">{diploma.institution}</p>
							</div>
							<span class="text-sm font-semibold text-rose-600">{diploma.year}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>
