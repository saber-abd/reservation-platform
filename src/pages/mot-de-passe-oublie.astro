---
import Layout from '@/layouts/Layout.astro';
import ForgotPasswordForm from '@/components/auth/ForgotPasswordForm';
---

<Layout title="Mot de passe oublié" description="Réinitialisez votre mot de passe." noindex>
	<section class="mx-auto max-w-md px-6 py-20">
		<h1 class="text-2xl font-bold text-stone-900">Mot de passe oublié</h1>
		<p class="mt-2 text-sm text-stone-500">
			Renseignez votre email, nous vous enverrons un lien pour choisir un nouveau mot de passe.
		</p>
		<div class="mt-8">
			<ForgotPasswordForm client:load />
		</div>
		<p class="mt-6 text-sm text-stone-500">
			<a href="/connexion" class="font-medium text-rose-600 hover:underline">Retour à la connexion</a>
		</p>
	</section>
</Layout>
