---
import PremiumLayout from '@/layouts/premium/PremiumLayout.astro';
import AutoHero from '@/components/premium/AutoHero.astro';
import AutoStats from '@/components/premium/AutoStats.astro';
import AutoMots from '@/components/premium/AutoMots.astro';
import AutoServicesGrid from '@/components/premium/AutoServicesGrid.astro';
import AutoEtapes from '@/components/premium/AutoEtapes.astro';
import PremiumCta from '@/components/premium/PremiumCta.astro';
import { chargerPrestations } from '@/components/premium/prestations';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);
const prestations = await chargerPrestations();
---

<PremiumLayout
	title="Accueil"
	description={`${siteConfig.business.name} : entretien, diagnostic, mécanique, pneus et lavage. Tarifs affichés, devis écrit avant intervention, réservation en ligne.`}
>
	<AutoHero />
	<AutoStats />
	<AutoMots />
	<AutoServicesGrid prestations={prestations} />
	<AutoEtapes />
	<PremiumCta numero="04" lignes={['Votre voiture', 'au pont', 'cette semaine ?']} />
</PremiumLayout>
