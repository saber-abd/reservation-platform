---
import PremiumAutoLayout from '@/layouts/PremiumAutoLayout.astro';
import Map from '@/components/Map.astro';
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig(Astro.url.pathname);
const basePath = Astro.url.pathname.match(/^\/(demo-[^/]+)/)?.[0] || '';
---

<PremiumAutoLayout title="Contact" description={`Prenez contact avec le garage ${siteConfig.business.name} pour toute demande.`}>
	<section class="pt-32 pb-20 bg-background px-6">
		<div class="max-w-6xl mx-auto grid gap-12 lg:grid-cols-2">
			<div data-aos="fade-right">
				<h1 class="text-4xl font-black text-foreground md:text-5xl uppercase font-[var(--font-heading)]">
					Contactez l'<span class="text-primary">Équipe</span>
				</h1>
				<p class="mt-4 text-muted-foreground font-medium">
					Notre atelier est ouvert pour l'entretien et la réparation de votre véhicule. N'hésitez pas à nous appeler ou à passer nous voir.
				</p>

				<div class="mt-12 space-y-8">
					<div class="flex items-start gap-6">
						<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-card border border-border text-primary shadow-sm">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
						</div>
						<div>
							<p class="font-bold text-foreground tracking-wider uppercase text-sm">Assistance Téléphonique</p>
							<p class="mt-1 text-muted-foreground">{siteConfig.business.phone}</p>
						</div>
					</div>

					<div class="flex items-start gap-6">
						<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-card border border-border text-primary shadow-sm">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
						</div>
						<div>
							<p class="font-bold text-foreground tracking-wider uppercase text-sm">Email</p>
							<p class="mt-1 text-muted-foreground">{siteConfig.business.email}</p>
						</div>
					</div>
				</div>
			</div>

			<form
				id="contact-form"
				data-business-email={siteConfig.business.email}
				class="flex flex-col gap-6 rounded-2xl border border-border bg-card p-8 shadow-sm"
				data-aos="fade-left"
			>
				<div>
					<label for="name" class="text-xs font-bold text-muted-foreground uppercase tracking-widest">Nom complet</label>
					<input
						id="name"
						name="name"
						type="text"
						required
						class="mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
					/>
				</div>
				<div>
					<label for="email" class="text-xs font-bold text-muted-foreground uppercase tracking-widest">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						class="mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
					/>
				</div>
				<div>
					<label for="message" class="text-xs font-bold text-muted-foreground uppercase tracking-widest">Message</label>
					<textarea
						id="message"
						name="message"
						rows="4"
						required
						class="mt-2 w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
					></textarea>
				</div>
				<p id="form-status" class="text-sm hidden"></p>
				<button
					id="submit-btn"
					type="submit"
					class="mt-2 rounded-xl bg-primary px-4 py-4 text-sm font-bold text-primary-foreground transition-all hover:bg-primary/90 uppercase tracking-widest hover:scale-[1.02] active:scale-[0.98] shadow-md"
				>
					Envoyer la demande
				</button>
			</form>
		</div>

		<div class="max-w-6xl mx-auto h-[400px] overflow-hidden rounded-2xl bg-card border border-border mt-16 shadow-sm" data-aos="fade-up">
			<Map 
				lat={siteConfig.business.lat} 
				lng={siteConfig.business.lng} 
				name={siteConfig.business.name}
				address={siteConfig.business.address}
			/>
		</div>
	</section>
</PremiumAutoLayout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const status = document.getElementById('form-status');
	const btn = document.getElementById('submit-btn') as HTMLButtonElement;

	if (form && status && btn) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(form);
			const businessEmail = form.dataset.businessEmail;
			
			btn.disabled = true;
			btn.textContent = 'Transmission...';
			status.classList.add('hidden');
			
			try {
				const userEmail = formData.get('email') as string;
				const userName = formData.get('name') as string;
				const userMessage = formData.get('message') as string;

				// EmailJS Configuration
				const serviceID = 'service_7pvm3br';
				const templateID = 'template_3j75n8o';
				const publicKey = '5Jjd71i9EWOeYyzsG';

				const templateParams = {
					from_name: userName,
					to_name: businessEmail || 'Professionnel',
					name: userName,
					email: userEmail,
					reply_to: userEmail,
					message: userMessage,
				};

				const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						service_id: serviceID,
						template_id: templateID,
						user_id: publicKey,
						template_params: templateParams,
					})
				});

				if (response.ok) {
					status.textContent = 'Message transmis avec succès.';
					status.className = 'text-sm text-green-500 font-medium';
					form.reset();
				} else {
					const errorText = await response.text();
					throw new Error(errorText || 'Erreur lors de la transmission');
				}
			} catch (err: any) {
				status.textContent = `Erreur : ${err.message}`;
				status.className = 'text-sm text-red-500 font-medium';
			} finally {
				btn.disabled = false;
				btn.textContent = 'Envoyer la demande';
				status.classList.remove('hidden');
			}
		});
	}
</script>
