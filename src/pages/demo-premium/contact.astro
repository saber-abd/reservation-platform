---
import PremiumLayout from '@/layouts/premium/PremiumLayout.astro';
import PremiumPageHead from '@/components/premium/PremiumPageHead.astro';
import Map from '@/components/premium/PremiumMap.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);
const { business } = siteConfig;
---

<PremiumLayout title="Contact" description={`Contacter ${business.name} : téléphone, e-mail, adresse et horaires de l'atelier.`}>
	<PremiumPageHead rubrique="Contact" lignes={['Une question', 'avant de venir ?']} legende="Réponse sous 24 h ouvrées">
		Un bruit au freinage, un voyant allumé, une demande de devis : décrivez ce que vous constatez,
		avec la marque, le modèle et le kilométrage du véhicule.
	</PremiumPageHead>

	<section class="pa-wrap pb-[clamp(64px,9vw,120px)]">
		<div class="pa-grid items-start">
			<div class="pa-col-half-a lg:pr-10" data-reveal>
				<h2 class="pa-num"><b>01</b> Coordonnées</h2>
				<div class="pa-coord mt-6">
					<div>
						<span class="pa-tech">Téléphone</span>
						<a href={`tel:${business.phone.replace(/\s/g, '')}`}>{business.phone}</a>
					</div>
					<div>
						<span class="pa-tech">E-mail</span>
						<a href={`mailto:${business.email}`}>{business.email}</a>
					</div>
					<div class="sm:col-span-2">
						<span class="pa-tech">Atelier</span>
						<b>{business.address}</b>
					</div>
				</div>
				<table class="pa-horaires mt-10">
					<caption class="pa-tech mb-3 text-left">Horaires</caption>
					<tbody>
						{business.openingHours.map((h) => (
							<tr><th scope="row">{h.day}</th><td>{h.hours}</td></tr>
						))}
					</tbody>
				</table>
			</div>

			<form
				id="contact-form"
				data-business-email={business.email}
				class="pa-fiche pa-col-half-b grid gap-5"
				data-reveal
				data-reveal-delay="120"
			>
				<div class="pa-fiche__tete">
					<h2 class="pa-h3">Écrire à l'atelier</h2>
					<span class="pa-tech">Tous les champs sont requis</span>
				</div>
				<div class="pa-champ">
					<label for="name">Nom complet</label>
					<input id="name" name="name" type="text" autocomplete="name" required />
				</div>
				<div class="pa-champ">
					<label for="email">E-mail</label>
					<input id="email" name="email" type="email" autocomplete="email" required />
				</div>
				<div class="pa-champ">
					<label for="message">Message</label>
					<textarea id="message" name="message" rows="5" required placeholder="Ex. : Clio IV de 2017, 98 000 km, grincement à l'avant gauche au freinage."></textarea>
				</div>
				<p id="form-status" class="pa-statut hidden" role="status"></p>
				<button id="submit-btn" type="submit" class="pa-btn pa-btn--encre pa-btn--bloc mt-1">Envoyer le message</button>
			</form>
		</div>

		<div class="pa-carte mt-16 md:mt-24" data-reveal>
			<Map lat={business.lat} lng={business.lng} label={business.name} class="h-full" />
		</div>
	</section>
</PremiumLayout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const status = document.getElementById('form-status');
	const btn = document.getElementById('submit-btn') as HTMLButtonElement;

	if (form && status && btn) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(form);
			const businessEmail = form.dataset.businessEmail;

			btn.disabled = true;
			btn.textContent = 'Envoi…';
			status.classList.add('hidden');

			try {
				const userEmail = formData.get('email') as string;
				const userName = formData.get('name') as string;
				const userMessage = formData.get('message') as string;

				// Configuration EmailJS
				const serviceID = 'service_7pvm3br';
				const templateID = 'template_3j75n8o';
				const publicKey = '5Jjd71i9EWOeYyzsG';

				const templateParams = {
					from_name: userName,
					to_name: businessEmail || 'Professionnel',
					name: userName,
					email: userEmail,
					reply_to: userEmail,
					message: userMessage,
				};

				const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						service_id: serviceID,
						template_id: templateID,
						user_id: publicKey,
						template_params: templateParams,
					}),
				});

				if (response.ok) {
					status.textContent = 'Message envoyé. Réponse sous 24 h ouvrées.';
					status.className = 'pa-statut is-ok';
					form.reset();
				} else {
					const errorText = await response.text();
					throw new Error(errorText || "Erreur lors de l'envoi");
				}
			} catch (err: any) {
				status.textContent = `Erreur : ${err.message}`;
				status.className = 'pa-statut is-err';
			} finally {
				btn.disabled = false;
				btn.textContent = 'Envoyer le message';
				status.classList.remove('hidden');
			}
		});
	}
</script>
