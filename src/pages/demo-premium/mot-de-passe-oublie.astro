---
import PremiumAuthShell from '@/components/premium/PremiumAuthShell.astro';
import ForgotPasswordForm from '@/components/premium/auth/PremiumForgotPasswordForm';
---

<PremiumAuthShell
	pageTitle="Mot de passe oublié"
	description="Réinitialisez votre mot de passe."
	titre="Mot de passe oublié"
	lead="Indiquez l'adresse e-mail du compte : vous recevrez un lien pour choisir un nouveau mot de passe."
>
	<ForgotPasswordForm basePath="/demo-premium" client:load />
	<Fragment slot="after">
		<a href="/demo-premium/connexion" class="pa-link">Retour à la connexion</a>
	</Fragment>
</PremiumAuthShell>
