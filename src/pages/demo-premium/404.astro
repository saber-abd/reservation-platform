---
import PremiumLayout from '@/layouts/premium/PremiumLayout.astro';

Astro.response.status = 404;
---

<PremiumLayout title="Page introuvable" noindex>
	<section class="pa-404 pa-wrap">
		<div class="w-full">
			<p class="pa-404__code" aria-hidden="true">404</p>
			<div class="mt-8 grid gap-6 border-t border-[#33373c] pt-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
				<div>
					<h1 class="pa-h2">Page introuvable</h1>
					<p class="pa-text mt-3">Cette adresse n'existe pas ou a été déplacée. Les tarifs et la réservation restent accessibles depuis l'accueil.</p>
				</div>
				<div class="flex flex-wrap gap-3">
					<a href="/demo-premium/" class="pa-btn"><span>Retour à l'accueil</span></a>
					<a href="/demo-premium/services" class="pa-btn pa-btn--ghost"><span>Voir les tarifs</span></a>
				</div>
			</div>
		</div>
	</section>
</PremiumLayout>
