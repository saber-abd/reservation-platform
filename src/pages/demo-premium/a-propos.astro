---
import PremiumLayout from '@/layouts/premium/PremiumLayout.astro';
import PremiumPageHead from '@/components/premium/PremiumPageHead.astro';
import PremiumPicture from '@/components/premium/PremiumPicture.astro';
import PremiumCta from '@/components/premium/PremiumCta.astro';
import AutoMots from '@/components/premium/AutoMots.astro';
import { images } from '@/components/premium/prestations';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);
const pad = (n: number) => String(n).padStart(2, '0');

const engagements = [
	{ titre: 'Transparence sur le prix', texte: 'Devis clair avant toute intervention. Aucune réparation n’est effectuée sans votre accord explicite, donné par écrit.' },
	{ titre: 'Pièces tracées', texte: 'Pièces d’origine constructeur ou de qualité équivalente, référence et marque indiquées sur la facture.' },
	{ titre: 'Garantie atelier', texte: 'Toutes les interventions mécaniques sont garanties un an, pièces et main-d’œuvre.' },
];

const habilitations = [
	{ titre: 'Diagnostic électronique avancé', organisme: 'Bosch Car Service Training', annee: '2023' },
	{ titre: 'Véhicules hybrides et électriques', organisme: 'Habilitation électrique B2VL', annee: '2022' },
	{ titre: 'Préparation moteur et reprogrammation', organisme: 'Masterclass Motorsport Engineering', annee: '2020' },
];
---

<PremiumLayout title="À propos" description={`L'atelier ${siteConfig.business.name} : équipe, engagements et habilitations.`}>
	<PremiumPageHead
		rubrique="Le garage"
		lignes={['Un atelier', 'de quartier.']}
		legende="Atelier mécanique, pont n° 2"
		photo={images.atelier}
		reperes={[
			{ label: 'Ouverture', valeur: '2011' },
			{ label: 'Équipe', valeur: '6 personnes' },
			{ label: 'Surface', valeur: '600 m²' },
			{ label: 'Véhicules', valeur: 'Toutes marques' },
		]}
	>
		{siteConfig.business.description}
	</PremiumPageHead>

	<section class="pa-section" aria-labelledby="histoire-titre">
		<div class="pa-wrap pa-grid">
			<p class="pa-num pa-col-num"><b>01</b> Histoire</p>
			<h2 id="histoire-titre" class="pa-h2 pa-col-main" data-lines>
				<span class="pa-line"><span>D'abord, la préparation</span></span>
				<span class="pa-line"><span>moteur.</span></span>
			</h2>
			<div class="pa-col-a lg:pt-4">
				<div class="pa-text grid gap-4" data-reveal>
					<p>
						Le garage a ouvert comme un petit atelier de préparation pour la course de côte. La rigueur que demande une
						mécanique de compétition, on l'applique aujourd'hui aux voitures de tous les jours : couples de serrage
						respectés, pièces notées, essai routier systématique.
					</p>
					<p>
						L'équipe compte cinq techniciens, dont un préparateur esthétique, et une personne à l'accueil qui suit
						votre dossier de la prise de rendez-vous à la facture.
					</p>
				</div>
			</div>
			<figure class="pa-col-b lg:pl-10" data-reveal data-reveal-delay="120">
				<div class="pa-cadre pa-cadre--parallaxe aspect-[4/5]">
					<PremiumPicture {...images.cle} sizes="(min-width: 992px) 40vw, 100vw" />
				</div>
				<figcaption class="pa-legende">
					<span class="pa-tech">Remise en état d'un carburateur</span>
					<span class="pa-tech">Photo : Christian Buehner</span>
				</figcaption>
			</figure>
		</div>
	</section>

	<AutoMots />

	<section class="pa-section pa-section--graphite" aria-labelledby="engagements-titre">
		<div class="pa-wrap pa-grid">
			<p class="pa-num pa-col-num"><b>02</b> Engagements</p>
			<div class="pa-col-main">
				<h2 id="engagements-titre" class="pa-h2" data-lines>
					<span class="pa-line"><span>Ce qui est écrit</span></span>
					<span class="pa-line"><span>sur la facture.</span></span>
				</h2>
				<ol class="pa-rows mt-10" data-reveal-group>
					{engagements.map((e, i) => (
						<li class="pa-row pa-row--cols">
							<span class="pa-row__n">{pad(i + 1)}</span>
							<h3 class="pa-h3">{e.titre}</h3>
							<p class="pa-text">{e.texte}</p>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<section class="pa-section" aria-labelledby="habilitations-titre">
		<div class="pa-wrap pa-grid">
			<p class="pa-num pa-col-num"><b>03</b> Habilitations</p>
			<div class="pa-col-main">
				<h2 id="habilitations-titre" class="pa-h2" data-lines>
					<span class="pa-line"><span>Formations</span></span>
					<span class="pa-line"><span>de l'équipe.</span></span>
				</h2>
				<ol class="pa-rows mt-10" data-reveal-group>
					{habilitations.map((h, i) => (
						<li class="pa-row pa-row--an">
							<span class="pa-row__n">{pad(i + 1)}</span>
							<div>
								<h3 class="pa-h3">{h.titre}</h3>
								<p class="pa-text mt-1">{h.organisme}</p>
							</div>
							<span class="pa-row__an">{h.annee}</span>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<PremiumCta numero="04" />
</PremiumLayout>
