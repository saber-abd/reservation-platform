---
import PremiumAuthShell from '@/components/premium/PremiumAuthShell.astro';
import SignupForm from '@/components/premium/auth/PremiumSignupForm';
---

<PremiumAuthShell
	pageTitle="Inscription"
	description="Créer un compte client pour réserver et suivre vos interventions."
	titre="Créer un compte"
	lead="Le compte sert à réserver plus vite, retrouver vos factures et cumuler des points de fidélité."
>
	<SignupForm basePath="/demo-premium" client:load />
	<Fragment slot="after">
		Déjà inscrit ? <a href="/demo-premium/connexion" class="pa-link ml-1">Se connecter</a>
	</Fragment>
</PremiumAuthShell>
