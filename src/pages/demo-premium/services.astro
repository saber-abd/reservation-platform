---
import PremiumAutoLayout from '@/layouts/PremiumAutoLayout.astro';
import AutoServicesGrid from '@/components/premium/AutoServicesGrid';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);
const basePath = Astro.url.pathname.match(/^\/(demo-[^/]+)/)?.[0] || '';
---

<PremiumAutoLayout 
	title="Catalogue des Services" 
	description="L'arsenal mécanique complet pour votre véhicule. Découvrez nos prestations de pointe."
>
	<section class="pt-32 pb-16 bg-stone-950 text-center">
		<h1 class="text-4xl font-black text-white md:text-6xl uppercase tracking-tighter font-[var(--font-heading)]">
			Catalogue des <span class="text-primary">Services</span>
		</h1>
		<p class="mt-6 max-w-2xl mx-auto text-stone-400 font-medium">
			Du diagnostic électronique à la préparation esthétique complète. Choisissez l'excellence.
		</p>
	</section>

	<AutoServicesGrid basePath={basePath} client:load />

	<section class="py-20 bg-stone-900 border-t border-stone-800 text-center px-6">
		<h2 class="text-2xl font-bold text-white mb-4">Une demande sur-mesure ?</h2>
		<p class="text-stone-400 mb-8 max-w-xl mx-auto">Préparation moteur, covering complet, reprogrammation... Nos experts sont à votre disposition pour vos projets spéciaux.</p>
		<a href={`${basePath}/contact`} class="inline-flex items-center justify-center rounded-xl border-2 border-primary bg-transparent px-8 py-3 text-sm font-bold text-primary transition-colors hover:bg-primary hover:text-white uppercase tracking-wider">
			Nous contacter pour un devis
		</a>
	</section>
</PremiumAutoLayout>
