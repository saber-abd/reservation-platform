---
import PremiumAutoLayout from '@/layouts/PremiumAutoLayout.astro';
import LoginForm from '@/components/auth/LoginForm';
---

<PremiumAutoLayout title="Connexion" description="Connexion à l'espace premium." noindex>
	<section class="mx-auto max-w-md px-6 py-20">
		<h1 class="text-2xl font-black text-white uppercase tracking-widest font-[var(--font-heading)]">Connexion pilote</h1>
		<p class="mt-2 text-sm text-stone-400">Accédez à votre espace de gestion.</p>
		<div class="mt-8">
			<LoginForm client:load />
		</div>
		<p class="mt-6 text-sm text-stone-400">
			Nouveau pilote ? <a href="/demo-premium/inscription" class="font-medium text-primary hover:underline">Créer un compte</a>
		</p>
	</section>
</PremiumAutoLayout>
