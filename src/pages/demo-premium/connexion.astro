---
import PremiumAuthShell from '@/components/premium/PremiumAuthShell.astro';
import LoginForm from '@/components/premium/auth/PremiumLoginForm';
---

<PremiumAuthShell
	pageTitle="Connexion"
	description="Connexion à l'espace client et à l'espace professionnel du garage."
	titre="Connexion"
	lead="Clients et professionnels utilisent le même formulaire : vous êtes dirigé vers votre espace."
>
	<LoginForm basePath="/demo-premium" client:load />
	<Fragment slot="after">
		Pas encore de compte ? <a href="/demo-premium/inscription" class="pa-link ml-1">Créer un compte</a>
	</Fragment>
	<a slot="visite" href="/demo-premium/apercu/dashboard" class="pa-visite">
		<span>
			<b>Visiter l'espace professionnel</b>
			<span>Aperçu du tableau de bord avec des données fictives, sans compte.</span>
		</span>
		<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
	</a>
</PremiumAuthShell>
