---
import CommercialLayout from '@/layouts/commercial/CommercialLayout.astro';
import Avatar from '@/components/commercial/Avatar.astro';
import BrandIcon from '@/components/commercial/BrandIcon.astro';
import { membres, projets, valeurs } from '@/components/commercial/equipe';
import { ArrowRight } from 'lucide-react';

const chapitres = [
	{
		titre: 'Deux profils complémentaires',
		texte:
			"D'un côté les réseaux, la sécurité et le développement, de l'autre l'ingénierie d'affaires et la relation client. L'un construit l'outil, l'autre s'assure qu'il répond au vrai besoin.",
	},
	{
		titre: 'Un constat de terrain',
		texte:
			'Beaucoup de commerces et de petites entreprises gèrent encore leurs rendez-vous à la main, ou paient cher des outils trop génériques.',
	},
	{
		titre: 'Une plateforme en trois formules',
		texte:
			'Nous avons conçu trois niveaux de solution, du site vitrine relié à Google Agenda à la plateforme avec gestion d’équipe, pour que chacun trouve la sienne.',
	},
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<CommercialLayout title="Notre histoire | SaberWeb.dev" description="Qui sommes-nous ? Saber et Nadir, un profil technique et un profil commercial, conçoivent des sites vitrines et des plateformes de réservation.">
	<!-- EN-TÊTE -->
	<section class="conteneur entete-page">
		<p class="repere num">Notre histoire</p>
		<div class="mt-4 grid gap-10 lg:grid-cols-[minmax(0,8fr)_minmax(0,4fr)] lg:items-end">
			<h1 class="titre-geant max-w-[13ch]" data-split>Deux parcours, un même projet.</h1>
			<div class="flex items-center gap-4" data-reveal>
				<span class="flex">
					{membres.map((m, i) => (
						<Avatar photo={m.photo} initiales={m.initiales} prenom={m.prenom} size={88} class={`ring-4 ring-papier ${i > 0 ? '-ml-5' : ''}`} />
					))}
				</span>
				<span class="text-sm text-gris">{membres.map((m) => m.prenom).join(' et ')}</span>
			</div>
		</div>
		<p class="chapo mt-10 max-w-2xl" data-reveal>
			Nous sommes {membres.map((m) => m.prenom).join(' et ')}. Un profil technique, un profil commercial&nbsp;: nous construisons pour
			les indépendants des sites rapides et des outils de réservation qu’ils gèrent eux-mêmes.
		</p>
	</section>

	<!-- CHAPITRES -->
	<section class="conteneur pb-20 lg:pb-28" aria-labelledby="debut-titre">
		<h2 id="debut-titre" class="sr-only">Comment tout a commencé</h2>
		<ol class="grid border-t border-encre md:grid-cols-3 md:gap-10" data-reveal-group>
			{chapitres.map((c, i) => (
				<li class="border-b border-filet py-8 md:border-b-0">
					<p class="repere num">{pad(i + 1)}</p>
					<h3 class="titre-m mt-3">{c.titre}</h3>
					<p class="mt-3 text-gris">{c.texte}</p>
				</li>
			))}
		</ol>
	</section>

	<!-- PROFILS -->
	<section class="sur-nuit py-20 lg:py-28" aria-labelledby="profils-titre">
		<div class="conteneur">
			<h2 id="profils-titre" class="titre-xl" data-split>Qui sommes-nous</h2>
			<div class="mt-14 grid gap-14 md:grid-cols-2 md:gap-12">
				{membres.map((m, i) => (
					<article class="flex flex-col gap-6 border-t border-white/15 pt-8" data-reveal data-reveal-delay={String(i * 120)}>
						<div class="flex items-center gap-5">
							<Avatar photo={m.photo} initiales={m.initiales} prenom={m.prenom} size={112} class="shrink-0" />
							<div>
								<h3 class="titre-l">{m.prenom}</h3>
								<p class="mt-1 text-stone-400">{m.role}</p>
							</div>
						</div>
						<p class="text-[#cfc6b6]">{m.accroche}</p>
						<ul class="space-y-2 text-[0.9375rem] text-stone-300">
							{m.parcours.map((p) => (
								<li class="flex gap-3"><span class="text-accent-clair" aria-hidden="true">—</span><span>{p}</span></li>
							))}
						</ul>
						<p class="text-sm text-stone-400">{m.competences.join(' · ')}</p>
						<a href={m.linkedin} target="_blank" rel="noopener noreferrer" class="lien self-start" aria-label={`Profil LinkedIn de ${m.prenom}`}>
							<BrandIcon name="linkedin" size={15} /> LinkedIn
						</a>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- PROJETS -->
	<section class="conteneur py-20 lg:py-28" aria-labelledby="projets-titre">
		<h2 id="projets-titre" class="titre-xl max-w-[16ch]" data-split>Ce que nous construisons</h2>
		<ol class="mt-12 border-t border-encre">
			{projets.map((p, i) => (
				<li class="grid gap-3 border-b border-filet py-8 lg:grid-cols-[3rem_minmax(0,4fr)_minmax(0,6fr)_minmax(0,3fr)] lg:gap-8" data-reveal>
					<span class="repere num">{pad(i + 1)}</span>
					<h3 class="titre-m">{p.titre}</h3>
					<p class="text-gris">{p.texte}</p>
					<p class="text-sm text-stone-500">{p.tags.join(' · ')}</p>
				</li>
			))}
		</ol>
		<p class="mt-10" data-reveal>
			<a href="/#tarification" class="btn btn-dark btn-lg">Voir les formules <ArrowRight size={17} class="btn-arrow" /></a>
		</p>
	</section>

	<!-- VALEURS -->
	<section class="bg-sable py-20 lg:py-24" aria-labelledby="valeurs-titre">
		<div class="conteneur">
			<h2 id="valeurs-titre" class="sr-only">Notre façon de travailler</h2>
			<div class="grid gap-10 md:grid-cols-3" data-reveal-group>
				{valeurs.map((v, i) => (
					<div class="border-t border-encre pt-6">
						<p class="repere num">{pad(i + 1)}</p>
						<h3 class="titre-m mt-3">{v.titre}</h3>
						<p class="mt-3 text-gris">{v.texte}</p>
					</div>
				))}
			</div>
		</div>
	</section>
</CommercialLayout>
