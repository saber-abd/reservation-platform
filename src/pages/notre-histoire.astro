---
import CommercialLayout from '@/layouts/commercial/CommercialLayout.astro';
import Avatar from '@/components/commercial/Avatar.astro';
import { membres, projets, valeurs } from '@/components/commercial/equipe';
import { ArrowRight, ExternalLink, Sparkles } from 'lucide-react';

const chapitres = [
	{
		numero: '01',
		titre: 'Deux profils complémentaires',
		texte:
			"D'un côté les réseaux, la sécurité et le développement, de l'autre l'ingénierie d'affaires et la relation client. L'un construit l'outil, l'autre s'assure qu'il répond au vrai besoin.",
	},
	{
		numero: '02',
		titre: 'Un constat de terrain',
		texte:
			'Beaucoup de commerces et de petites entreprises gèrent encore leurs rendez-vous à la main, ou paient cher des outils trop génériques.',
	},
	{
		numero: '03',
		titre: 'Une plateforme en trois formules',
		texte:
			'Nous avons conçu trois niveaux de solution, du site vitrine relié à Google Agenda à la suite complète de gestion d’équipe, pour que chacun trouve la sienne.',
	},
];
---

<CommercialLayout title="Notre histoire | SaberWeb.dev" description="Qui sommes-nous ? Un duo technique et business qui conçoit des sites et plateformes de réservation sur mesure.">
	<!-- HERO : fond sombre, deux photos flottantes -->
	<section class="relative overflow-hidden bg-stone-900 text-white">
		<div class="hero-glow" aria-hidden="true"></div>
		<div class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 lg:grid-cols-2 lg:py-28">
			<div>
				<p class="inline-flex items-center gap-2 rounded-full border border-white/15 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-stone-300" data-aos="fade-up">
					<Sparkles size={14} /> Notre histoire
				</p>
				<h1 class="mt-6 text-4xl font-extrabold leading-tight sm:text-5xl" data-aos="fade-up" data-aos-delay="100">
					Deux parcours,<br /><span class="text-rose-400">un même projet.</span>
				</h1>
				<p class="mt-6 max-w-lg text-lg text-stone-300" data-aos="fade-up" data-aos-delay="200">
					Nous sommes {membres.map((m) => m.prenom).join(' et ')}. Un profil technique, un profil business : nous mettons nos parcours au service des professionnels qui veulent des outils simples, rapides et vraiment à eux.
				</p>
			</div>

			<div class="relative mx-auto h-80 w-full max-w-sm sm:h-96" >
				{membres.map((m, i) => (
					<figure class={`floater absolute ${i === 0 ? 'left-0 top-0' : 'bottom-0 right-0'}`} style={`--delay:${i * -3}s`}>
						<div class="rounded-full p-1.5 ring-1 ring-white/20 bg-white/5 shadow-2xl">
							<Avatar photo={m.photo} initiales={m.initiales} prenom={m.prenom} size={176} />
						</div>
						<figcaption class="mt-3 text-center text-sm font-semibold text-stone-200">{m.prenom}</figcaption>
					</figure>
				))}
				<div class="absolute left-1/2 top-1/2 h-px w-40 -translate-x-1/2 -translate-y-1/2 rotate-[-35deg] bg-gradient-to-r from-transparent via-rose-400/60 to-transparent" aria-hidden="true"></div>
			</div>
		</div>
	</section>

	<!-- CHAPITRES : frise verticale -->
	<section class="mx-auto max-w-3xl px-6 py-24">
		<h2 class="text-3xl font-bold text-stone-900" data-aos="fade-up">Comment tout a commencé</h2>
		<ol class="mt-12 space-y-12 border-l-2 border-stone-200 pl-8">
			{chapitres.map((c, i) => (
				<li class="relative" data-aos="fade-up" data-aos-delay={i * 100}>
					<span class="absolute -left-[3.15rem] top-0 flex h-10 w-10 items-center justify-center rounded-full bg-rose-600 text-sm font-bold text-white shadow-md">{c.numero}</span>
					<h3 class="text-xl font-bold text-stone-900">{c.titre}</h3>
					<p class="mt-2 leading-relaxed text-stone-600">{c.texte}</p>
				</li>
			))}
		</ol>
	</section>

	<!-- PROFILS : en zigzag -->
	<section class="bg-white py-24">
		<div class="mx-auto max-w-6xl px-6">
			<h2 class="text-center text-3xl font-bold text-stone-900" data-aos="fade-up">Qui sommes-nous ?</h2>
			<div class="mt-16 space-y-20">
				{membres.map((m, i) => (
					<article class={`flex flex-col items-center gap-10 md:flex-row ${i % 2 ? 'md:flex-row-reverse' : ''}`}>
						<div class="shrink-0" data-aos={i % 2 ? 'fade-left' : 'fade-right'}>
							<div class="floater rounded-full bg-gradient-to-br from-rose-200 to-stone-200 p-2" style={`--delay:${i * -2}s`}>
								<Avatar photo={m.photo} initiales={m.initiales} prenom={m.prenom} size={200} />
							</div>
						</div>
						<div class="flex-1 rounded-3xl border border-stone-200 bg-stone-50 p-8" data-aos="fade-up">
							<div class="flex flex-wrap items-baseline justify-between gap-3">
								<h3 class="text-2xl font-bold text-stone-900">{m.prenom}</h3>
								<a href={m.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-semibold text-stone-500 transition-colors hover:text-rose-600">
									LinkedIn <ExternalLink size={14} />
								</a>
							</div>
							<p class="mt-1 text-sm font-semibold uppercase tracking-wider text-rose-600">{m.role}</p>
							<p class="mt-4 text-stone-700">{m.accroche}</p>
							<ul class="mt-5 space-y-2 text-sm text-stone-600">
								{m.parcours.map((p) => (
									<li class="flex gap-2"><span class="text-rose-600">▸</span><span>{p}</span></li>
								))}
							</ul>
							<ul class="mt-6 flex flex-wrap gap-2">
								{m.competences.map((c) => (
									<li class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-stone-700 ring-1 ring-stone-200">{c}</li>
								))}
							</ul>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- PROJETS : grille asymétrique -->
	<section class="mx-auto max-w-6xl px-6 py-24">
		<h2 class="text-3xl font-bold text-stone-900" data-aos="fade-up">Ce que nous construisons</h2>
		<div class="mt-12 grid gap-6 md:grid-cols-3">
			{projets.map((p, i) => (
				<div class={`group rounded-3xl p-8 transition-transform duration-300 hover:-translate-y-1 ${i === 0 ? 'bg-stone-900 text-white md:col-span-2 md:row-span-2' : 'border border-stone-200 bg-white'}`} data-aos="fade-up" data-aos-delay={i * 100}>
					<h3 class={`font-bold ${i === 0 ? 'text-2xl' : 'text-lg text-stone-900'}`}>{p.titre}</h3>
					<p class={`mt-3 leading-relaxed ${i === 0 ? 'text-stone-300' : 'text-sm text-stone-600'}`}>{p.texte}</p>
					<ul class="mt-6 flex flex-wrap gap-2">
						{p.tags.map((t) => (
							<li class={`rounded-full px-3 py-1 text-xs font-semibold ${i === 0 ? 'bg-white/10 text-white' : 'bg-stone-100 text-stone-700'}`}>{t}</li>
						))}
					</ul>
					{i === 0 && (
						<a href="/#tarification" class="mt-8 inline-flex items-center gap-2 text-sm font-bold text-rose-400 hover:text-rose-300">
							Voir les formules <ArrowRight size={16} class="transition-transform group-hover:translate-x-1" />
						</a>
					)}
				</div>
			))}
		</div>
	</section>

	<!-- VALEURS -->
	<section class="bg-rose-50 py-20">
		<div class="mx-auto grid max-w-6xl gap-10 px-6 md:grid-cols-3">
			{valeurs.map((v, i) => (
				<div data-aos="fade-up" data-aos-delay={i * 100}>
					<p class="text-5xl font-extrabold text-rose-200">0{i + 1}</p>
					<h3 class="mt-2 text-xl font-bold text-stone-900">{v.titre}</h3>
					<p class="mt-2 text-stone-600">{v.texte}</p>
				</div>
			))}
		</div>
	</section>

	<!-- CTA -->
	<section class="mx-auto max-w-3xl px-6 py-24 text-center">
		<h2 class="text-3xl font-bold text-stone-900" data-aos="fade-up">Écrivons la suite ensemble.</h2>
		<p class="mt-4 text-stone-600" data-aos="fade-up" data-aos-delay="100">Parlez-nous de votre activité, nous vous proposerons la formule adaptée.</p>
		<a href="/#contact" class="mt-8 inline-flex items-center gap-2 rounded-full bg-stone-900 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-stone-800" data-aos="fade-up" data-aos-delay="200">
			Nous contacter <ArrowRight size={16} />
		</a>
	</section>
</CommercialLayout>

<style>
	/* Halo fixe (aucune animation de flou, coûteuse en GPU). */
	.hero-glow {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(40% 50% at 80% 30%, rgb(225 29 72 / 0.25), transparent 70%),
			radial-gradient(35% 45% at 10% 90%, rgb(120 113 108 / 0.35), transparent 70%);
		pointer-events: none;
	}

	/* Effet flottant : uniquement transform, mis en pause hors écran. */
	.floater {
		animation: flotter 6s ease-in-out infinite;
		animation-delay: var(--delay, 0s);
		will-change: transform;
	}
	.floater.is-paused {
		animation-play-state: paused;
	}
	@keyframes flotter {
		0%, 100% { transform: translateY(0) rotate(0deg); }
		50% { transform: translateY(-14px) rotate(1.5deg); }
	}

	@media (prefers-reduced-motion: reduce) {
		.floater { animation: none; will-change: auto; }
	}
</style>

<script>
	// Les animations flottantes ne tournent que lorsque l'élément est visible.
	const floaters = document.querySelectorAll<HTMLElement>('.floater');
	if ('IntersectionObserver' in window) {
		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) entry.target.classList.toggle('is-paused', !entry.isIntersecting);
		});
		floaters.forEach((el) => observer.observe(el));
	}
</script>
