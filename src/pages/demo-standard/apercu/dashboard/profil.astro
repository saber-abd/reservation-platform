---
// Aperçu à données fictives (src/lib/preview.ts), sans compte et en lecture seule.
import DashboardLayout from '@/layouts/standard/StandardDashboardLayout.astro';
import DashboardNav from '@/components/standard/dashboard/StandardDashboardNav';
import ProfilePanel from '@/components/standard/dashboard/StandardProfilePanel';
---

