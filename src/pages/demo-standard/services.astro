---
import StandardLayout from '@/layouts/StandardLayout.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);
---

<StandardLayout title="Nos Tarifs" description="Découvrez la grille tarifaire de nos prestations de dépannage informatique.">
	<div class="bg-slate-900 py-16 md:py-24">
		<div class="mx-auto max-w-4xl px-6 text-center">
			<h1 class="text-3xl font-black text-white md:text-5xl mb-6">Grille Tarifaire</h1>
			<p class="text-lg text-slate-400 max-w-2xl mx-auto">
				Des tarifs transparents pour toutes nos interventions informatiques. Déplacement inclus dans un rayon de 20km.
			</p>
		</div>
	</div>

	<section class="py-20 bg-slate-50">
		<div class="mx-auto max-w-5xl px-6">
			<div class="grid gap-6 md:grid-cols-2">
				{
					siteConfig.services.map((service, index) => (
						<div 
							class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all hover:border-blue-200 hover:shadow-xl group" 
							data-aos="fade-up" 
							data-aos-delay={index * 50}
						>
							<div>
								<div class="flex items-start justify-between gap-4 mb-4">
									<h2 class="text-xl font-bold text-slate-900">{service.name}</h2>
									<span class="rounded-full bg-blue-50 px-3 py-1 text-sm font-bold text-blue-700 whitespace-nowrap border border-blue-100">
										{service.price > 0 ? `${service.price} €` : 'Sur devis'}
									</span>
								</div>
								<p class="text-slate-600 mb-6">{service.description}</p>
							</div>
							
							<div class="flex items-center justify-between border-t border-slate-100 pt-6">
								<div class="flex items-center gap-2 text-sm text-slate-500 font-medium">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
									~ {service.durationMinutes} min
								</div>
								<a
									href="/demo-standard/reservation"
									class="text-sm font-semibold text-blue-600 hover:text-blue-700 group-hover:underline flex items-center gap-1"
								>
									Réserver <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
								</a>
							</div>
						</div>
					))
				}
			</div>
			
			<div class="mt-16 bg-blue-50 border border-blue-100 rounded-2xl p-8 text-center" data-aos="fade-up">
				<h3 class="text-lg font-bold text-blue-900 mb-2">Une panne complexe ?</h3>
				<p class="text-blue-700 mb-6">Pour toute intervention hors forfait, un technicien réalise un diagnostic complet et vous propose un devis gratuit.</p>
				<a href="/demo-standard/contact" class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-6 py-3 text-sm font-bold text-white shadow hover:bg-blue-700 transition-colors">
					Demander un devis
				</a>
			</div>
		</div>
	</section>
</StandardLayout>
