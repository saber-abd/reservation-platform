---
import StandardLayout from '@/layouts/StandardLayout.astro';
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig(Astro.url.pathname);
import StandardReservationForm from '@/components/reservation/StandardReservationForm';
---

<StandardLayout title="Réservation" description={`Réservez votre intervention avec ${siteConfig.business.name}.`}>
	<section class="mx-auto max-w-3xl px-6 py-20 text-center">
		<h1 class="text-3xl font-black text-slate-900 md:text-5xl mb-4">Réserver une intervention</h1>
		<p class="text-lg text-slate-600">Choisissez la prestation dont vous avez besoin, sélectionnez un créneau disponible, et nous interviendrons chez vous.</p>

		<div class="mt-12 text-left">
			<div class="bg-white rounded-2xl border border-slate-200 shadow-xl p-6 md:p-10">
				<StandardReservationForm client:load />
			</div>
		</div>
	</section>
</StandardLayout>
