---
import StandardAuthShell from '@/components/standard/StandardAuthShell.astro';
import SignupForm from '@/components/standard/auth/StandardSignupForm';
---

<StandardAuthShell
	pageTitle="Inscription"
	title="Créer votre espace professionnel"
	description="Créer votre espace professionnel."
	lead="Configurez votre profil, vos prestations et vos disponibilités."
>
	<SignupForm basePath="/demo-standard" client:load />
	<p slot="after">
		Déjà un compte&nbsp;? <a href="/demo-standard/connexion" class="st-link st-link--on font-semibold text-brand">Se connecter</a>
	</p>
</StandardAuthShell>
