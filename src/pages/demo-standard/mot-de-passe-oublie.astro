---
import StandardAuthShell from '@/components/standard/StandardAuthShell.astro';
import ForgotPasswordForm from '@/components/standard/auth/StandardForgotPasswordForm';
---

<StandardAuthShell
	pageTitle="Mot de passe oublié"
	title="Mot de passe oublié"
	description="Réinitialisez votre mot de passe."
	lead="Renseignez votre email, nous vous enverrons un lien pour choisir un nouveau mot de passe."
>
	<ForgotPasswordForm basePath="/demo-standard" client:load />
	<p slot="after">
		<a href="/demo-standard/connexion" class="st-link st-link--on font-semibold text-brand">Retour à la connexion</a>
	</p>
</StandardAuthShell>
