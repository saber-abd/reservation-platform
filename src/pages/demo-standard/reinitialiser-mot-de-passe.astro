---
import StandardAuthShell from '@/components/standard/StandardAuthShell.astro';
import ResetPasswordForm from '@/components/standard/auth/StandardResetPasswordForm';
---

<StandardAuthShell
	pageTitle="Réinitialiser le mot de passe"
	title="Nouveau mot de passe"
	description="Choisissez un nouveau mot de passe."
	lead="Choisissez un nouveau mot de passe pour votre compte."
>
	<ResetPasswordForm basePath="/demo-standard" client:load />
	<p slot="after">
		<a href="/demo-standard/connexion" class="st-link st-link--on font-semibold text-brand">Retour à la connexion</a>
	</p>
</StandardAuthShell>
