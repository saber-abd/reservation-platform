---
import DashboardLayout from '@/layouts/standard/StandardDashboardLayout.astro';
import ClientNav from '@/components/standard/client/StandardClientNav';
import ClientProfilePanel from '@/components/standard/client/StandardClientProfilePanel';
import AccountPrivacyActions from '@/components/shared/AccountPrivacyActions';
---

<DashboardLayout title="Mon profil">
	<ClientNav slot="nav" basePath="/demo-standard" currentPath={Astro.url.pathname} client:load />
	<ClientProfilePanel client:load />
	<div class="sa-privacy">
		<AccountPrivacyActions basePath="/demo-standard" client:idle />
	</div>
</DashboardLayout>

