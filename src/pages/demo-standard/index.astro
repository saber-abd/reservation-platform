---
import StandardLayout from '@/layouts/standard/StandardLayout.astro';
import Map from '@/components/standard/StandardMap.astro';
import StandardCta from '@/components/standard/StandardCta.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);
const { business, services, testimonials } = siteConfig;

const formatDuration = (min: number) =>
	min < 60 ? `${min} min` : min % 60 === 0 ? `${min / 60} h` : `${Math.floor(min / 60)} h ${min % 60}`;

const diagnostic = services.find((s) => /diagnostic/i.test(s.name));

// Familles d'appareils pris en charge (texte d'habillage).
const domaines = [
	{
		title: 'Ordinateurs, PC et Mac',
		pannes: "Ne démarre plus, rame, écran noir, virus, disque plein. Remplacement du disque par un SSD, ajout de mémoire, réinstallation du système avec récupération des fichiers.",
	},
	{
		title: 'Smartphones et tablettes',
		pannes: "Écran fissuré, batterie qui tient une demi-journée, prise de charge qui ne tient plus le câble. La plupart des pièces se changent en une heure.",
	},
	{
		title: 'Télévisions, imprimantes, Wi-Fi',
		pannes: "Dalle rayée ou sans image, imprimante qui n'apparaît plus sur le réseau, box mal placée. Réglage sur place, chez vous, sur vos propres appareils.",
	},
];

const appareils = ['PC portable', 'PC fixe', 'Mac', 'Smartphone', 'Tablette', 'Téléviseur', 'Imprimante', 'Box et Wi-Fi', 'Disque dur', 'Écran'];

const etapes = [
	{
		title: 'Vous choisissez un créneau en ligne',
		text: "Le calendrier affiche les créneaux encore libres. Vous indiquez l'appareil et ce qui ne va pas, la confirmation arrive par email.",
	},
	{
		title: 'Diagnostic et devis, sur place',
		text: "Le technicien cherche la panne devant vous, chez vous ou à l'atelier. Il annonce le prix avant de toucher à quoi que ce soit : vous acceptez ou non.",
	},
	{
		title: 'Réparation, puis un an de garantie',
		text: "La pièce est changée, l'appareil testé avec vous. Si la même panne revient dans l'année, la reprise est à nos frais.",
	},
];

const [avisPrincipal, ...autresAvis] = testimonials;
const openDays = business.openingHours.filter((slot) => !/ferm/i.test(slot.hours));
---

<StandardLayout>
	<!-- Héros : titre à gauche, photo d'atelier à droite -->
	<section class="st-container pb-14 pt-10 md:pb-20 md:pt-16">
		<div class="grid grid-cols-1 items-start gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
			<div data-reveal-group>
				<p class="st-note mb-5 text-ink-soft">
					{business.activity} à domicile et en atelier, Paris 11<sup>e</sup>
				</p>
				<h1 class="st-h1">
					Ordinateur ou téléphone en panne&nbsp;? On vient le réparer <span class="st-accent">chez vous.</span>
				</h1>
				<p class="st-lead mt-6 max-w-[50ch]">
					{diagnostic && <>Diagnostic à <span class="st-num">{diagnostic.price}&nbsp;€</span>, prix</>}
					{!diagnostic && <>Prix</>} annoncé avant toute réparation, passage sous 24 à 48&nbsp;heures.
					Vous choisissez le créneau dans l'agenda, le technicien se déplace avec ses outils et ses pièces.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
					<a href="/demo-standard/reservation" class="st-btn">
						Réserver une intervention
						<svg class="st-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
					</a>
					<a href="/demo-standard/services" class="st-link st-link--on font-semibold text-ink">Voir les tarifs</a>
				</div>

				<dl class="st-facts mt-12">
					<div>
						<dt>Horaires</dt>
						<dd class="st-num">
							{openDays.map((slot, i) => (
								<>
									{i > 0 && <> <span class="st-sep" aria-hidden="true">/</span> </>}
									<span class="whitespace-nowrap">{slot.day.replace(' - ', ' – ')}&nbsp;: {slot.hours.replace(' - ', ' – ')}</span>
								</>
							))}
						</dd>
					</div>
					<div>
						<dt>Zone d'intervention</dt>
						<dd>Paris et 20&nbsp;km autour, déplacement offert</dd>
					</div>
					<div>
						<dt>Atelier</dt>
						<dd>{business.address}</dd>
					</div>
				</dl>
			</div>

			<figure class="lg:pt-2">
				<div class="st-frame aspect-[4/3] lg:aspect-[5/6]" data-reveal="fade" data-clip>
					<picture>
						<source
							type="image/avif"
							srcset="/images/standard/atelier-carte-mere-700.avif 700w, /images/standard/atelier-carte-mere-1100.avif 1100w, /images/standard/atelier-carte-mere-1600.avif 1600w"
							sizes="(min-width: 1024px) 42vw, 100vw"
						/>
						<img
							src="/images/standard/atelier-carte-mere-1100.webp"
							srcset="/images/standard/atelier-carte-mere-700.webp 700w, /images/standard/atelier-carte-mere-1100.webp 1100w, /images/standard/atelier-carte-mere-1600.webp 1600w"
							sizes="(min-width: 1024px) 42vw, 100vw"
							width="1600"
							height="1143"
							alt="Deux mains démontent au tournevis le radiateur d'une carte mère d'ordinateur"
							fetchpriority="high"
							decoding="async"
						/>
					</picture>
				</div>
				<figcaption class="st-caption">
					<span>À l'atelier : démontage d'un radiateur de carte mère.</span>
					<span class="st-num shrink-0">Fig. 1</span>
				</figcaption>
			</figure>
		</div>
	</section>

	<!-- Bandeau défilant : appareils pris en charge -->
	<div class="marquee st-marquee" aria-label="Appareils réparés">
		<div class="marquee-track">
			<ul>
				{appareils.map((a) => <li>{a}</li>)}
			</ul>
			<ul aria-hidden="true">
				{appareils.map((a) => <li>{a}</li>)}
			</ul>
		</div>
	</div>

	<!-- Repères chiffrés -->
	<section class="st-container pt-14 md:pt-20" aria-label="Repères">
		<dl class="st-figures" data-reveal-group>
			{diagnostic && (
				<div class="flex flex-col-reverse gap-2">
					<dt class="st-note">le diagnostic complet, en {formatDuration(diagnostic.durationMinutes)}</dt>
					<dd class="st-figure-value st-num"><span data-count={diagnostic.price}>{diagnostic.price}</span><small>€</small></dd>
				</div>
			)}
			<div class="flex flex-col-reverse gap-2">
				<dt class="st-note">de délai au plus avant le passage du technicien</dt>
				<dd class="st-figure-value st-num"><span data-count="48">48</span><small>h</small></dd>
			</div>
			<div class="flex flex-col-reverse gap-2">
				<dt class="st-note">autour de l'atelier sans frais de déplacement</dt>
				<dd class="st-figure-value st-num"><span data-count="20">20</span><small>km</small></dd>
			</div>
			<div class="flex flex-col-reverse gap-2">
				<dt class="st-note">de garantie sur les réparations matérielles</dt>
				<dd class="st-figure-value st-num"><span data-count="12">12</span><small>mois</small></dd>
			</div>
		</dl>
	</section>

	<!-- Ce qu'on répare -->
	<section class="st-container st-section">
		<div class="grid gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
			<div class="lg:sticky lg:top-24 lg:self-start">
				<h2 class="st-h2" data-reveal>Ce qu'on répare, et ce qui casse le plus souvent</h2>
				<figure class="mt-8 hidden lg:block">
					<div class="st-frame aspect-[3/2]" data-reveal="fade" data-clip>
						<picture>
							<source
								type="image/avif"
								srcset="/images/standard/reparation-smartphone-480.avif 480w, /images/standard/reparation-smartphone-800.avif 800w, /images/standard/reparation-smartphone-1280.avif 1280w"
								sizes="(min-width: 1024px) 34vw, 100vw"
							/>
							<img
								src="/images/standard/reparation-smartphone-800.webp"
								srcset="/images/standard/reparation-smartphone-480.webp 480w, /images/standard/reparation-smartphone-800.webp 800w, /images/standard/reparation-smartphone-1280.webp 1280w"
								sizes="(min-width: 1024px) 34vw, 100vw"
								width="1280"
								height="853"
								alt="Un smartphone ouvert sur un tapis de réparation, entouré de pinces et de petits outils"
								loading="lazy"
								decoding="async"
							/>
						</picture>
					</div>
					<figcaption class="st-caption">
						<span>Changement de batterie sur un smartphone.</span>
						<span class="st-num shrink-0">Fig. 2</span>
					</figcaption>
				</figure>
			</div>

			<div>
				<ol class="st-rows" data-reveal-group>
					{domaines.map((d, i) => (
						<li class="st-row st-row--two">
							<span class="st-row-index st-num" aria-hidden="true">0{i + 1}</span>
							<div>
								<h3 class="st-h3 md:text-2xl">{d.title}</h3>
								<p class="mt-2.5 max-w-[56ch] leading-relaxed text-ink-soft">{d.pannes}</p>
							</div>
						</li>
					))}
				</ol>
				<p class="mt-8 text-ink-soft" data-reveal>
					Votre appareil n'est pas dans la liste&nbsp;?{' '}
					<a href="/demo-standard/contact" class="st-link st-link--on font-semibold text-ink">Décrivez la panne</a>, la réponse arrive dans la journée.
				</p>
			</div>
		</div>
	</section>

	<!-- Carte des prix -->
	<section class="st-rule-top bg-surface">
		<div class="st-container st-section">
			<div class="grid gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
				<div data-reveal-group>
					<h2 class="st-h2">Les prix, avant de prendre rendez-vous</h2>
					<p class="st-lead mt-5 max-w-[42ch]">
						Les pannes courantes sont au forfait : diagnostic, main-d'œuvre et pièce compris.
						Pour le reste, un devis écrit est remis sur place et rien n'est facturé si vous le refusez.
					</p>
					<ul class="mt-8 max-w-md border-t border-rule">
						<li class="flex justify-between gap-4 border-b border-rule py-3"><span class="text-ink-soft">Déplacement jusqu'à 20&nbsp;km</span><span class="font-semibold">Offert</span></li>
						<li class="flex justify-between gap-4 border-b border-rule py-3"><span class="text-ink-soft">Devis sur place</span><span class="font-semibold">Gratuit</span></li>
						<li class="flex justify-between gap-4 border-b border-rule py-3"><span class="text-ink-soft">Garantie pièces et main-d'œuvre</span><span class="st-num font-semibold">1 an</span></li>
					</ul>
				</div>

				<div data-reveal>
					<div class="st-prices" role="table" aria-label="Tarifs des interventions les plus demandées">
						<div class="st-prices-head" role="row">
							<span role="columnheader">Intervention</span>
							<span role="columnheader">Durée</span>
							<span role="columnheader">Prix</span>
						</div>
						{services.slice(0, 5).map((service) => (
							<div class="st-price" role="row">
								<div class="st-price-main" role="cell">
									<p class="st-price-name">{service.name}</p>
									<p class="st-price-desc">{service.description}</p>
								</div>
								<p class="st-price-time st-num" role="cell">{formatDuration(service.durationMinutes)}</p>
								{service.price > 0
									? <p class="st-price-amount st-num" role="cell">{service.price}&nbsp;€</p>
									: <p class="st-price-amount" data-devis role="cell">Sur devis</p>}
							</div>
						))}
					</div>
					<div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
						<a href="/demo-standard/reservation" class="st-btn">
							Réserver à ce tarif
							<svg class="st-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
						</a>
						<a href="/demo-standard/services" class="st-link st-link--on font-semibold text-ink">
							Toute la grille (<span class="st-num">{services.length}</span> interventions)
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Comment ça se passe : liste numérotée, trait qui se remplit au défilement -->
	<section class="st-rule-top">
		<div class="st-container st-section">
			<div class="grid gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
				<div class="lg:sticky lg:top-24 lg:self-start" data-reveal>
					<h2 class="st-h2">Comment ça se passe, du clic à l'appareil réparé</h2>
					<p class="st-lead mt-5 max-w-[40ch]">Trois étapes, et vous savez le prix avant la deuxième.</p>
				</div>
				<ol class="st-steps">
					<li class="st-steps-line" aria-hidden="true" role="presentation"></li>
					{etapes.map((e, i) => (
						<li class="st-step" data-reveal>
							<span class="st-step-num st-num" data-n={i + 1} aria-hidden="true">{i + 1}</span>
							<h3 class="st-h3 md:text-[1.6rem]">{e.title}</h3>
							<p class="mt-3 max-w-[52ch] leading-relaxed text-ink-soft">{e.text}</p>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<!-- Avis -->
	<section class="st-rule-top bg-surface">
		<div class="st-container st-section">
			<h2 class="st-h2 max-w-[18ch]" data-reveal>Ce qu'en disent les clients dépannés</h2>
			{avisPrincipal && (
				<figure class="st-quote st-quote--lead mt-10" data-reveal>
					<blockquote class="max-w-[30ch] md:max-w-[34ch]">«&nbsp;{avisPrincipal.comment}&nbsp;»</blockquote>
					<figcaption class="flex items-center gap-4 text-sm">
						<span class="font-semibold text-ink">{avisPrincipal.name}</span>
						<span class="st-rating" role="img" aria-label={`Note : ${avisPrincipal.rating} sur 5`}>
							{[1, 2, 3, 4, 5].map((n) => <i data-on={n <= avisPrincipal.rating ? '' : undefined}></i>)}
						</span>
					</figcaption>
				</figure>
			)}
			<div class="grid gap-x-10 md:grid-cols-3" data-reveal-group>
				{autresAvis.map((avis) => (
					<figure class="st-quote">
						<blockquote>«&nbsp;{avis.comment}&nbsp;»</blockquote>
						<figcaption class="flex items-center gap-4 text-sm">
							<span class="font-semibold text-ink">{avis.name}</span>
							<span class="st-rating" role="img" aria-label={`Note : ${avis.rating} sur 5`}>
								{[1, 2, 3, 4, 5].map((n) => <i data-on={n <= avis.rating ? '' : undefined}></i>)}
							</span>
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</section>

	<!-- Où et quand -->
	<section class="st-rule-top">
		<div class="st-container st-section">
			<div class="grid gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
				<div data-reveal-group>
					<h2 class="st-h2">À domicile, ou déposé à l'atelier</h2>
					<p class="st-lead mt-5 max-w-[42ch]">
						Le technicien se déplace dans Paris et jusqu'à 20&nbsp;km autour. Vous pouvez aussi déposer l'appareil au {business.address}.
					</p>
					<dl class="st-num mt-8 max-w-md border-t border-ink">
						{business.openingHours.map((slot) => (
							<div class="flex justify-between gap-4 border-b border-rule py-3">
								<dt class="text-ink-soft">{slot.day}</dt>
								<dd class="font-semibold">{slot.hours}</dd>
							</div>
						))}
					</dl>
				</div>
				<div data-reveal>
					<Map lat={business.lat} lng={business.lng} label={business.name} class="aspect-[4/3] md:aspect-[16/9]" />
				</div>
			</div>
		</div>
	</section>

	<!-- Appel final -->
	<StandardCta />
</StandardLayout>
