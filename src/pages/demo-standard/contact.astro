---
import StandardLayout from '@/layouts/StandardLayout.astro';
import Map from '@/components/Map.astro';
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig(Astro.url.pathname);
---

<StandardLayout title="Contact" description={`Contactez ${siteConfig.business.name}.`}>
	<section class="mx-auto max-w-6xl px-6 py-20">
		<h1 class="text-3xl font-bold text-slate-900 md:text-4xl">Contact</h1>
		<p class="mt-3 max-w-2xl text-slate-500">
			Une question ? Contactez-nous, nous vous répondrons dans les meilleurs délais.
		</p>

		<div class="mt-10 grid gap-10 md:grid-cols-2">
			<div data-aos="fade-right">
				<div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm hover:shadow-md transition-shadow">
					<p class="font-bold text-slate-900 text-lg">Coordonnées</p>
					<ul class="mt-4 space-y-4 text-slate-600">
						<li class="flex items-center gap-3">
							<div class="p-2 bg-blue-50 text-blue-600 rounded-lg"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></div>
							{siteConfig.business.address}
						</li>
						<li class="flex items-center gap-3">
							<div class="p-2 bg-blue-50 text-blue-600 rounded-lg"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
							{siteConfig.business.phone}
						</li>
						<li class="flex items-center gap-3">
							<div class="p-2 bg-blue-50 text-blue-600 rounded-lg"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></div>
							{siteConfig.business.email}
						</li>
					</ul>
				</div>

				<div class="mt-6">
					<Map lat={siteConfig.business.lat} lng={siteConfig.business.lng} label={siteConfig.business.name} />
				</div>
			</div>

			<form
				id="contact-form"
				data-business-email={siteConfig.business.email}
				class="flex flex-col gap-5 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm"
				data-aos="fade-left"
			>
				<div>
					<label for="name" class="text-sm font-bold text-slate-900">Nom</label>
					<input
						id="name"
						name="name"
						type="text"
						required
						class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow"
					/>
				</div>
				<div>
					<label for="email" class="text-sm font-bold text-slate-900">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow"
					/>
				</div>
				<div>
					<label for="message" class="text-sm font-bold text-slate-900">Message</label>
					<textarea
						id="message"
						name="message"
						rows="4"
						required
						class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow"
					></textarea>
				</div>
				<p id="form-status" class="text-sm hidden"></p>
				<button
					id="submit-btn"
					type="submit"
					class="mt-2 rounded-xl bg-blue-600 px-4 py-3 text-sm font-bold text-white transition-colors hover:bg-blue-700 shadow-lg shadow-blue-600/20"
				>
					Envoyer
				</button>
			</form>
		</div>
	</section>
</StandardLayout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const status = document.getElementById('form-status');
	const btn = document.getElementById('submit-btn') as HTMLButtonElement;

	if (form && status && btn) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(form);
			const businessEmail = form.dataset.businessEmail;
			
			btn.disabled = true;
			btn.textContent = 'Envoi en cours...';
			status.classList.add('hidden');
			
			try {
				const userEmail = formData.get('email') as string;
				const userName = formData.get('name') as string;
				const userMessage = formData.get('message') as string;

				// EmailJS Configuration
				const serviceID = 'service_7pvm3br';
				const templateID = 'template_3j75n8o';
				const publicKey = '5Jjd71i9EWOeYyzsG';

				const templateParams = {
					from_name: userName,
					to_name: businessEmail || 'Professionnel',
					name: userName,
					email: userEmail,
					reply_to: userEmail,
					message: userMessage,
				};

				const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						service_id: serviceID,
						template_id: templateID,
						user_id: publicKey,
						template_params: templateParams,
					})
				});

				if (response.ok) {
					status.textContent = 'Message envoyé avec succès !';
					status.className = 'text-sm text-green-600';
					form.reset();
				} else {
					const errorText = await response.text();
					throw new Error(errorText || 'Erreur lors de l\'envoi');
				}
			} catch (err: any) {
				status.textContent = `Erreur lors de l'envoi : ${err.message}`;
				status.className = 'text-sm text-red-600';
			} finally {
				btn.disabled = false;
				btn.textContent = 'Envoyer';
				status.classList.remove('hidden');
			}
		});
	}
</script>
