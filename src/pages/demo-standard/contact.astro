---
import StandardLayout from '@/layouts/standard/StandardLayout.astro';
import StandardPageHeader from '@/components/standard/StandardPageHeader.astro';
import Map from '@/components/standard/StandardMap.astro';
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig(Astro.url.pathname);
const { business } = siteConfig;
const phoneHref = `tel:${business.phone.replace(/\s+/g, '')}`;
---

<StandardLayout title="Contact" description={`Contactez ${business.name} : téléphone, email, adresse de l'atelier.`}>
	<StandardPageHeader
		crumb="Contact"
		title="Écrire ou appeler l'atelier"
		lead="Décrivez l'appareil et ce qui ne va pas : la réponse arrive dans la journée ouvrée, avec une première estimation quand c'est possible. Pour une panne urgente, le téléphone reste le plus rapide."
	/>

	<section class="st-container st-section">
		<div class="grid items-start gap-x-14 gap-y-14 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
			<form
				id="contact-form"
				data-business-email={business.email}
				class="st-panel flex flex-col gap-5 p-6 md:p-9"
				data-reveal
			>
				<h2 class="st-h3 md:text-2xl">Votre message</h2>
				<div class="grid gap-5 sm:grid-cols-2">
					<div class="st-field">
						<label for="name">Nom</label>
						<input id="name" name="name" type="text" autocomplete="name" required class="st-input" />
					</div>
					<div class="st-field">
						<label for="email">Email</label>
						<input id="email" name="email" type="email" autocomplete="email" required class="st-input" />
					</div>
				</div>
				<div class="st-field">
					<label for="message">Message</label>
					<textarea
						id="message"
						name="message"
						rows="6"
						required
						placeholder="Ex. : PC portable de 2019, l'écran reste noir au démarrage mais le voyant s'allume."
						class="st-input resize-y"
					></textarea>
				</div>
				<p id="form-status" class="text-sm hidden" role="status"></p>
				<div class="flex flex-wrap items-center justify-between gap-4">
					<button id="submit-btn" type="submit" class="st-btn disabled:opacity-60">Envoyer le message</button>
					<p class="st-note">Vos coordonnées servent uniquement à vous répondre.</p>
				</div>
			</form>

			<div data-reveal data-reveal-delay="150">
				<dl class="st-kv st-num">
					<div>
						<dt>Téléphone</dt>
						<dd><a href={phoneHref} class="st-link">{business.phone}</a></dd>
					</div>
					<div>
						<dt>Email</dt>
						<dd><a href={`mailto:${business.email}`} class="st-link break-all">{business.email}</a></dd>
					</div>
					<div>
						<dt>Atelier</dt>
						<dd class="max-w-[22ch]">{business.address}</dd>
					</div>
					{business.openingHours.map((slot) => (
						<div>
							<dt>{slot.day}</dt>
							<dd>{slot.hours}</dd>
						</div>
					))}
				</dl>
				<div class="mt-8">
					<Map lat={business.lat} lng={business.lng} label={business.name} class="aspect-[4/3]" />
				</div>
			</div>
		</div>
	</section>
</StandardLayout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const status = document.getElementById('form-status');
	const btn = document.getElementById('submit-btn') as HTMLButtonElement;

	if (form && status && btn) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(form);
			const businessEmail = form.dataset.businessEmail;
			
			btn.disabled = true;
			btn.textContent = 'Envoi en cours…';
			status.classList.add('hidden');
			
			try {
				const userEmail = formData.get('email') as string;
				const userName = formData.get('name') as string;
				const userMessage = formData.get('message') as string;

				// EmailJS Configuration
				const serviceID = 'service_7pvm3br';
				const templateID = 'template_3j75n8o';
				const publicKey = '5Jjd71i9EWOeYyzsG';

				const templateParams = {
					from_name: userName,
					to_name: businessEmail || 'Professionnel',
					name: userName,
					email: userEmail,
					reply_to: userEmail,
					message: userMessage,
				};

				const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						service_id: serviceID,
						template_id: templateID,
						user_id: publicKey,
						template_params: templateParams,
					})
				});

				if (response.ok) {
					status.textContent = 'Message envoyé avec succès !';
					status.className = 'text-sm font-semibold text-brand';
					form.reset();
				} else {
					const errorText = await response.text();
					throw new Error(errorText || 'Erreur lors de l\'envoi');
				}
			} catch (err: any) {
				status.textContent = `Erreur lors de l'envoi : ${err.message}`;
				status.className = 'text-sm font-semibold text-signal';
			} finally {
				btn.disabled = false;
				btn.textContent = 'Envoyer le message';
				status.classList.remove('hidden');
			}
		});
	}
</script>
