---
import StandardLayout from '@/layouts/standard/StandardLayout.astro';
import StandardPageHeader from '@/components/standard/StandardPageHeader.astro';
import StandardCta from '@/components/standard/StandardCta.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);
const { business, about } = siteConfig;
---

<StandardLayout title="À propos" description={`L'atelier ${business.name}, ses engagements et les formations de son technicien.`}>
	<StandardPageHeader
		crumb="À propos"
		title="Un atelier dans le 11e, et la plupart des réparations chez vous"
		lead={`${business.name} répare ordinateurs, téléphones, tablettes, imprimantes et téléviseurs. Les interventions courantes se font à domicile ; les réparations longues partent à l'atelier, ${business.address}.`}
	/>

	<!-- Histoire -->
	<section class="st-container st-section">
		<div class="grid items-start gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
			<figure>
				<div class="st-frame aspect-[4/3]" data-reveal="fade" data-clip>
					<picture>
						<source
							type="image/avif"
							srcset="/images/standard/depannage-tour-pc-480.avif 480w, /images/standard/depannage-tour-pc-800.avif 800w, /images/standard/depannage-tour-pc-1280.avif 1280w"
							sizes="(min-width: 1024px) 40vw, 100vw"
						/>
						<img
							src="/images/standard/depannage-tour-pc-800.webp"
							srcset="/images/standard/depannage-tour-pc-480.webp 480w, /images/standard/depannage-tour-pc-800.webp 800w, /images/standard/depannage-tour-pc-1280.webp 1280w"
							sizes="(min-width: 1024px) 40vw, 100vw"
							width="1280"
							height="853"
							alt="Un technicien débranche une carte graphique dans une tour d'ordinateur ouverte"
							loading="lazy"
							decoding="async"
						/>
					</picture>
				</div>
				<figcaption class="st-caption">
					<span>Remplacement d'une carte graphique dans une tour.</span>
				</figcaption>
			</figure>

			<div data-reveal-group>
				<h2 class="st-h2">Pourquoi un dépanneur à domicile</h2>
				<p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-ink-soft">{about.story}</p>
				<blockquote class="mt-10 max-w-[34ch] border-l-2 border-brand pl-6 text-2xl font-[550] leading-snug tracking-[-0.02em] text-ink">
					On vous dit ce qui est cassé et ce que ça coûte. Ensuite, c'est vous qui décidez.
				</blockquote>
			</div>
		</div>
	</section>

	<!-- Engagements -->
	<section class="st-rule-top bg-surface">
		<div class="st-container st-section">
			<div class="grid gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
				<div class="lg:sticky lg:top-24 lg:self-start" data-reveal>
					<h2 class="st-h2 max-w-[14ch]">Ce sur quoi on s'engage</h2>
					<p class="st-lead mt-5 max-w-[38ch]">Trois règles appliquées à chaque intervention, écrites ici pour que vous puissiez nous les rappeler.</p>
				</div>
				<ol class="st-rows" data-reveal-group>
					{about.objectives.map((obj, i) => (
						<li class="st-row st-row--two">
							<span class="st-row-index st-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<div>
								<h3 class="st-h3 md:text-2xl">{obj.title}</h3>
								<p class="mt-2.5 max-w-[56ch] leading-relaxed text-ink-soft">{obj.description}</p>
							</div>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<!-- Formations -->
	<section class="st-rule-top">
		<div class="st-container st-section">
			<div class="grid gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
				<div data-reveal>
					<h2 class="st-h2 max-w-[14ch]">Formations et certifications</h2>
					<p class="st-lead mt-5 max-w-[38ch]">Le parcours du technicien qui se déplace chez vous.</p>
				</div>
				<ol class="st-rows" data-reveal-group>
					{about.diplomas.map((d) => (
						<li class="st-row st-row--year">
							<span class="st-num text-3xl font-semibold tracking-[-0.03em] text-brand md:text-4xl">{d.year}</span>
							<h3 class="st-h3">{d.title}</h3>
							<p class="text-ink-soft md:text-right">{d.institution}</p>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<StandardCta title="Un appareil à faire regarder ? Choisissez un créneau." />
</StandardLayout>
