---
import StandardAuthShell from '@/components/standard/StandardAuthShell.astro';
import LoginForm from '@/components/standard/auth/StandardLoginForm';
---

<StandardAuthShell
	pageTitle="Connexion"
	title="Connexion professionnel"
	description="Connexion à l'espace professionnel."
	lead="Accédez à vos prestations, à vos tarifs et aux informations de votre activité."
>
	<LoginForm basePath="/demo-standard" client:load />
	<p slot="after">
		Vous souhaitez prendre rendez-vous&nbsp;? Aucun compte n'est nécessaire&nbsp;: <a href="/demo-standard/reservation" class="st-link st-link--on font-semibold text-brand">réserver une intervention</a>.
	</p>
</StandardAuthShell>
