---
import StandardAuthShell from '@/components/standard/StandardAuthShell.astro';
import LoginForm from '@/components/standard/auth/StandardLoginForm';
---

<StandardAuthShell
	pageTitle="Connexion"
	title="Connexion professionnel"
	description="Connexion à l'espace professionnel."
	lead="Accédez à l'agenda, aux prestations et aux fiches clients."
>
	<LoginForm basePath="/demo-standard" client:load />
	<p slot="after">
		Pas encore de compte&nbsp;? <a href="/demo-standard/inscription" class="st-link st-link--on font-semibold text-brand">Créer un compte</a>
	</p>
</StandardAuthShell>
