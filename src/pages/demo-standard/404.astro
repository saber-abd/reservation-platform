---
import Layout from '@/layouts/Layout.astro';

Astro.response.status = 404;
---

<Layout title="Page introuvable" noindex>
	<section class="mx-auto flex max-w-xl flex-col items-center px-6 py-32 text-center">
		<p class="text-sm font-semibold uppercase tracking-widest text-rose-600">Erreur 404</p>
		<h1 class="mt-3 text-3xl font-bold text-stone-900 md:text-4xl">Page introuvable</h1>
		<p class="mt-4 text-stone-500">
			La page que vous cherchez n'existe pas ou a été déplacée.
		</p>
		<a
			href="/"
			class="mt-8 inline-block rounded-xl bg-rose-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-rose-700"
		>
			Retour à l'accueil
		</a>
	</section>
</Layout>
