---
import DiamantLayout from '@/layouts/DiamantLayout.astro';
import Diamant3DLogo from '@/components/diamant/Diamant3DLogo';
import Map from '@/components/Map.astro';
import ServicesCarousel from '@/components/ServicesCarousel';
import TestimonialsCarousel from '@/components/TestimonialsCarousel';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);
---

<DiamantLayout>
	<!-- Hero Section with 3D Logo -->
	<section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-stone-950">
		<!-- Background Elements -->
		<div class="absolute inset-0 z-0">
			<div class="absolute inset-0 bg-[url('/images/hero_salon.jpg')] bg-cover bg-center opacity-20 mix-blend-luminosity"></div>
			<div class="absolute inset-0 bg-gradient-to-b from-stone-950 via-stone-950/80 to-stone-950"></div>
			<div class="absolute right-0 top-1/4 w-1/2 h-1/2 bg-deep-teal-900/30 rounded-full blur-[100px] pointer-events-none transform-gpu will-change-transform"></div>
			<div class="absolute left-0 bottom-1/4 w-1/3 h-1/3 bg-jasmine-900/20 rounded-full blur-[80px] pointer-events-none transform-gpu will-change-transform"></div>
		</div>

		<div class="relative z-10 mx-auto max-w-7xl px-6 w-full grid md:grid-cols-2 gap-12 items-center">
			<!-- Text Content -->
			<div class="text-left" data-aos="fade-right">
				<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-stone-900/80 backdrop-blur-md border border-white/10 text-jasmine-400 font-semibold mb-8 uppercase tracking-widest text-xs">
					<span class="w-1.5 h-1.5 rounded-full bg-jasmine-400 animate-pulse"></span>
					{siteConfig.business.activity}
				</div>
				<h1 class="text-4xl md:text-4xl font-black text-white mb-6 tracking-tight leading-tight">
					L'Art de la <br />
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-jasmine-300 via-jasmine-500 to-jasmine-600">
						Coiffure
					</span>
				</h1>
				<p class="text-lg md:text-xl text-stone-400 mb-10 max-w-lg leading-relaxed">
					Une expérience sur-mesure dans un cadre d'exception. Confiez votre image à nos experts pour un résultat sublime.
				</p>
				<div class="flex flex-col sm:flex-row gap-6">
					<a
						href="/demo-diamant/reservation"
						class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-gradient-to-r from-jasmine-500 to-jasmine-600 text-stone-950 font-bold text-lg hover:from-jasmine-400 hover:to-jasmine-500 transition-all shadow-[0_0_30px_rgba(235,188,102,0.3)] hover:shadow-[0_0_40px_rgba(235,188,102,0.5)] transform hover:-translate-y-1"
					>
						Réserver un moment
					</a>
					<a
						href="#prestige"
						class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-white/5 backdrop-blur border border-white/10 text-white font-bold text-lg hover:bg-white/10 transition-colors"
					>
						Découvrir la Maison
					</a>
				</div>
			</div>

			<!-- 3D Logo Component -->
			<div class="h-[500px] md:h-[700px] relative w-full" data-aos="fade-left" data-aos-delay="200">
				<Diamant3DLogo client:load />
				
				<!-- Overlay text or badge -->
				<div class="absolute bottom-10 right-10 bg-stone-900/80 backdrop-blur-md border border-white/10 p-4 rounded-2xl shadow-2xl animate-bounce hidden md:block">
					<p class="text-jasmine-400 text-sm font-bold uppercase tracking-widest mb-1">Faites tourner</p>
					<p class="text-stone-400 text-xs">Interagissez avec le modèle 3D</p>
				</div>
			</div>
		</div>

		<!-- Scroll indicator -->
		<div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 animate-bounce pointer-events-none">
			<span class="text-xs text-white uppercase tracking-widest">Scroll</span>
			<div class="w-[1px] h-12 bg-gradient-to-b from-white to-transparent"></div>
		</div>
	</section>

	<!-- L'Expérience Prestige -->
	<section id="prestige" class="py-32 relative border-t border-white/5">
		<div class="mx-auto max-w-7xl px-6">
			<div class="grid items-center gap-16 md:grid-cols-2">
				<div class="relative group" data-aos="fade-right">
					<div class="absolute -inset-4 bg-gradient-to-r from-deep-teal-600 to-jasmine-600 rounded-2xl blur-xl opacity-20 group-hover:opacity-40 transition-opacity duration-500"></div>
					<div class="relative overflow-hidden rounded-2xl border border-white/10 bg-stone-900 aspect-[4/5]">
						<img src="/images/about_salon.jpg" alt="Ambiance luxueuse" class="h-full w-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-700" />
						<div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/20 to-transparent"></div>
					</div>
				</div>
				<div data-aos="fade-left">
					<h2 class="text-sm font-bold text-jasmine-400 uppercase tracking-widest mb-4">L'Expérience</h2>
					<h3 class="text-3xl md:text-4xl font-bold text-white mb-6 leading-tight">L'Excellence <br/>à chaque détail</h3>
					<p class="text-stone-400 text-lg leading-relaxed mb-8">
						{siteConfig.business.description} Plongez dans un univers de raffinement où nos artisans coiffeurs dédient leur savoir-faire à révéler votre beauté unique. 
					</p>
					
					<div class="space-y-6">
						<div class="flex items-start gap-4">
							<div class="w-12 h-12 rounded-full bg-deep-teal-900/50 border border-deep-teal-500/30 flex items-center justify-center shrink-0 text-jasmine-400">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
							</div>
							<div>
								<h4 class="text-white font-bold text-lg mb-1">Produits d'exception</h4>
								<p class="text-stone-500">Nous utilisons exclusivement les gammes les plus prestigieuses pour le soin de vos cheveux.</p>
							</div>
						</div>
						<div class="flex items-start gap-4">
							<div class="w-12 h-12 rounded-full bg-deep-teal-900/50 border border-deep-teal-500/30 flex items-center justify-center shrink-0 text-jasmine-400">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
							</div>
							<div>
								<h4 class="text-white font-bold text-lg mb-1">Service Prestige</h4>
								<p class="text-stone-500">Salon privé, boisson offerte et consultation sur-mesure avant chaque prestation.</p>
							</div>
						</div>
					</div>
					
					<a href="/demo-diamant/a-propos" class="inline-flex items-center gap-2 mt-10 text-jasmine-400 font-bold hover:text-jasmine-300 transition-colors uppercase tracking-wider text-sm">
						Découvrir notre histoire
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Aperçu services -->
	<section class="py-32 relative bg-stone-900 border-y border-white/5">
		<div class="mx-auto max-w-7xl px-6">
			<div class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6" data-aos="fade-up">
				<div>
					<h2 class="text-sm font-bold text-jasmine-400 uppercase tracking-widest mb-2">Prestations</h2>
					<h3 class="text-3xl md:text-4xl font-bold text-white">Nos services signatures</h3>
				</div>
				<a href="/demo-diamant/services" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/10 text-white hover:bg-white/5 transition-colors text-sm font-bold uppercase tracking-wider">
					Voir la carte complète
				</a>
			</div>
			
			<div class="[&>div>div]:!bg-stone-950 [&>div>div]:!border-white/10 [&>div>div>div>h3]:!text-white [&>div>div>div>p]:!text-stone-400 [&>div>div>div>div>span]:!text-jasmine-400 [&>div>div>div>div>a]:!bg-jasmine-500 [&>div>div>div>div>a]:!text-stone-950 [&_img]:!grayscale-0 [&_img]:hover:!grayscale-0">
				<!-- Nous utilisons le même composant mais injectons des classes CSS globales pour le forcer dans le thème sombre -->
				<ServicesCarousel client:load limit={6} />
			</div>
		</div>
	</section>

	<!-- Avis clients -->
	<section class="py-32 relative">
		<div class="mx-auto max-w-7xl px-6">
			<div class="text-center mb-16" data-aos="fade-up">
				<h2 class="text-sm font-bold text-jasmine-400 uppercase tracking-widest mb-2">Témoignages</h2>
				<h3 class="text-3xl md:text-4xl font-bold text-white">L'avis de notre clientèle</h3>
			</div>
			<div data-aos="fade-up" class="[&>div>div]:!bg-stone-900 [&>div>div]:!border-white/10 [&>div>div>p]:!text-stone-300 [&>div>div>div>div>h4]:!text-white">
				<TestimonialsCarousel client:load testimonials={siteConfig.testimonials} />
			</div>
		</div>
	</section>

	<!-- Où nous trouver -->
	<section class="py-32 relative bg-stone-900 border-t border-white/5">
		<div class="mx-auto max-w-7xl px-6">
			<div class="grid items-center gap-16 md:grid-cols-2">
				<div data-aos="fade-right">
					<h2 class="text-sm font-bold text-jasmine-400 uppercase tracking-widest mb-2">Accès</h2>
					<h3 class="text-3xl md:text-4xl font-bold text-white mb-6">Le Salon Prestige</h3>
					<p class="text-stone-400 text-lg mb-8 leading-relaxed">
						Venez vivre l'expérience dans notre écrin situé au cœur de la ville. Un espace conçu pour votre détente absolue.
					</p>
					
					<div class="space-y-6 mb-10">
						<div class="flex items-center gap-4 text-stone-300">
							<div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-jasmine-400">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
							</div>
							<span class="font-medium">{siteConfig.business.address}</span>
						</div>
						<div class="flex items-center gap-4 text-stone-300">
							<div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-jasmine-400">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
							</div>
							<span class="font-medium">{siteConfig.business.phone}</span>
						</div>
					</div>

					<a href="/demo-diamant/contact" class="inline-block text-sm font-bold uppercase tracking-widest text-jasmine-400 hover:text-jasmine-300 transition-colors border-b border-jasmine-400/30 hover:border-jasmine-300 pb-1">
						Voir tous les détails
					</a>
				</div>
				<div data-aos="fade-left" class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl h-[400px] transition-all duration-700">
					<Map lat={siteConfig.business.lat} lng={siteConfig.business.lng} label={siteConfig.business.name} />
				</div>
			</div>
		</div>
	</section>
</DiamantLayout>
