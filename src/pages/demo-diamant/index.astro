---
// Accueil Diamant. Sections : héros, bandeau des prestations, carte des prestations (colonne
// collante), le rendez-vous étape par étape (épinglé), avis (diagonale), accès.
// ScrollTrigger sur la page : parallaxe du héros, ligne active des prestations, épinglage des étapes,
// diagonale des avis, titres découpés (prestations, avis, accès) et nom du pied de page : 8 au total.
import DiamantLayout from '@/layouts/diamant/DiamantLayout.astro';
import DiamantHero from '@/components/diamant/DiamantHero.astro';
import DiamantBandeau from '@/components/diamant/DiamantBandeau.astro';
import DiamantPrestations from '@/components/diamant/DiamantPrestations.astro';
import DiamantEtapes from '@/components/diamant/DiamantEtapes.astro';
import DiamantTemoignages from '@/components/diamant/DiamantTemoignages.astro';
import DiamantAcces from '@/components/diamant/DiamantAcces.astro';
import { chargerPrestations } from '@/components/diamant/prestations';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);
const prestations = await chargerPrestations();
---

<DiamantLayout
	title="Salon de coiffure"
	description={`${siteConfig.business.name} : coupe, couleur, coiffage au ${siteConfig.business.address}. Tarifs affichés et réservation en ligne.`}
>
	<DiamantHero nbPrestations={prestations.length} />
	<DiamantBandeau mots={prestations.map((p) => p.nom)} />
	<DiamantPrestations prestations={prestations} limite={8} numero="01" />
	<DiamantEtapes numero="02" />
	<DiamantTemoignages avis={siteConfig.testimonials} numero="03" />
	<DiamantAcces numero="04" />
</DiamantLayout>
