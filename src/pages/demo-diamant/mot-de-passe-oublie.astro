---
import DiamantAuthShell from '@/components/diamant/DiamantAuthShell.astro';
import ForgotPasswordForm from '@/components/diamant/auth/DiamantForgotPasswordForm';
---

<DiamantAuthShell
	pageTitle="Mot de passe oublié"
	description="Recevoir un lien pour choisir un nouveau mot de passe."
	titre="Mot de passe oublié"
	lead="Indiquez l'adresse de votre compte : vous recevez un lien pour choisir un nouveau mot de passe."
>
	<ForgotPasswordForm basePath="/demo-diamant" client:load />
	<Fragment slot="after">
		<a href="/demo-diamant/connexion" class="dia-lien">Retour à la connexion</a>
	</Fragment>
</DiamantAuthShell>
