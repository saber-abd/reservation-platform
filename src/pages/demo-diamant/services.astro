---
import DiamantLayout from '@/layouts/DiamantLayout.astro';
import ServicesList from '@/components/ServicesList';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);
---

<DiamantLayout title="Prestations" description={`Découvrez les prestations proposées par ${siteConfig.business.name}.`}>
	<!-- Hero -->
	<section class="pt-28 pb-12 bg-[#fff7f1] border-b border-stone-100">
		<div class="mx-auto max-w-4xl px-6 text-center" data-aos="fade-up">
			<p class="text-sm font-bold text-deep-teal-500 uppercase tracking-widest mb-3">Nos Prestations</p>
			<h1 class="text-3xl md:text-4xl font-black text-stone-900 mb-4 tracking-tight">Services d'exception</h1>
			<p class="text-lg text-stone-500">
				Un aperçu de nos services. Contactez-nous pour toute demande sur-mesure.
			</p>
		</div>
	</section>

	<!-- Liste des services -->
	<section class="section-fade mx-auto max-w-6xl px-6 py-16" data-aos="fade-up" data-aos-delay="100">
		<ServicesList basePath="/demo-diamant" client:load />

		<!-- CTA -->
		<div class="section-fade mt-20 rounded-2xl bg-deep-teal-50 border border-deep-teal-100 p-10 text-center" data-aos="fade-up" data-aos-delay="150">
			<h2 class="text-2xl font-bold text-stone-900 mb-4">Une demande sur-mesure ?</h2>
			<p class="text-stone-600 text-lg mb-8">Privatisation du salon, événements spéciaux ou demandes particulières. Nous nous adaptons à vos exigences.</p>
			<a href="/demo-diamant/contact" class="inline-flex items-center justify-center px-8 py-3 rounded-full bg-deep-teal-500 text-white font-bold text-sm hover:bg-deep-teal-400 transition-colors uppercase tracking-widest">
				Nous contacter
			</a>
		</div>
	</section>
</DiamantLayout>
