---
// Prestations et tarifs : la carte complète en colonne collante (même composant que l'accueil,
// titre en h1), puis les informations pratiques et l'appel final.
import DiamantLayout from '@/layouts/diamant/DiamantLayout.astro';
import DiamantPrestations from '@/components/diamant/DiamantPrestations.astro';
import DiamantCta from '@/components/diamant/DiamantCta.astro';
import { chargerPrestations } from '@/components/diamant/prestations';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);
const prestations = await chargerPrestations();

const pratique = [
	{ titre: 'Le prix est annoncé avant de commencer', texte: 'Au diagnostic, on confirme la prestation et son prix. Un supplément (cheveux très longs, double application de couleur) n’est jamais ajouté sans votre accord.' },
	{ titre: 'Annulation gratuite jusqu’à 24 h avant', texte: 'Depuis votre espace client ou par téléphone. Passé ce délai, prévenez-nous dès que possible : le créneau peut encore servir.' },
	{ titre: 'Paiement au salon', texte: 'Carte bancaire, espèces ou paiement sans contact, après la prestation. Rien n’est prélevé à la réservation.' },
	{ titre: 'Première couleur : test de tolérance', texte: 'Pour une première coloration chez nous, un test est fait 48 h avant, lors d’un court passage au salon.' },
];
---

<DiamantLayout title="Prestations et tarifs" description={`Tarifs de ${siteConfig.business.name} : coupes, couleur, balayage, soins, coiffage. Durées et prix affichés.`}>
	<div class="pt-[calc(var(--dia-entete)+8px)]">
		<DiamantPrestations prestations={prestations} titreH1 avecLienCarte={false} numero="01" />
	</div>

	<section class="dia-section border-t border-[#d9cfc1]" aria-labelledby="pratique-titre">
		<div class="dia-wrap dia-grille">
			<div class="dia-col-g">
				<p class="dia-num"><b>02</b> Bon à savoir</p>
				<h2 id="pratique-titre" class="dia-h2 mt-6" data-split>Avant <em>de réserver.</em></h2>
			</div>
			<ol class="dia-liste dia-col-d" data-reveal-group>
				{pratique.map((p, i) => (
					<li>
						<span class="dia-liste__n">{String(i + 1).padStart(2, '0')}</span>
						<h3 class="dia-liste__titre">{p.titre}</h3>
						<p class="dia-liste__texte">{p.texte}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<DiamantCta />
</DiamantLayout>
