---
import DiamantLayout from '@/layouts/DiamantLayout.astro';
import ServicesList from '@/components/ServicesList';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);
---

<DiamantLayout title="Prestations" description={`Découvrez les prestations proposées par ${siteConfig.business.name}.`}>
	<!-- Header de la page -->
	<section class="relative pt-40 pb-20 overflow-hidden border-b border-white/5 bg-stone-950">
		<div class="absolute inset-0 z-0 opacity-30">
			<div class="absolute left-1/4 top-10 w-96 h-96 bg-deep-teal-900/40 rounded-full blur-[100px] pointer-events-none"></div>
		</div>
		<div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
			<h1 class="text-4xl md:text-5xl font-black text-white mb-6 tracking-tight">Nos Prestations</h1>
			<p class="text-xl text-stone-400">
				Un aperçu de nos services d'exception. Contactez-nous pour toute demande sur-mesure.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20 relative z-10">
		<div class="[&>div>div]:!bg-stone-900 [&>div>div]:!border-white/10 [&>div>div>div>h3]:!text-white [&>div>div>div>p]:!text-stone-400 [&>div>div>div>div>span]:!text-jasmine-400 [&>div>div>div>div>button]:!bg-jasmine-500 [&>div>div>div>div>button]:!text-stone-950 [&>div>div>div>div>a]:!bg-jasmine-500 [&>div>div>div>div>a]:!text-stone-950">
			<ServicesList client:load />
		</div>

		<div class="mt-24 rounded-2xl bg-gradient-to-br from-stone-900 to-stone-950 border border-white/10 p-12 text-center shadow-2xl relative overflow-hidden" data-aos="fade-up">
			<div class="absolute top-0 right-0 w-64 h-64 bg-jasmine-900/20 blur-[80px] pointer-events-none rounded-full"></div>
			
			<h2 class="text-2xl font-bold text-white mb-4 relative z-10">Une demande sur-mesure ?</h2>
			<p class="text-stone-400 text-lg mb-8 relative z-10">Privatisation du salon, événements spéciaux ou demandes particulières. Nous nous adaptons à vos exigences les plus élevées.</p>
			<a href="/demo-diamant/contact" class="relative z-10 inline-flex items-center justify-center px-8 py-3 rounded-full border border-jasmine-400/50 text-jasmine-400 font-bold hover:bg-jasmine-400/10 transition-colors uppercase tracking-widest text-sm">
				Nous contacter
			</a>
		</div>
	</section>
</DiamantLayout>
