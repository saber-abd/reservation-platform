---
// Le salon : en-tête avec la photo du salon, l'histoire (grand texte), trois photos du poste de
// travail, les engagements en liste numérotée, les diplômes en tableau, appel final.
import DiamantLayout from '@/layouts/diamant/DiamantLayout.astro';
import DiamantPageHead from '@/components/diamant/DiamantPageHead.astro';
import DiamantPicture from '@/components/diamant/DiamantPicture.astro';
import DiamantCta from '@/components/diamant/DiamantCta.astro';
import { images } from '@/components/diamant/images';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);
const { business, about } = siteConfig;
---

<DiamantLayout title="Le salon" description={`L'histoire de ${business.name}, l'équipe, ses engagements et ses diplômes.`}>
	<DiamantPageHead rubrique="Le salon" numero="01" image={images.salon}>
		<Fragment slot="titre">Un salon, <em>une équipe.</em></Fragment>
		{business.description}
	</DiamantPageHead>

	<section class="dia-section pt-0" aria-labelledby="histoire-titre">
		<div class="dia-wrap dia-grille">
			<div class="dia-col-g">
				<p class="dia-num"><b>02</b> Histoire</p>
				<h2 id="histoire-titre" class="sr-only">Notre histoire</h2>
			</div>
			<p class="dia-col-d font-heading text-[clamp(1.5rem,2.6vw,2.4rem)] leading-[1.25] tracking-[-0.02em] [font-weight:350]" data-reveal>
				{about.story}
			</p>
		</div>
	</section>

	<section class="dia-wrap pb-[clamp(80px,11vw,160px)]" aria-label="Le poste de travail">
		<div class="grid gap-4 sm:grid-cols-3" data-reveal-group>
			<figure>
				<div class="dia-cadre aspect-[3/4]"><DiamantPicture {...images.ciseaux} sizes="(min-width: 640px) 31vw, 92vw" /></div>
				<figcaption class="dia-legende">Les ciseaux, affûtés tous les deux mois.</figcaption>
			</figure>
			<figure class="sm:mt-16">
				<div class="dia-cadre aspect-[3/4]"><DiamantPicture {...images.peignes} sizes="(min-width: 640px) 31vw, 92vw" /></div>
				<figcaption class="dia-legende">Peignes et pinces, désinfectés entre chaque client.</figcaption>
			</figure>
			<figure>
				<div class="dia-cadre aspect-[3/4]"><DiamantPicture {...images.outils} sizes="(min-width: 640px) 31vw, 92vw" /></div>
				<figcaption class="dia-legende">Brosses rondes de trois diamètres pour le brushing.</figcaption>
			</figure>
		</div>
	</section>

	<section class="dia-section border-t border-[#d9cfc1]" aria-labelledby="engagements-titre">
		<div class="dia-wrap dia-grille">
			<div class="dia-col-g">
				<p class="dia-num"><b>03</b> Engagements</p>
				<h2 id="engagements-titre" class="dia-h2 mt-6" data-split>Ce qu'on <em>s'impose.</em></h2>
			</div>
			<ol class="dia-liste dia-col-d" data-reveal-group>
				{about.objectives.map((o, i) => (
					<li>
						<span class="dia-liste__n">{String(i + 1).padStart(2, '0')}</span>
						<h3 class="dia-liste__titre">{o.title}</h3>
						<p class="dia-liste__texte">{o.description}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="dia-section border-t border-[#d9cfc1]" aria-labelledby="diplomes-titre">
		<div class="dia-wrap dia-grille">
			<div class="dia-col-g">
				<p class="dia-num"><b>04</b> Formation</p>
				<h2 id="diplomes-titre" class="dia-h2 mt-6" data-split>Diplômes <em>et certifications.</em></h2>
			</div>
			<div class="dia-col-d overflow-x-auto" data-reveal>
				<table class="dia-tableau">
					<thead>
						<tr><th scope="col">Année</th><th scope="col">Diplôme</th><th scope="col">Organisme</th></tr>
					</thead>
					<tbody>
						{about.diplomas.map((d) => (
							<tr><td>{d.year}</td><td>{d.title}</td><td>{d.institution}</td></tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<DiamantCta />
</DiamantLayout>
