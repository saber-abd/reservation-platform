---
import DiamantDashboardLayout from '@/layouts/DiamantDashboardLayout.astro';
import DiamantClientNav from '@/components/diamant/dashboard/DiamantClientNav';
import { Send, Image as ImageIcon } from 'lucide-react';
---

<DiamantDashboardLayout title="Messagerie">
	<DiamantClientNav slot="sidebar" basePath="/demo-diamant" client:load />
	
	<div class="mb-8">
		<h1 class="text-3xl font-black text-white tracking-tight">Messagerie</h1>
		<p class="text-stone-400 mt-2">Échangez directement avec votre artisan coiffeur.</p>
	</div>

	<div class="rounded-2xl border border-white/10 bg-stone-900/50 shadow-xl overflow-hidden flex flex-col h-[600px]">
		<!-- En-tête -->
		<div class="p-6 border-b border-white/5 flex items-center gap-4 bg-stone-950/50 backdrop-blur-sm">
			<div class="w-12 h-12 rounded-full bg-gradient-to-br from-deep-teal-500 to-deep-teal-800 p-0.5">
				<img src="https://i.pravatar.cc/150?img=32" alt="Avatar" class="w-full h-full rounded-full object-cover border-2 border-stone-950" />
			</div>
			<div>
				<h2 class="text-white font-bold text-lg">Clara - Salon Prestige</h2>
				<p class="text-jasmine-400 text-xs font-bold uppercase tracking-widest flex items-center gap-2">
					<span class="w-2 h-2 rounded-full bg-jasmine-400 animate-pulse"></span>
					En ligne
				</p>
			</div>
		</div>

		<!-- Zone des messages -->
		<div class="flex-1 overflow-y-auto p-6 space-y-6">
			<!-- Message Reçu -->
			<div class="flex items-end gap-3 max-w-[80%]">
				<div class="w-8 h-8 rounded-full bg-stone-800 shrink-0 overflow-hidden">
					<img src="https://i.pravatar.cc/150?img=32" alt="Avatar" class="w-full h-full object-cover" />
				</div>
				<div class="bg-stone-800 border border-white/5 rounded-2xl rounded-bl-sm p-4">
					<p class="text-stone-300">Bonjour ! Nous avons bien noté votre demande pour un balayage plus clair. Avez-vous des photos d'inspiration pour que je puisse préparer la nuance parfaite ?</p>
					<span class="text-xs text-stone-500 mt-2 block">10:42</span>
				</div>
			</div>

			<!-- Message Envoyé -->
			<div class="flex items-end gap-3 max-w-[80%] ml-auto flex-row-reverse">
				<div class="w-8 h-8 rounded-full bg-gradient-to-br from-jasmine-500 to-jasmine-600 shrink-0 flex items-center justify-center text-stone-950 font-bold text-xs uppercase">
					V
				</div>
				<div class="bg-gradient-to-br from-jasmine-500/20 to-jasmine-600/10 border border-jasmine-500/30 rounded-2xl rounded-br-sm p-4">
					<p class="text-white">Bonjour Clara ! Oui tout à fait, je vous envoie ça tout de suite.</p>
					<span class="text-xs text-jasmine-400/70 mt-2 block text-right">11:15</span>
				</div>
			</div>

			<!-- Image Envoyée -->
			<div class="flex items-end gap-3 max-w-[80%] ml-auto flex-row-reverse">
				<div class="w-8 h-8 shrink-0"></div> <!-- Espacement -->
				<div class="bg-gradient-to-br from-jasmine-500/20 to-jasmine-600/10 border border-jasmine-500/30 rounded-2xl rounded-br-sm p-2">
					<img src="https://images.unsplash.com/photo-1519699047748-de8e457a634e?w=500&auto=format&fit=crop&q=60" alt="Inspiration" class="rounded-xl w-64 h-64 object-cover" />
					<span class="text-xs text-jasmine-400/70 mt-2 block text-right pr-2">11:16</span>
				</div>
			</div>
		</div>

		<!-- Zone de saisie -->
		<div class="p-4 border-t border-white/5 bg-stone-950/50 backdrop-blur-sm">
			<form class="flex gap-4">
				<button type="button" class="w-12 h-12 rounded-xl border border-white/10 bg-white/5 flex items-center justify-center text-stone-400 hover:text-white hover:bg-white/10 transition-colors shrink-0">
					<ImageIcon size={20} />
				</button>
				<input 
					type="text" 
					placeholder="Votre message..." 
					class="flex-1 bg-stone-900 border border-white/10 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-jasmine-400/50 focus:ring-1 focus:ring-jasmine-400/50 transition-all placeholder:text-stone-600"
				/>
				<button type="submit" class="px-6 rounded-xl bg-gradient-to-r from-jasmine-500 to-jasmine-600 text-stone-950 font-bold hover:from-jasmine-400 hover:to-jasmine-500 transition-colors shadow-[0_0_15px_rgba(235,188,102,0.3)] shrink-0 flex items-center gap-2">
					<span class="hidden sm:inline">Envoyer</span>
					<Send size={18} />
				</button>
			</form>
		</div>
	</div>
</DiamantDashboardLayout>
