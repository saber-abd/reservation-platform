---
import DiamantDashboardLayout from '@/layouts/diamant/DiamantDashboardLayout.astro';
import DiamantClientNav from '@/components/diamant/dashboard/DiamantClientNav';
import DiamantClientProfile from '@/components/diamant/dashboard/DiamantClientProfile';
import AccountPrivacyActions from '@/components/shared/AccountPrivacyActions';
import DiamantPageHead from '@/components/diamant/dashboard/kit/DiamantPageHead.astro';
---

<DiamantDashboardLayout title="Mon Profil">
	<DiamantClientNav slot="sidebar" basePath="/demo-diamant" client:load />

	<DiamantPageHead titre="Mon" accent="profil" sousTitre="Gérez vos informations personnelles et préférences : le salon les retrouve à chaque rendez-vous." />

	<DiamantClientProfile client:load />

	<div class="dx-donnees">
		<AccountPrivacyActions basePath="/demo-diamant" client:idle />
	</div>
</DiamantDashboardLayout>
