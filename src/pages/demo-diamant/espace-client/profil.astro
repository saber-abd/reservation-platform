---
import DiamantDashboardLayout from '@/layouts/DiamantDashboardLayout.astro';
import DiamantClientNav from '@/components/diamant/dashboard/DiamantClientNav';
import DiamantClientProfile from '@/components/diamant/dashboard/DiamantClientProfile';
---

<DiamantDashboardLayout title="Mon Profil">
	<DiamantClientNav slot="sidebar" basePath="/demo-diamant" client:load />
	
	<div class="mb-8">
		<h1 class="text-3xl font-black text-white tracking-tight">Mon Profil</h1>
		<p class="text-stone-400 mt-2">Gérez vos informations personnelles et préférences.</p>
	</div>

	<DiamantClientProfile client:load />

</DiamantDashboardLayout>
