---
import DiamantDashboardLayout from '@/layouts/DiamantDashboardLayout.astro';
import DiamantClientNav from '@/components/diamant/dashboard/DiamantClientNav';
import DiamantClientAppointments from '@/components/diamant/dashboard/DiamantClientAppointments';
import { Calendar as CalendarIcon, MapPin, Clock, Star } from 'lucide-react';
---

<DiamantDashboardLayout title="Mes Rendez-vous">
	<DiamantClientNav slot="sidebar" basePath="/demo-diamant" client:load />
	
	<div class="mb-8">
		<h1 class="text-3xl font-black text-stone-800 tracking-tight">Mes Rendez-vous</h1>
		<p class="text-stone-500 mt-2">Retrouvez l'historique de vos prestations et vos prochains rendez-vous.</p>
	</div>

	<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
		<div class="lg:col-span-2 space-y-6">
			<!-- Prochain RDV -->
			<DiamantClientAppointments client:load />

			<!-- Historique -->
			<div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
				<div class="flex items-center justify-between mb-6">
					<h2 class="text-xl font-bold text-stone-900 tracking-tight">Historique Récent</h2>
					<a href="/demo-diamant/espace-client/historique" class="text-xs font-bold text-deep-teal-600 hover:text-deep-teal-700 hover:underline">
						Voir tout l'historique &rarr;
					</a>
				</div>
				
				<div class="space-y-4">
					<div class="flex items-center justify-between p-4 rounded-xl border border-stone-100 bg-stone-50/50 hover:border-stone-200 transition-colors">
						<div class="flex items-center gap-4">
							<div class="w-12 h-12 rounded-full bg-stone-100 flex items-center justify-center text-stone-600">
								<CalendarIcon size={20} />
							</div>
							<div>
								<p class="text-stone-900 font-bold">Coupe & Brushing Prestige</p>
								<p class="text-stone-500 text-sm">Il y a 2 mois</p>
							</div>
						</div>
						<a href="/demo-diamant/reservation?service=Coupe%20%26%20Brushing%20Prestige" class="text-jasmine-600 text-sm font-bold uppercase tracking-widest hover:text-jasmine-700">
							Reprendre
						</a>
					</div>

					<div class="flex items-center justify-between p-4 rounded-xl border border-stone-100 bg-stone-50/50 hover:border-stone-200 transition-colors">
						<div class="flex items-center gap-4">
							<div class="w-12 h-12 rounded-full bg-stone-100 flex items-center justify-center text-stone-600">
								<CalendarIcon size={20} />
							</div>
							<div>
								<p class="text-stone-900 font-bold">Soin Profond Kératine</p>
								<p class="text-stone-500 text-sm">Il y a 5 mois</p>
							</div>
						</div>
						<a href="/demo-diamant/reservation?service=Soin%20Profond%20K%C3%A9ratine" class="text-jasmine-600 text-sm font-bold uppercase tracking-widest hover:text-jasmine-700">
							Reprendre
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- Action Rapide -->
		<div class="space-y-6">
			<a href="/demo-diamant/reservation" class="flex flex-col items-center justify-center p-8 rounded-2xl border border-jasmine-200 bg-gradient-to-b from-jasmine-50 to-white hover:bg-jasmine-100/50 transition-all text-center group shadow-sm">
				<div class="w-16 h-16 rounded-full bg-jasmine-100 flex items-center justify-center text-jasmine-600 mb-4 group-hover:scale-110 transition-transform">
					<CalendarIcon size={24} />
				</div>
				<h3 class="text-lg font-bold text-stone-900 mb-2">Nouveau Rendez-vous</h3>
				<p class="text-stone-500 text-sm">Réservez votre prochaine prestation</p>
			</a>
		</div>
	</div>
</DiamantDashboardLayout>
