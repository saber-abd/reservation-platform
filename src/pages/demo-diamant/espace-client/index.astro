---
import DiamantDashboardLayout from '@/layouts/DiamantDashboardLayout.astro';
import DiamantClientNav from '@/components/diamant/dashboard/DiamantClientNav';
import DiamantClientAppointments from '@/components/diamant/dashboard/DiamantClientAppointments';
import DiamantClientRecentHistory from '@/components/diamant/dashboard/DiamantClientRecentHistory';
import { Calendar as CalendarIcon, Sparkles } from 'lucide-react';
---

<DiamantDashboardLayout title="Mes Rendez-vous">
	<DiamantClientNav slot="sidebar" basePath="/demo-diamant" client:load />
	
	<div class="mb-8">
		<h1 class="text-3xl font-black text-stone-800 tracking-tight">Mes Rendez-vous</h1>
		<p class="text-stone-500 mt-2">Retrouvez vos prochains rendez-vous et l'historique complet de vos prestations passées.</p>
	</div>

	<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
		<!-- Colonne principale : Prochain RDV et Historique Récent avec espacement aéré -->
		<div class="lg:col-span-2 space-y-10">
			<!-- Section 1 : Prochain RDV à venir -->
			<div>
				<DiamantClientAppointments client:load />
			</div>

			<!-- Section 2 : Historique Récent synchronisé avec la base de données -->
			<div class="pt-2">
				<DiamantClientRecentHistory client:load />
			</div>
		</div>

		<!-- Colonne latérale : Action rapide de réservation -->
		<div class="space-y-6">
			<a 
				href="/demo-diamant/reservation" 
				class="flex flex-col items-center justify-center p-8 rounded-2xl border border-stone-200 bg-gradient-to-b from-stone-50 to-white hover:border-deep-teal-300 hover:shadow-md transition-all text-center group shadow-xs cursor-pointer"
			>
				<div class="w-16 h-16 rounded-2xl bg-deep-teal-50 border border-deep-teal-200 text-deep-teal-700 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform shadow-2xs">
					<CalendarIcon size={26} />
				</div>
				<h3 class="text-lg font-bold text-stone-900 mb-1">Nouveau Rendez-vous</h3>
				<p class="text-stone-500 text-xs leading-relaxed max-w-xs">
					Consultez le planning de l'établissement et réservez votre prochain soin en ligne.
				</p>
			</a>
		</div>
	</div>
</DiamantDashboardLayout>
