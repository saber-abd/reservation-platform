---
import DiamantDashboardLayout from '@/layouts/DiamantDashboardLayout.astro';
import DiamantClientNav from '@/components/diamant/dashboard/DiamantClientNav';
import { Calendar as CalendarIcon, MapPin, Clock, Star } from 'lucide-react';
---

<DiamantDashboardLayout title="Mes Rendez-vous">
	<DiamantClientNav slot="sidebar" basePath="/demo-diamant" client:load />
	
	<div class="mb-8">
		<h1 class="text-3xl font-black text-stone-800 tracking-tight">Mes Rendez-vous</h1>
		<p class="text-stone-500 mt-2">Retrouvez l'historique de vos prestations et vos prochains rendez-vous.</p>
	</div>

	<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
		<div class="lg:col-span-2 space-y-6">
			<!-- Prochain RDV -->
			<div class="rounded-2xl border border-jasmine-200 bg-gradient-to-br from-white to-stone-50/50 p-6 md:p-8 shadow-sm relative overflow-hidden group">
				<div class="absolute top-0 right-0 w-32 h-32 bg-jasmine-100/50 blur-[30px] group-hover:bg-jasmine-200/50 transition-colors"></div>
				
				<div class="flex items-center gap-3 mb-6">
					<div class="w-10 h-10 rounded-full bg-jasmine-100 text-jasmine-700 flex items-center justify-center border border-jasmine-200">
						<Star size={18} className="fill-current" />
					</div>
					<h2 class="text-xl font-bold text-stone-900 tracking-tight">Prochain rendez-vous</h2>
				</div>
				
				<div class="bg-stone-50 rounded-xl border border-stone-200/80 p-6 mb-6">
					<div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
						<div>
							<h3 class="text-2xl font-bold text-stone-900 mb-2">Balayage Signature & Soin</h3>
							<p class="text-jasmine-700 font-medium">Avec Clara, Maître Coloriste</p>
						</div>
						<div class="text-left md:text-right">
							<p class="text-3xl font-black text-stone-900">14h00</p>
							<p class="text-stone-500 uppercase tracking-widest text-sm font-bold">Jeudi 24 Octobre</p>
						</div>
					</div>
					
					<div class="mt-6 pt-6 border-t border-stone-200/80 flex flex-col sm:flex-row gap-4">
						<div class="flex items-center gap-2 text-stone-600 text-sm">
							<Clock size={16} className="text-jasmine-600" />
							Durée estimée : 2h30
						</div>
						<div class="flex items-center gap-2 text-stone-600 text-sm">
							<MapPin size={16} className="text-jasmine-600" />
							Salon Prestige, Paris 8ème
						</div>
					</div>
				</div>

				<div class="flex gap-4">
					<button class="px-6 py-3 rounded-xl bg-stone-900 text-white font-bold text-sm hover:bg-stone-800 transition-colors shadow-sm">
						Modifier
					</button>
					<button class="px-6 py-3 rounded-xl text-stone-500 font-bold text-sm hover:text-stone-900 transition-colors">
						Annuler
					</button>
				</div>
			</div>

			<!-- Historique -->
			<div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
				<h2 class="text-xl font-bold text-stone-900 mb-6 tracking-tight">Historique</h2>
				
				<div class="space-y-4">
					<div class="flex items-center justify-between p-4 rounded-xl border border-stone-100 bg-stone-50/50 hover:border-stone-200 transition-colors">
						<div class="flex items-center gap-4">
							<div class="w-12 h-12 rounded-full bg-stone-100 flex items-center justify-center text-stone-600">
								<CalendarIcon size={20} />
							</div>
							<div>
								<p class="text-stone-900 font-bold">Coupe & Brushing Prestige</p>
								<p class="text-stone-500 text-sm">Il y a 2 mois</p>
							</div>
						</div>
						<a href="/demo-diamant/reservation?service=Coupe%20%26%20Brushing%20Prestige" class="text-jasmine-600 text-sm font-bold uppercase tracking-widest hover:text-jasmine-700">
							Reprendre
						</a>
					</div>

					<div class="flex items-center justify-between p-4 rounded-xl border border-stone-100 bg-stone-50/50 hover:border-stone-200 transition-colors">
						<div class="flex items-center gap-4">
							<div class="w-12 h-12 rounded-full bg-stone-100 flex items-center justify-center text-stone-600">
								<CalendarIcon size={20} />
							</div>
							<div>
								<p class="text-stone-900 font-bold">Soin Profond Kératine</p>
								<p class="text-stone-500 text-sm">Il y a 5 mois</p>
							</div>
						</div>
						<a href="/demo-diamant/reservation?service=Soin%20Profond%20K%C3%A9ratine" class="text-jasmine-600 text-sm font-bold uppercase tracking-widest hover:text-jasmine-700">
							Reprendre
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- Action Rapide -->
		<div class="space-y-6">
			<a href="/demo-diamant/reservation" class="flex flex-col items-center justify-center p-8 rounded-2xl border border-jasmine-200 bg-gradient-to-b from-jasmine-50 to-white hover:bg-jasmine-100/50 transition-all text-center group shadow-sm">
				<div class="w-16 h-16 rounded-full bg-jasmine-100 flex items-center justify-center text-jasmine-600 mb-4 group-hover:scale-110 transition-transform">
					<CalendarIcon size={24} />
				</div>
				<h3 class="text-lg font-bold text-stone-900 mb-2">Nouveau Rendez-vous</h3>
				<p class="text-stone-500 text-sm">Réservez votre prochaine prestation</p>
			</a>
		</div>
	</div>
</DiamantDashboardLayout>
