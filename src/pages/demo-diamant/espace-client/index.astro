---
import DiamantDashboardLayout from '@/layouts/diamant/DiamantDashboardLayout.astro';
import DiamantClientNav from '@/components/diamant/dashboard/DiamantClientNav';
import DiamantClientAppointments from '@/components/diamant/dashboard/DiamantClientAppointments';
import DiamantClientRecentHistory from '@/components/diamant/dashboard/DiamantClientRecentHistory';
import DiamantPageHead from '@/components/diamant/dashboard/kit/DiamantPageHead.astro';
import { ArrowRight, Calendar as CalendarIcon } from 'lucide-react';
---

<DiamantDashboardLayout title="Mes Rendez-vous">
	<DiamantClientNav slot="sidebar" basePath="/demo-diamant" client:load />

	<DiamantPageHead titre="Mes" accent="rendez-vous" sousTitre="Retrouvez vos prochains rendez-vous et l'historique complet de vos prestations passées." />

	<div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
		<!-- Colonne principale : prochain RDV puis historique récent en frise -->
		<div class="flex flex-col gap-12 lg:col-span-2">
			<DiamantClientAppointments client:load />
			<DiamantClientRecentHistory client:load />
		</div>

		<!-- Colonne latérale : réservation -->
		<aside class="space-y-6">
			<a href="/demo-diamant/reservation" class="dx-carte group block overflow-hidden p-7">
				<span class="inline-grid h-12 w-12 place-items-center rounded-full bg-dx-terre-pale text-dx-terre">
					<CalendarIcon size={22} />
				</span>
				<h3 class="mt-6 font-heading text-[1.9rem] font-light leading-none tracking-[-0.03em] text-dx-encre">Nouveau <em class="text-dx-terre">rendez-vous</em></h3>
				<p class="mt-3 text-sm leading-relaxed text-dx-gris">
					Consultez le planning de l'établissement et réservez votre prochain soin en ligne.
				</p>
				<span class="dx-lien mt-6">Réserver un créneau <ArrowRight size={14} /></span>
			</a>
		</aside>
	</div>
</DiamantDashboardLayout>
