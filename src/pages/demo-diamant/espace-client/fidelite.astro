---
import DiamantDashboardLayout from '@/layouts/DiamantDashboardLayout.astro';
import DiamantClientNav from '@/components/diamant/dashboard/DiamantClientNav';
import { Star, Gift, Crown, ChevronRight } from 'lucide-react';
---

<DiamantDashboardLayout title="Avantages">
	<DiamantClientNav slot="sidebar" basePath="/demo-diamant" client:load />
	
	<div class="mb-8">
		<h1 class="text-3xl font-black text-stone-800 tracking-tight">Avantages</h1>
		<p class="text-stone-500 mt-2">Votre fidélité récompensée par des privilèges exclusifs.</p>
	</div>

	<!-- Status Card -->
	<div class="rounded-2xl border border-jasmine-200 bg-gradient-to-br from-white to-stone-50/50 p-8 shadow-sm relative overflow-hidden mb-8">
		<div class="absolute top-0 right-0 w-64 h-64 bg-jasmine-100/50 blur-[80px] pointer-events-none rounded-full"></div>
		
		<div class="flex flex-col md:flex-row md:items-center justify-between gap-8 relative z-10">
			<div class="flex items-center gap-6">
				<div class="w-20 h-20 rounded-full border border-jasmine-200 bg-white p-1 shadow-sm">
					<div class="w-full h-full rounded-full bg-jasmine-50 flex items-center justify-center">
						<Crown size={32} className="text-jasmine-600" />
					</div>
				</div>
				<div>
					<p class="text-stone-400 font-bold uppercase tracking-widest text-sm mb-1">Statut Actuel</p>
					<h2 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-jasmine-500 to-jasmine-700">Diamant</h2>
					<p class="text-jasmine-700 mt-2 text-sm font-medium">Membre depuis 2024</p>
				</div>
			</div>
			
			<div class="text-left md:text-right bg-stone-50/80 p-6 rounded-xl border border-stone-100 backdrop-blur-sm">
				<p class="text-stone-500 text-sm font-bold uppercase tracking-widest mb-2">Points Privilèges</p>
				<p class="text-4xl font-black text-stone-900 flex items-center gap-2 font-coolvetica">
					2 450 <Star size={24} className="text-jasmine-500 fill-current" />
				</p>
				<p class="text-stone-400 text-xs mt-2 font-coolvetica">Prochain palier : 3 000 pts</p>
			</div>
		</div>
	</div>

	<h2 class="text-xl font-bold text-stone-900 tracking-tight mb-6 mt-12">Vos Privilèges Débloqués</h2>
	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		<div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm flex gap-4 transition-colors group">
			<div class="w-12 h-12 rounded-full bg-jasmine-100 text-jasmine-600 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
				<Gift size={24} />
			</div>
			<div>
				<h3 class="text-lg font-bold text-stone-900 mb-2">Soin Profond Offert</h3>
				<p class="text-stone-500 text-sm leading-relaxed">Pour votre prochain rendez-vous coupe, profitez de notre soin signature enrichi en huiles rares.</p>
			</div>
		</div>

		<div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm flex gap-4 transition-colors group">
			<div class="w-12 h-12 rounded-full bg-jasmine-100 text-jasmine-600 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
				<Star size={24} />
			</div>
			<div>
				<h3 class="text-lg font-bold text-stone-900 mb-2 font-coolvetica">-20% Gamme Prestige</h3>
				<p class="text-stone-500 text-sm leading-relaxed">Valable sur l'ensemble de notre gamme de produits d'entretien à domicile.</p>
			</div>
		</div>
	</div>
</DiamantDashboardLayout>
