---
import DiamantDashboardLayout from '@/layouts/DiamantDashboardLayout.astro';
import DiamantClientNav from '@/components/diamant/dashboard/DiamantClientNav';
import { Star, Gift, Crown, ChevronRight } from 'lucide-react';
---

<DiamantDashboardLayout title="Avantages VIP">
	<DiamantClientNav slot="sidebar" basePath="/demo-diamant" client:load />
	
	<div class="mb-8">
		<h1 class="text-3xl font-black text-white tracking-tight">Avantages VIP</h1>
		<p class="text-stone-400 mt-2">Votre fidélité récompensée par des privilèges exclusifs.</p>
	</div>

	<!-- Status Card -->
	<div class="rounded-2xl border border-jasmine-400/50 bg-gradient-to-br from-stone-900 to-stone-950 p-8 shadow-[0_0_50px_rgba(235,188,102,0.1)] relative overflow-hidden mb-8">
		<div class="absolute top-0 right-0 w-64 h-64 bg-jasmine-900/20 blur-[80px] pointer-events-none rounded-full"></div>
		
		<div class="flex flex-col md:flex-row md:items-center justify-between gap-8 relative z-10">
			<div class="flex items-center gap-6">
				<div class="w-20 h-20 rounded-full bg-gradient-to-br from-jasmine-400 to-jasmine-600 p-1 shadow-[0_0_30px_rgba(235,188,102,0.3)]">
					<div class="w-full h-full rounded-full bg-stone-950 flex items-center justify-center">
						<Crown size={32} className="text-jasmine-400" />
					</div>
				</div>
				<div>
					<p class="text-stone-400 font-bold uppercase tracking-widest text-sm mb-1">Statut Actuel</p>
					<h2 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-jasmine-300 to-jasmine-600">Diamant</h2>
					<p class="text-jasmine-400 mt-2 text-sm font-medium">Membre depuis 2024</p>
				</div>
			</div>
			
			<div class="text-left md:text-right bg-stone-950/50 p-6 rounded-xl border border-white/10 backdrop-blur-sm">
				<p class="text-stone-400 text-sm font-bold uppercase tracking-widest mb-2">Points Privilèges</p>
				<p class="text-4xl font-black text-white flex items-center gap-2">
					2 450 <Star size={24} className="text-jasmine-400 fill-current" />
				</p>
				<p class="text-stone-500 text-xs mt-2">Prochain palier : 3 000 pts</p>
			</div>
		</div>
	</div>

	<h2 class="text-xl font-bold text-white tracking-tight mb-6 mt-12">Vos Privilèges Débloqués</h2>
	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		<div class="rounded-2xl border border-white/10 bg-stone-900/50 p-6 shadow-xl flex gap-4 hover:bg-stone-900 transition-colors cursor-pointer group">
			<div class="w-12 h-12 rounded-full bg-jasmine-500/10 text-jasmine-400 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
				<Gift size={24} />
			</div>
			<div>
				<h3 class="text-lg font-bold text-white mb-2">Soin Profond Offert</h3>
				<p class="text-stone-400 text-sm leading-relaxed mb-4">Pour votre prochain rendez-vous coupe, profitez de notre soin signature enrichi en huiles rares.</p>
				<span class="text-xs font-bold uppercase tracking-widest text-jasmine-400 flex items-center gap-1 group-hover:text-jasmine-300">
					Utiliser <ChevronRight size={14} />
				</span>
			</div>
		</div>

		<div class="rounded-2xl border border-white/10 bg-stone-900/50 p-6 shadow-xl flex gap-4 hover:bg-stone-900 transition-colors cursor-pointer group">
			<div class="w-12 h-12 rounded-full bg-jasmine-500/10 text-jasmine-400 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
				<Star size={24} />
			</div>
			<div>
				<h3 class="text-lg font-bold text-white mb-2">-20% Gamme Prestige</h3>
				<p class="text-stone-400 text-sm leading-relaxed mb-4">Valable sur l'ensemble de notre gamme de produits d'entretien à domicile.</p>
				<span class="text-xs font-bold uppercase tracking-widest text-jasmine-400 flex items-center gap-1 group-hover:text-jasmine-300">
					Utiliser <ChevronRight size={14} />
				</span>
			</div>
		</div>
	</div>
</DiamantDashboardLayout>
