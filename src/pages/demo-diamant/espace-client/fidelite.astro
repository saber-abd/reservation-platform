---
import DiamantDashboardLayout from '@/layouts/DiamantDashboardLayout.astro';
import DiamantClientNav from '@/components/diamant/dashboard/DiamantClientNav';
import DiamantClientFidelite from '@/components/diamant/dashboard/DiamantClientFidelite';
---

<DiamantDashboardLayout title="Fidélité & Privilèges">
	<DiamantClientNav slot="sidebar" basePath="/demo-diamant" client:load />
	
	<div class="mb-8">
		<h1 class="text-3xl font-black text-stone-800 tracking-tight">Fidélité & Privilèges</h1>
		<p class="text-stone-500 mt-2">Votre fidélité récompensée par des privilèges exclusifs au fil de vos visites.</p>
	</div>

	<DiamantClientFidelite client:load />
</DiamantDashboardLayout>
