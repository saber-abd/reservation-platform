---
import DiamantLayout from '@/layouts/DiamantLayout.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname);
---

<DiamantLayout title="Mentions Légales" description="Mentions légales de la plateforme.">
	<section class="relative pt-40 pb-20 overflow-hidden border-b border-white/5 bg-stone-950">
		<div class="absolute inset-0 z-0 opacity-30">
			<div class="absolute right-1/4 top-10 w-96 h-96 bg-jasmine-900/30 rounded-full blur-[100px] pointer-events-none"></div>
		</div>
		<div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
			<h1 class="text-4xl font-black text-white mb-6 tracking-tight">Mentions Légales</h1>
		</div>
	</section>

	<section class="mx-auto max-w-4xl px-6 py-20 relative z-10">
		<div class="rounded-2xl border border-white/10 bg-stone-900/50 p-8 md:p-12 shadow-2xl">
			<div class="space-y-8 text-stone-400 leading-relaxed">
				<div>
					<h2 class="text-xl font-bold text-white mb-3">Éditeur du site</h2>
					<p>Nom : {siteConfig.business.name}</p>
					<p>Adresse : {siteConfig.business.address}</p>
					<p>Téléphone : {siteConfig.business.phone}</p>
					<p>Email : {siteConfig.business.email}</p>
				</div>
				<div>
					<h2 class="text-xl font-bold text-white mb-3">Hébergement</h2>
					<p>Le site est hébergé par un prestataire professionnel garantissant un haut niveau de sécurité et de disponibilité.</p>
				</div>
				<div>
					<h2 class="text-xl font-bold text-white mb-3">Propriété Intellectuelle</h2>
					<p>L'ensemble de ce site relève des législations française et internationale sur le droit d'auteur et la propriété intellectuelle. Tous les droits de reproduction sont réservés.</p>
				</div>
			</div>
		</div>
	</section>
</DiamantLayout>
