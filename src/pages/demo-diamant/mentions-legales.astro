---
import DiamantLegalPage from '@/components/diamant/DiamantLegalPage.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);
const { business } = siteConfig;
---

<DiamantLegalPage
	pageTitle="Mentions légales"
	description={`Mentions légales du site de ${business.name}.`}
	titre="Mentions légales"
	lead="Qui édite ce site, où il est hébergé, et à qui écrire."
>
	<section>
		<h2>Éditeur du site</h2>
		<div>
			<p><strong>Nom :</strong> {business.name}</p>
			<p><strong>Adresse :</strong> {business.address}</p>
			<p><strong>Téléphone :</strong> {business.phone}</p>
			<p><strong>Email :</strong> {business.email}</p>
		</div>
	</section>
	<section>
		<h2>Hébergement</h2>
		<p>Le site est hébergé par un prestataire professionnel qui en assure la disponibilité et la sécurité.</p>
	</section>
	<section>
		<h2>Propriété intellectuelle</h2>
		<p>Les textes, photos et éléments graphiques de ce site relèvent du droit d'auteur. Toute reproduction demande l'accord préalable de l'éditeur.</p>
	</section>
</DiamantLegalPage>
