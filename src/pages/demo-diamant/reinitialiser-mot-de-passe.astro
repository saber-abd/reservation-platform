---
import DiamantAuthShell from '@/components/diamant/DiamantAuthShell.astro';
import ResetPasswordForm from '@/components/diamant/auth/DiamantResetPasswordForm';
---

<DiamantAuthShell
	pageTitle="Nouveau mot de passe"
	description="Choisir un nouveau mot de passe."
	titre="Nouveau mot de passe"
	lead="Choisissez un mot de passe d'au moins six caractères, que vous n'utilisez pas ailleurs."
>
	<ResetPasswordForm basePath="/demo-diamant" client:load />
	<Fragment slot="after">
		<a href="/demo-diamant/connexion" class="dia-lien">Retour à la connexion</a>
	</Fragment>
</DiamantAuthShell>
