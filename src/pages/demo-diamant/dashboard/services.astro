---
import DiamantDashboardLayout from '@/layouts/diamant/DiamantDashboardLayout.astro';
import DiamantDashboardNav from '@/components/diamant/dashboard/DiamantDashboardNav';
import ServicesPanel from '@/components/diamant/dashboard/DiamantServicesPanel';
import DiamantAdminOnlyGuard from '@/components/diamant/dashboard/DiamantAdminOnlyGuard';
import DiamantPageHead from '@/components/diamant/dashboard/kit/DiamantPageHead.astro';
---

<DiamantDashboardLayout title="Gestion des prestations">
	<DiamantDashboardNav slot="sidebar" basePath="/demo-diamant" client:load />

	<DiamantAdminOnlyGuard client:load pageName="Gestion des prestations & Tarifs">
		<DiamantPageHead titre="Prestations" accent="& tarifs" sousTitre="Gérez vos prestations et forfaits : ce que la carte du site affiche, avec la durée réservée dans l'agenda et le prix." />

		<ServicesPanel client:load />
	</DiamantAdminOnlyGuard>
</DiamantDashboardLayout>
