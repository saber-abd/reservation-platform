---
import DiamantDashboardLayout from '@/layouts/DiamantDashboardLayout.astro';
import DiamantDashboardNav from '@/components/diamant/dashboard/DiamantDashboardNav';
import DiamantRightsPanel from '@/components/diamant/dashboard/DiamantRightsPanel';
import DiamantAdminOnlyGuard from '@/components/diamant/dashboard/DiamantAdminOnlyGuard';
---

<DiamantDashboardLayout title="Gestion des Droits & Équipe">
	<DiamantDashboardNav slot="sidebar" basePath="/demo-diamant" client:load />
	
	<DiamantAdminOnlyGuard client:load pageName="Gestion des Droits & Sécurité">
		<div class="mb-8">
			<h1 class="text-3xl font-black text-stone-900 tracking-tight">Gestion des Droits & Équipe</h1>
			<p class="text-stone-500 mt-1">Gérez les comptes employés, la modération des clients et les règles d'accès.</p>
		</div>

		<div class="rounded-2xl border border-stone-200 bg-white p-6 md:p-8 shadow-sm">
			<DiamantRightsPanel client:load />
		</div>
	</DiamantAdminOnlyGuard>
</DiamantDashboardLayout>
