---
import DiamantDashboardLayout from '@/layouts/DiamantDashboardLayout.astro';
import DiamantDashboardNav from '@/components/diamant/dashboard/DiamantDashboardNav';
import DiamantRevenueChart from '@/components/diamant/dashboard/DiamantRevenueChart';
import { ArrowUpRight, Users, Calendar, TrendingUp } from 'lucide-react';
---

<DiamantDashboardLayout title="Tableau de Bord VIP">
	<DiamantDashboardNav slot="sidebar" basePath="/demo-diamant" client:load />
	
	<div class="mb-8">
		<h1 class="text-3xl font-black text-white tracking-tight">Vue d'ensemble</h1>
		<p class="text-stone-400 mt-2">Bienvenue dans votre espace de gestion Prestige.</p>
	</div>

	<!-- KPIs -->
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
		<div class="rounded-2xl border border-white/10 bg-stone-900/50 p-6 shadow-xl relative overflow-hidden group">
			<div class="absolute top-0 right-0 w-24 h-24 bg-jasmine-900/10 rounded-full blur-[20px] group-hover:bg-jasmine-900/30 transition-colors"></div>
			<div class="flex items-center justify-between mb-4">
				<div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-jasmine-400">
					<TrendingUp size={20} />
				</div>
				<span class="text-xs font-bold text-green-400 bg-green-400/10 px-2 py-1 rounded-full border border-green-400/20 flex items-center gap-1">
					<ArrowUpRight size={12} /> +12.5%
				</span>
			</div>
			<p class="text-stone-400 text-sm font-bold uppercase tracking-widest mb-1">Chiffre d'Affaires</p>
			<p class="text-3xl font-black text-white">82 450 €</p>
		</div>

		<div class="rounded-2xl border border-white/10 bg-stone-900/50 p-6 shadow-xl relative overflow-hidden group">
			<div class="absolute top-0 right-0 w-24 h-24 bg-deep-teal-900/10 rounded-full blur-[20px] group-hover:bg-deep-teal-900/30 transition-colors"></div>
			<div class="flex items-center justify-between mb-4">
				<div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-jasmine-400">
					<Calendar size={20} />
				</div>
				<span class="text-xs font-bold text-green-400 bg-green-400/10 px-2 py-1 rounded-full border border-green-400/20 flex items-center gap-1">
					<ArrowUpRight size={12} /> +5.2%
				</span>
			</div>
			<p class="text-stone-400 text-sm font-bold uppercase tracking-widest mb-1">RDV ce mois</p>
			<p class="text-3xl font-black text-white">210</p>
		</div>

		<div class="rounded-2xl border border-white/10 bg-stone-900/50 p-6 shadow-xl relative overflow-hidden group">
			<div class="absolute top-0 right-0 w-24 h-24 bg-deep-teal-900/10 rounded-full blur-[20px] group-hover:bg-deep-teal-900/30 transition-colors"></div>
			<div class="flex items-center justify-between mb-4">
				<div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-jasmine-400">
					<Users size={20} />
				</div>
				<span class="text-xs font-bold text-green-400 bg-green-400/10 px-2 py-1 rounded-full border border-green-400/20 flex items-center gap-1">
					<ArrowUpRight size={12} /> +18
				</span>
			</div>
			<p class="text-stone-400 text-sm font-bold uppercase tracking-widest mb-1">Nouveaux VIP</p>
			<p class="text-3xl font-black text-white">45</p>
		</div>

		<div class="rounded-2xl border border-white/10 bg-stone-900/50 p-6 shadow-xl relative overflow-hidden group">
			<div class="absolute top-0 right-0 w-24 h-24 bg-jasmine-900/10 rounded-full blur-[20px] group-hover:bg-jasmine-900/30 transition-colors"></div>
			<div class="flex items-center justify-between mb-4">
				<div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-jasmine-400">
					<span class="font-black text-lg">€</span>
				</div>
			</div>
			<p class="text-stone-400 text-sm font-bold uppercase tracking-widest mb-1">Panier Moyen</p>
			<p class="text-3xl font-black text-white">392 €</p>
		</div>
	</div>

	<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
		<!-- Chart -->
		<div class="lg:col-span-2 rounded-2xl border border-white/10 bg-stone-900/50 p-6 shadow-xl">
			<div class="flex items-center justify-between mb-6">
				<h2 class="text-lg font-bold text-white">Évolution du CA (2026)</h2>
				<button class="text-xs font-bold uppercase tracking-widest text-jasmine-400 hover:text-jasmine-300">Rapport complet</button>
			</div>
			<DiamantRevenueChart client:load />
		</div>

		<!-- Prochains RDV VIP -->
		<div class="rounded-2xl border border-white/10 bg-stone-900/50 p-6 shadow-xl">
			<h2 class="text-lg font-bold text-white mb-6">Prochains RDV VIP</h2>
			
			<div class="space-y-4">
				<div class="flex items-center gap-4 p-4 rounded-xl border border-white/5 bg-white/5 hover:border-jasmine-400/30 transition-colors">
					<div class="w-12 h-12 rounded-full bg-stone-800 border border-white/10 overflow-hidden shrink-0">
						<img src="https://i.pravatar.cc/150?img=32" alt="Avatar" class="w-full h-full object-cover" />
					</div>
					<div class="flex-1">
						<p class="text-white font-bold">Éléonore D.</p>
						<p class="text-stone-400 text-sm">Balayage Signature</p>
					</div>
					<div class="text-right">
						<p class="text-jasmine-400 font-bold">14:00</p>
						<p class="text-stone-500 text-xs">Aujourd'hui</p>
					</div>
				</div>

				<div class="flex items-center gap-4 p-4 rounded-xl border border-white/5 bg-white/5 hover:border-jasmine-400/30 transition-colors">
					<div class="w-12 h-12 rounded-full bg-stone-800 border border-white/10 overflow-hidden shrink-0">
						<img src="https://i.pravatar.cc/150?img=11" alt="Avatar" class="w-full h-full object-cover" />
					</div>
					<div class="flex-1">
						<p class="text-white font-bold">Arthur V.</p>
						<p class="text-stone-400 text-sm">Coupe & Barbe Soin</p>
					</div>
					<div class="text-right">
						<p class="text-jasmine-400 font-bold">16:30</p>
						<p class="text-stone-500 text-xs">Aujourd'hui</p>
					</div>
				</div>

				<div class="flex items-center gap-4 p-4 rounded-xl border border-white/5 bg-white/5 hover:border-jasmine-400/30 transition-colors">
					<div class="w-12 h-12 rounded-full bg-stone-800 border border-white/10 overflow-hidden shrink-0">
						<img src="https://i.pravatar.cc/150?img=47" alt="Avatar" class="w-full h-full object-cover" />
					</div>
					<div class="flex-1">
						<p class="text-white font-bold">Juliette B.</p>
						<p class="text-stone-400 text-sm">Coloration Végétale</p>
					</div>
					<div class="text-right">
						<p class="text-jasmine-400 font-bold">09:00</p>
						<p class="text-stone-500 text-xs">Demain</p>
					</div>
				</div>
			</div>
			
			<a href="/demo-diamant/dashboard/disponibilites" class="block w-full text-center mt-6 text-sm font-bold uppercase tracking-widest text-stone-400 hover:text-jasmine-400 transition-colors">
				Voir l'agenda complet
			</a>
		</div>
	</div>
</DiamantDashboardLayout>
