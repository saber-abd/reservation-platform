---
import DiamantDashboardLayout from '@/layouts/DiamantDashboardLayout.astro';
import DiamantDashboardNav from '@/components/diamant/dashboard/DiamantDashboardNav';
import DiamantRevenueChart from '@/components/diamant/dashboard/DiamantRevenueChart';
import { ArrowUpRight, Users, Calendar, TrendingUp } from 'lucide-react';
---

<DiamantDashboardLayout title="Tableau de Bord">
	<DiamantDashboardNav slot="sidebar" basePath="/demo-diamant" client:load />
	
	<div class="mb-8">
		<h1 class="text-3xl font-black text-stone-900 tracking-tight">Vue d'ensemble</h1>
		<p class="text-stone-500 mt-1">Bienvenue dans votre espace de gestion Prestige.</p>
	</div>

	<!-- KPIs -->
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
		<div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm" data-searchable="Chiffre d'Affaires">
			<div class="flex items-center justify-between mb-3">
				<div class="w-9 h-9 rounded-xl bg-deep-teal-50 border border-deep-teal-100 flex items-center justify-center text-deep-teal-500">
					<TrendingUp size={18} />
				</div>
				<span class="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded-full border border-green-100 flex items-center gap-1">
					<ArrowUpRight size={11} /> +12.5%
				</span>
			</div>
			<p class="text-stone-400 text-xs font-bold uppercase tracking-widest mb-1">Chiffre d'Affaires</p>
			<p class="text-2xl font-black text-stone-900">82 450 €</p>
		</div>

		<div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm" data-searchable="RDV ce mois">
			<div class="flex items-center justify-between mb-3">
				<div class="w-9 h-9 rounded-xl bg-jasmine-50 border border-jasmine-100 flex items-center justify-center text-jasmine-500">
					<Calendar size={18} />
				</div>
				<span class="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded-full border border-green-100 flex items-center gap-1">
					<ArrowUpRight size={11} /> +5.2%
				</span>
			</div>
			<p class="text-stone-400 text-xs font-bold uppercase tracking-widest mb-1">RDV ce mois</p>
			<p class="text-2xl font-black text-stone-900">210</p>
		</div>

		<div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm" data-searchable="Nouveaux Clients">
			<div class="flex items-center justify-between mb-3">
				<div class="w-9 h-9 rounded-xl bg-deep-teal-50 border border-deep-teal-100 flex items-center justify-center text-deep-teal-500">
					<Users size={18} />
				</div>
				<span class="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded-full border border-green-100 flex items-center gap-1">
					<ArrowUpRight size={11} /> +18
				</span>
			</div>
			<p class="text-stone-400 text-xs font-bold uppercase tracking-widest mb-1">Nouveaux Clients</p>
			<p class="text-2xl font-black text-stone-900">45</p>
		</div>

		<div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm" data-searchable="Panier Moyen">
			<div class="flex items-center justify-between mb-3">
				<div class="w-9 h-9 rounded-xl bg-jasmine-50 border border-jasmine-100 flex items-center justify-center text-jasmine-500">
					<span class="font-black text-base">€</span>
				</div>
			</div>
			<p class="text-stone-400 text-xs font-bold uppercase tracking-widest mb-1">Panier Moyen</p>
			<p class="text-2xl font-black text-stone-900">392 €</p>
		</div>
	</div>

	<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
		<!-- Chart -->
		<div class="lg:col-span-2 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
			<div class="flex items-center justify-between mb-5">
				<h2 class="text-base font-bold text-stone-900">Évolution du CA (2026)</h2>
				<button class="text-xs font-bold uppercase tracking-widest text-deep-teal-500 hover:text-deep-teal-400">Rapport complet</button>
			</div>
			<DiamantRevenueChart client:load />
		</div>

		<!-- Prochains RDV -->
		<div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
			<h2 class="text-base font-bold text-stone-900 mb-5">Prochains RDV</h2>
			
			<div class="space-y-3">
				<div class="flex items-center gap-3 p-3 rounded-xl border border-stone-100 bg-stone-50 hover:border-deep-teal-200 transition-colors" data-searchable="Éléonore D. Balayage Signature">
					<div class="w-10 h-10 rounded-full bg-stone-200 border border-stone-300 overflow-hidden shrink-0">
						<img src="https://i.pravatar.cc/150?img=32" alt="Avatar" class="w-full h-full object-cover" />
					</div>
					<div class="flex-1 min-w-0">
						<p class="text-stone-900 font-bold text-sm truncate">Éléonore D.</p>
						<p class="text-stone-500 text-xs truncate">Balayage Signature</p>
					</div>
					<div class="text-right shrink-0">
						<p class="text-deep-teal-600 font-bold text-sm">14:00</p>
						<p class="text-stone-400 text-xs">Aujourd'hui</p>
					</div>
				</div>

				<div class="flex items-center gap-3 p-3 rounded-xl border border-stone-100 bg-stone-50 hover:border-deep-teal-200 transition-colors" data-searchable="Arthur V. Coupe Barbe Soin">
					<div class="w-10 h-10 rounded-full bg-stone-200 border border-stone-300 overflow-hidden shrink-0">
						<img src="https://i.pravatar.cc/150?img=11" alt="Avatar" class="w-full h-full object-cover" />
					</div>
					<div class="flex-1 min-w-0">
						<p class="text-stone-900 font-bold text-sm truncate">Arthur V.</p>
						<p class="text-stone-500 text-xs truncate">Coupe & Barbe Soin</p>
					</div>
					<div class="text-right shrink-0">
						<p class="text-deep-teal-600 font-bold text-sm">16:30</p>
						<p class="text-stone-400 text-xs">Aujourd'hui</p>
					</div>
				</div>

				<div class="flex items-center gap-3 p-3 rounded-xl border border-stone-100 bg-stone-50 hover:border-deep-teal-200 transition-colors" data-searchable="Juliette B. Coloration Végétale">
					<div class="w-10 h-10 rounded-full bg-stone-200 border border-stone-300 overflow-hidden shrink-0">
						<img src="https://i.pravatar.cc/150?img=47" alt="Avatar" class="w-full h-full object-cover" />
					</div>
					<div class="flex-1 min-w-0">
						<p class="text-stone-900 font-bold text-sm truncate">Juliette B.</p>
						<p class="text-stone-500 text-xs truncate">Coloration Végétale</p>
					</div>
					<div class="text-right shrink-0">
						<p class="text-deep-teal-600 font-bold text-sm">09:00</p>
						<p class="text-stone-400 text-xs">Demain</p>
					</div>
				</div>
			</div>
			
			<a href="/demo-diamant/dashboard/disponibilites" class="block w-full text-center mt-5 text-xs font-bold uppercase tracking-widest text-stone-400 hover:text-deep-teal-500 transition-colors pt-4 border-t border-stone-100">
				Voir l'agenda complet →
			</a>
		</div>
	</div>
</DiamantDashboardLayout>
