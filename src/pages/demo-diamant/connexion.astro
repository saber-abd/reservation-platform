---
import DiamantAuthShell from '@/components/diamant/DiamantAuthShell.astro';
import LoginForm from '@/components/diamant/auth/DiamantLoginForm';
---

<DiamantAuthShell
	pageTitle="Connexion"
	description="Connexion à l'espace client et à l'espace professionnel du salon."
	titre="Connexion"
	lead="Clients et professionnels utilisent le même formulaire : vous êtes dirigé vers votre espace."
>
	<LoginForm basePath="/demo-diamant" client:load />
	<Fragment slot="after">
		Pas encore de compte ? <a href="/demo-diamant/inscription" class="dia-lien ml-1">Créer un compte</a>
	</Fragment>
	<p slot="visite" class="dia-visite">
		<svg class="mt-1 h-4 w-4 shrink-0 text-[#a84b25]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.5" /><path d="M8 7v4M8 4.8v.2" /></svg>
		<span>
			<b>Visiter l'espace professionnel</b>
			Le bouton « Accéder à la démo (lecture seule) » ouvre le tableau de bord du salon avec un compte
			de démonstration : tout se consulte, rien n'est enregistré.
		</span>
	</p>
</DiamantAuthShell>
