---
import Layout from '@/layouts/Layout.astro';
import Map from '@/components/Map.astro';
import { getSiteConfig } from '@/config/site';
const siteConfig = await getSiteConfig();
---

<Layout title="Contact" description={`Contactez ${siteConfig.business.name}.`}>
	<section class="mx-auto max-w-6xl px-6 py-20">
		<h1 class="text-3xl font-bold text-stone-900 md:text-4xl">Contact</h1>
		<p class="mt-3 max-w-2xl text-stone-500">
			Une question ? Contactez-nous, nous vous répondrons dans les meilleurs délais.
		</p>

		<div class="mt-10 grid gap-10 md:grid-cols-2">
			<div data-aos="fade-right">
				<div class="rounded-xl border border-border bg-white p-6 shadow-sm">
					<p class="font-semibold text-stone-900">Coordonnées</p>
					<ul class="mt-4 space-y-2 text-sm text-stone-500">
						<li>{siteConfig.business.address}</li>
						<li>{siteConfig.business.phone}</li>
						<li>{siteConfig.business.email}</li>
					</ul>
				</div>

				<div class="mt-6">
					<Map lat={siteConfig.business.lat} lng={siteConfig.business.lng} label={siteConfig.business.name} />
				</div>
			</div>

			<form
				id="contact-form"
				data-business-email={siteConfig.business.email}
				class="flex flex-col gap-4 rounded-xl border border-border bg-white p-6 shadow-sm"
				data-aos="fade-left"
			>
				<div>
					<label for="name" class="text-sm font-medium text-stone-900">Nom</label>
					<input
						id="name"
						name="name"
						type="text"
						required
						class="mt-1 w-full rounded-lg border border-border bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-rose-600"
					/>
				</div>
				<div>
					<label for="email" class="text-sm font-medium text-stone-900">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						class="mt-1 w-full rounded-lg border border-border bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-rose-600"
					/>
				</div>
				<div>
					<label for="message" class="text-sm font-medium text-stone-900">Message</label>
					<textarea
						id="message"
						name="message"
						rows="4"
						required
						class="mt-1 w-full rounded-lg border border-border bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-rose-600"
					></textarea>
				</div>
				<p id="form-status" class="text-sm hidden"></p>
				<button
					id="submit-btn"
					type="submit"
					class="rounded-xl bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-rose-700"
				>
					Envoyer
				</button>
			</form>
		</div>
	</section>
</Layout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const status = document.getElementById('form-status');
	const btn = document.getElementById('submit-btn') as HTMLButtonElement;

	if (form && status && btn) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(form);
			const businessEmail = form.dataset.businessEmail;
			
			btn.disabled = true;
			btn.textContent = 'Envoi en cours...';
			status.classList.add('hidden');
			
			try {
				const userEmail = formData.get('email') as string;
				const userName = formData.get('name') as string;
				const userMessage = formData.get('message') as string;

				// EmailJS Configuration
				const serviceID = 'service_7pvm3br';
				const templateID = 'template_3j75n8o';
				const publicKey = '5Jjd71i9EWOeYyzsG';

				const templateParams = {
					from_name: userName,
					to_name: businessEmail || 'Professionnel',
					name: userName,
					email: userEmail,
					reply_to: userEmail,
					message: userMessage,
				};

				const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						service_id: serviceID,
						template_id: templateID,
						user_id: publicKey,
						template_params: templateParams,
					})
				});

				if (response.ok) {
					status.textContent = 'Message envoyé avec succès !';
					status.className = 'text-sm text-green-600';
					form.reset();
				} else {
					const errorText = await response.text();
					throw new Error(errorText || 'Erreur lors de l\'envoi');
				}
			} catch (err: any) {
				status.textContent = `Erreur lors de l'envoi : ${err.message}`;
				status.className = 'text-sm text-red-600';
			} finally {
				btn.disabled = false;
				btn.textContent = 'Envoyer';
				status.classList.remove('hidden');
			}
		});
	}
</script>
