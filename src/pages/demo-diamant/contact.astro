---
import DiamantLayout from '@/layouts/DiamantLayout.astro';
import Map from '@/components/Map.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);
---

<DiamantLayout title="Contact" description={`Contactez ${siteConfig.business.name}.`}>
	<!-- Hero -->
	<section class="pt-28 pb-12 bg-[#fff7f1] border-b border-stone-100">
		<div class="mx-auto max-w-4xl px-6 text-center" data-aos="fade-up">
			<p class="text-sm font-bold text-deep-teal-500 uppercase tracking-widest mb-3">Contact</p>
			<h1 class="text-3xl md:text-4xl font-black text-stone-900 mb-4 tracking-tight">Prendre Contact</h1>
			<p class="text-lg text-stone-500">
				Une question, une demande particulière ? Notre équipe est à votre entière disposition.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-16">
		<div class="grid gap-12 md:grid-cols-2">
			<!-- Coordonnées + Carte -->
			<div class="section-fade space-y-6" data-aos="fade-right" data-aos-duration="800">
				<div class="rounded-2xl border border-stone-200 bg-white p-7 shadow-sm card-hover">
					<p class="font-bold text-deep-teal-600 uppercase tracking-widest text-xs mb-5">Coordonnées</p>
					<ul class="space-y-5 text-stone-700">
						<li class="flex items-start gap-4">
							<div class="w-10 h-10 rounded-xl bg-deep-teal-50 flex items-center justify-center shrink-0 text-deep-teal-500">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
							</div>
							<span class="mt-2 font-medium">{siteConfig.business.address}</span>
						</li>
						<li class="flex items-center gap-4">
							<div class="w-10 h-10 rounded-xl bg-deep-teal-50 flex items-center justify-center shrink-0 text-deep-teal-500">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
							</div>
							<span class="font-medium font-coolvetica text-lg tracking-wider">{siteConfig.business.phone}</span>
						</li>
						<li class="flex items-center gap-4">
							<div class="w-10 h-10 rounded-xl bg-deep-teal-50 flex items-center justify-center shrink-0 text-deep-teal-500">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
							</div>
							<span class="font-medium">{siteConfig.business.email}</span>
						</li>
					</ul>
				</div>

				<div class="rounded-2xl overflow-hidden border border-stone-200 shadow-sm h-[280px] z-0 relative isolate" data-aos="zoom-in" data-aos-delay="200">
					<Map lat={siteConfig.business.lat} lng={siteConfig.business.lng} label={siteConfig.business.name} class="w-full h-full" />
				</div>
			</div>

			<!-- Formulaire de contact -->
			<form
				id="contact-form"
				data-business-email={siteConfig.business.email}
				class="section-fade flex flex-col gap-5 rounded-2xl border border-stone-200 bg-white p-7 shadow-sm"
				data-aos="fade-left"
				data-aos-duration="800"
			>
				<div>
					<label for="name" class="text-xs font-bold text-stone-500 uppercase tracking-widest">Nom complet</label>
					<input
						id="name"
						name="name"
						type="text"
						required
						class="mt-2 w-full rounded-xl border border-stone-300 bg-stone-50 px-4 py-3 text-stone-900 focus:outline-none focus:ring-2 focus:ring-deep-teal-200 focus:border-deep-teal-400 transition-colors"
					/>
				</div>
				<div>
					<label for="email" class="text-xs font-bold text-stone-500 uppercase tracking-widest">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						class="mt-2 w-full rounded-xl border border-stone-300 bg-stone-50 px-4 py-3 text-stone-900 focus:outline-none focus:ring-2 focus:ring-deep-teal-200 focus:border-deep-teal-400 transition-colors"
					/>
				</div>
				<div>
					<label for="message" class="text-xs font-bold text-stone-500 uppercase tracking-widest">Message</label>
					<textarea
						id="message"
						name="message"
						rows="5"
						required
						class="mt-2 w-full rounded-xl border border-stone-300 bg-stone-50 px-4 py-3 text-stone-900 focus:outline-none focus:ring-2 focus:ring-deep-teal-200 focus:border-deep-teal-400 transition-colors resize-none"
					></textarea>
				</div>
				<p id="form-status" class="text-sm hidden"></p>
				<button
					id="submit-btn"
					type="submit"
					class="mt-2 rounded-xl bg-deep-teal-500 px-6 py-4 text-sm font-bold text-white transition-colors hover:bg-deep-teal-400 uppercase tracking-widest shadow-sm"
				>
					Envoyer la demande
				</button>
			</form>
		</div>
	</section>
</DiamantLayout>

<script is:inline>
	const form = document.getElementById('contact-form');
	const status = document.getElementById('form-status');
	const btn = document.getElementById('submit-btn');

	if (form && status && btn) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(form);
			const businessEmail = form.dataset.businessEmail;
			
			btn.disabled = true;
			btn.textContent = 'Envoi en cours...';
			status.classList.add('hidden');
			
			try {
				const userEmail = formData.get('email');
				const userName = formData.get('name');
				const userMessage = formData.get('message');

				const serviceID = 'service_7pvm3br';
				const templateID = 'template_3j75n8o';
				const publicKey = '5Jjd71i9EWOeYyzsG';

				const templateParams = {
					from_name: userName,
					to_name: businessEmail || 'Professionnel',
					name: userName,
					email: userEmail,
					reply_to: userEmail,
					message: userMessage,
				};

				const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						service_id: serviceID,
						template_id: templateID,
						user_id: publicKey,
						template_params: templateParams,
					})
				});

				if (response.ok) {
					status.textContent = 'Message envoyé avec succès !';
					status.className = 'text-sm text-green-600';
					form.reset();
				} else {
					const errorText = await response.text();
					throw new Error(errorText || "Erreur lors de l'envoi");
				}
			} catch (err) {
				status.textContent = `Erreur lors de l'envoi : ${err.message}`;
				status.className = 'text-sm text-red-500';
			} finally {
				btn.disabled = false;
				btn.textContent = 'Envoyer la demande';
				status.classList.remove('hidden');
			}
		});
	}
</script>
