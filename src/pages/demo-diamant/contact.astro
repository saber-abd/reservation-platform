---
// Contact : en-tête, coordonnées et horaires à gauche, formulaire (EmailJS) à droite, carte en dessous.
import DiamantLayout from '@/layouts/diamant/DiamantLayout.astro';
import DiamantPageHead from '@/components/diamant/DiamantPageHead.astro';
import Map from '@/components/diamant/DiamantMap.astro';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);
const { business } = siteConfig;
const tel = business.phone.replace(/[^\d+]/g, '');
---

<DiamantLayout title="Contact" description={`Contacter ${business.name} : adresse, téléphone, horaires et formulaire.`}>
	<DiamantPageHead rubrique="Contact" numero="01">
		<Fragment slot="titre">Une question <em>avant de venir&nbsp;?</em></Fragment>
		Pour un conseil couleur, une demande de mariage ou un groupe, écrivez-nous : réponse sous 24 h
		ouvrées. Pour un rendez-vous simple, la réservation en ligne est plus rapide.
	</DiamantPageHead>

	<section class="dia-wrap pb-[clamp(64px,8vw,112px)]" aria-label="Coordonnées et formulaire">
		<div class="dia-grille items-start">
			<div class="dia-col-moitie-g" data-reveal>
				<p class="dia-acces__adresse">{business.address}</p>
				<ul class="mt-6 grid gap-2">
					<li><a href={`tel:${tel}`} class="dia-lien dia-chiffre">{business.phone}</a></li>
					<li><a href={`mailto:${business.email}`} class="dia-lien">{business.email}</a></li>
				</ul>
				<dl class="dia-horaires mt-10 max-w-md">
					{business.openingHours.map((h) => (
						<div>
							<dt>{h.day}</dt>
							<dd>{h.hours}</dd>
						</div>
					))}
				</dl>
			</div>

			<form
				id="contact-form"
				data-business-email={business.email}
				class="dia-panneau dia-col-moitie-d grid gap-5"
				data-reveal
				data-reveal-delay="120"
			>
				<div class="dia-champ">
					<label for="name">Nom complet</label>
					<input id="name" name="name" type="text" autocomplete="name" required />
				</div>
				<div class="dia-champ">
					<label for="email">Email</label>
					<input id="email" name="email" type="email" autocomplete="email" required />
				</div>
				<div class="dia-champ">
					<label for="message">Message</label>
					<textarea id="message" name="message" rows="6" required class="resize-none"></textarea>
				</div>
				<p id="form-status" class="hidden text-sm" role="status"></p>
				<button id="submit-btn" type="submit" class="dia-btn justify-self-start">Envoyer le message</button>
			</form>
		</div>

		<div class="dia-carte mt-[clamp(48px,6vw,88px)] aspect-[4/5] sm:aspect-[21/9]" data-reveal="fade">
			<Map lat={business.lat} lng={business.lng} label={business.name} class="h-full w-full" />
		</div>
	</section>
</DiamantLayout>

<script is:inline>
	const form = document.getElementById('contact-form');
	const status = document.getElementById('form-status');
	const btn = document.getElementById('submit-btn');

	if (form && status && btn) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(form);
			const businessEmail = form.dataset.businessEmail;

			btn.disabled = true;
			btn.textContent = 'Envoi en cours...';
			status.classList.add('hidden');

			try {
				const userEmail = formData.get('email');
				const userName = formData.get('name');
				const userMessage = formData.get('message');

				const serviceID = 'service_7pvm3br';
				const templateID = 'template_3j75n8o';
				const publicKey = '5Jjd71i9EWOeYyzsG';

				const templateParams = {
					from_name: userName,
					to_name: businessEmail || 'Professionnel',
					name: userName,
					email: userEmail,
					reply_to: userEmail,
					message: userMessage,
				};

				const response = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						service_id: serviceID,
						template_id: templateID,
						user_id: publicKey,
						template_params: templateParams,
					})
				});

				if (response.ok) {
					status.textContent = 'Message envoyé. Le salon vous répond sous 24 h ouvrées.';
					status.className = 'text-sm text-green-700';
					form.reset();
				} else {
					const errorText = await response.text();
					throw new Error(errorText || "Erreur lors de l'envoi");
				}
			} catch (err) {
				status.textContent = `Erreur lors de l'envoi : ${err.message}`;
				status.className = 'text-sm text-red-700';
			} finally {
				btn.disabled = false;
				btn.textContent = 'Envoyer le message';
				status.classList.remove('hidden');
			}
		});
	}
</script>
