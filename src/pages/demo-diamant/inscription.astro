---
import DiamantAuthShell from '@/components/diamant/DiamantAuthShell.astro';
import SignupForm from '@/components/diamant/auth/DiamantSignupForm';
---

<DiamantAuthShell
	pageTitle="Inscription"
	description="Créer un compte client pour réserver et suivre ses rendez-vous."
	titre="Créer un compte"
	lead="Un compte suffit pour réserver plus vite, retrouver vos rendez-vous et cumuler des points de fidélité."
>
	<SignupForm basePath="/demo-diamant" client:load />
	<Fragment slot="after">
		Déjà un compte ? <a href="/demo-diamant/connexion" class="dia-lien ml-1">Se connecter</a>
	</Fragment>
</DiamantAuthShell>
