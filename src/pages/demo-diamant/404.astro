---
import DiamantLayout from '@/layouts/DiamantLayout.astro';
---

<DiamantLayout title="Page Introuvable" description="La page que vous recherchez n'existe pas.">
	<section class="relative flex min-h-[75vh] items-center justify-center px-6 overflow-hidden bg-[#fff7f1]">
		<div class="absolute top-0 right-0 w-80 h-80 bg-deep-teal-100/40 rounded-full -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
		<div class="absolute bottom-0 left-0 w-64 h-64 bg-jasmine-100/40 rounded-full translate-y-1/2 -translate-x-1/3 pointer-events-none"></div>

		<div class="relative z-10 text-center max-w-lg mx-auto py-20" data-aos="fade-up" data-aos-duration="800">
			<div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white border border-stone-200 shadow-sm mb-6" data-aos="zoom-in" data-aos-delay="100">
				<span class="text-2xl font-black text-deep-teal-500">404</span>
			</div>
			<h1 class="text-6xl md:text-7xl font-black text-stone-900 mb-4 tracking-tight">Page Introuvable</h1>
			<p class="text-stone-500 text-lg mb-8 leading-relaxed">
				La page que vous recherchez semble introuvable ou a été déplacée.
			</p>
			<a
				href="/demo-diamant"
				class="inline-block rounded-xl bg-deep-teal-500 px-8 py-4 text-sm font-bold uppercase tracking-widest text-white transition-colors hover:bg-deep-teal-400 shadow-sm"
			>
				Retour à l'accueil
			</a>
		</div>
	</section>
</DiamantLayout>
