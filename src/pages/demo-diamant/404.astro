---
// Page introuvable : grand titre, retour à l'accueil ou à la réservation, logo animé.
import DiamantLayout from '@/layouts/diamant/DiamantLayout.astro';
import Diamant3DLogo from '@/components/diamant/Diamant3DLogo';
import { getSiteConfig } from '@/config/site';

const siteConfig = await getSiteConfig(Astro.url.pathname, Astro.cookies);
---

<DiamantLayout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex>
	<section class="dia-tetepage min-h-[80svh]">
		<div class="dia-wrap dia-grille items-end">
			<div class="dia-col-texte">
				<p class="dia-num mb-8"><b>404</b> Page introuvable</p>
				<h1 class="dia-display" data-split="load">Cette page <em>n'existe pas.</em></h1>
				<p class="dia-lead mt-8" data-reveal="fade">Le lien est peut-être ancien, ou l'adresse mal recopiée.</p>
				<div class="mt-10 flex flex-wrap gap-3" data-reveal data-reveal-delay="100">
					<a href="/demo-diamant/" class="dia-btn">Retour à l'accueil</a>
					<a href="/demo-diamant/reservation" class="dia-btn dia-btn--ligne">Réserver</a>
				</div>
			</div>
			<div class="hidden w-48 justify-self-end lg:col-span-3 lg:col-start-10 lg:block" data-reveal="fade">
				<Diamant3DLogo name={siteConfig.business.name} />
			</div>
		</div>
	</section>
</DiamantLayout>
