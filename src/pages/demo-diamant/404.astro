---
import DiamantLayout from '@/layouts/DiamantLayout.astro';
---

<DiamantLayout title="Page Introuvable" description="La page que vous recherchez n'existe pas.">
	<section class="relative flex min-h-[70vh] items-center justify-center px-6 overflow-hidden bg-stone-950">
		<div class="absolute inset-0 z-0 opacity-30">
			<div class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-deep-teal-900/20 rounded-full blur-[100px] pointer-events-none"></div>
		</div>
		<div class="relative z-10 text-center">
			<h1 class="text-9xl font-black text-transparent bg-clip-text bg-gradient-to-r from-jasmine-400 to-deep-teal-600 mb-4">404</h1>
			<h2 class="text-2xl font-bold text-white mb-6">Page Introuvable</h2>
			<p class="text-stone-400 mb-10 max-w-md mx-auto">La page que vous recherchez semble avoir disparu ou n'a jamais existé.</p>
			<a
				href="/demo-diamant"
				class="inline-block rounded-xl bg-gradient-to-r from-jasmine-500 to-jasmine-600 px-8 py-4 text-sm font-bold uppercase tracking-widest text-stone-950 transition-all hover:from-jasmine-400 hover:to-jasmine-500 shadow-[0_0_20px_rgba(235,188,102,0.2)] hover:shadow-[0_0_30px_rgba(235,188,102,0.4)]"
			>
				Retour à l'accueil
			</a>
		</div>
	</section>
</DiamantLayout>
