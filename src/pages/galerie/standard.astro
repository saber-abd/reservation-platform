---
import CommercialLayout from '@/layouts/CommercialLayout.astro';
import { Calendar, Zap, LayoutDashboard, Database, Server, Smartphone, CheckCircle2, ChevronRight, Euro } from 'lucide-react';
---

<CommercialLayout title="Formules - Démo Standard" description="Découvrez en détail la démo Standard, idéale pour démarrer votre activité en ligne.">
	
	<!-- Hero Section with Parallax Effect -->
	<section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden bg-prussian-blue-900">
		<div class="absolute inset-0 z-0">
			<!-- Abstract dynamic background (optimized) -->
			<div class="absolute top-1/4 left-1/4 w-[400px] h-[400px] bg-prussian-blue-500 rounded-full blur-[80px] opacity-20 will-change-transform transform-gpu pointer-events-none"></div>
			<div class="absolute bottom-1/4 right-1/4 w-[300px] h-[300px] bg-prussian-blue-400 rounded-full blur-[80px] opacity-10 will-change-transform transform-gpu pointer-events-none"></div>
			<div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=1080&auto=format&fit=crop&q=60')] opacity-5 bg-cover bg-fixed bg-center pointer-events-none"></div>
		</div>
		
		<div class="relative z-10 mx-auto max-w-5xl px-6 text-center pt-20 pb-32 md:pb-24">
			<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-prussian-blue-100 font-semibold mb-6" data-aos="fade-down">
				<span class="w-2 h-2 rounded-full bg-prussian-blue-400 animate-ping"></span>
				Formule Standard
			</div>
			<h1 class="text-5xl md:text-7xl font-black text-white tracking-tight mb-6" data-aos="fade-up" data-aos-delay="100">
				La Simplicité au service de <span class="text-prussian-blue-300">l'Efficacité.</span>
			</h1>
			<p class="text-xl text-prussian-blue-100 max-w-2xl mx-auto leading-relaxed" data-aos="fade-up" data-aos-delay="200">
				Un site vitrine ultra-rapide couplé à une prise de rendez-vous intelligente synchronisée directement sur votre calendrier.
			</p>
			
			<div class="mt-10 flex flex-col sm:flex-row flex-wrap justify-center items-center gap-6" data-aos="fade-up" data-aos-delay="300">
				<a href="/demo-standard/" target="_blank" class="px-8 py-4 bg-white text-prussian-blue-900 rounded-xl font-bold text-lg hover:bg-prussian-blue-50 transition-colors shadow-xl">
					Voir la démo en direct
				</a>
				<a href="#couts" class="px-8 py-4 bg-prussian-blue-800/50 backdrop-blur border border-prussian-blue-700 text-white rounded-xl font-bold text-lg hover:bg-prussian-blue-700 transition-colors">
					Voir les tarifs
				</a>
			</div>
		</div>
	</section>

	<!-- Section Fonctionnalités (Superimposed Cards) -->
	<section id="fonctionnalites" class="py-24 bg-stone-50">
		<div class="mx-auto max-w-6xl px-6">
			<div class="text-center mb-20" data-aos="fade-up">
				<h2 class="text-4xl font-bold text-stone-900 mb-4">Fonctionnalités Clés</h2>
				<p class="text-lg text-stone-600 max-w-2xl mx-auto">Conçu pour les professionnels qui souhaitent une présence en ligne sans gestion complexe.</p>
			</div>

			<div class="relative max-w-4xl mx-auto space-y-12">
				<!-- Card 1 -->
				<div data-aos="fade-up">
					<div class="group relative bg-white rounded-3xl p-8 md:p-12 shadow-md border border-stone-200 overflow-hidden transition-all duration-300 ease-out hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] transform hover:-translate-y-2">
						<div class="absolute -right-20 -top-20 w-64 h-64 bg-prussian-blue-50 rounded-full blur-3xl group-hover:bg-prussian-blue-100 transition-colors pointer-events-none"></div>
						<div class="relative z-10 flex flex-col md:flex-row gap-8 items-center">
							<div class="flex-1">
								<div class="w-14 h-14 bg-prussian-blue-100 text-prussian-blue-600 rounded-2xl flex items-center justify-center mb-6">
									<Calendar size={28} />
								</div>
								<h3 class="text-2xl font-bold text-stone-900 mb-4">Prise de RDV Intégrée</h3>
								<p class="text-stone-600 leading-relaxed mb-6">
									Fini les appels pendant vos prestations. Vos clients réservent en ligne et le rendez-vous s'ajoute automatiquement sur votre <strong>Google Calendar</strong> ou Outlook.
								</p>
								<ul class="space-y-3">
									<li class="flex items-center gap-3 text-sm font-medium text-stone-700"><CheckCircle2 size={18} class="text-prussian-blue-500" /> Synchronisation temps réel</li>
									<li class="flex items-center gap-3 text-sm font-medium text-stone-700"><CheckCircle2 size={18} class="text-prussian-blue-500" /> Pas de double réservation</li>
								</ul>
							</div>
							<div class="flex-1 w-full relative">
								<div class="aspect-video bg-stone-100 rounded-xl overflow-hidden border border-stone-200 shadow-inner">
									<img src="/images/technicien_pc.jpg" alt="Illustration RDV" class="w-full h-full object-cover" />
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Card 2 -->
				<div data-aos="fade-up" data-aos-delay="100">
					<div class="group relative bg-white rounded-3xl p-8 md:p-12 shadow-md border border-stone-200 overflow-hidden transition-all duration-300 ease-out hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] transform hover:-translate-y-2">
						<div class="absolute -left-20 -bottom-20 w-64 h-64 bg-blue-50 rounded-full blur-3xl group-hover:bg-blue-100 transition-colors pointer-events-none"></div>
						<div class="relative z-10 flex flex-col md:flex-row-reverse gap-8 items-center">
							<div class="flex-1">
								<div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center mb-6">
									<Zap size={28} />
								</div>
								<h3 class="text-2xl font-bold text-stone-900 mb-4">Vitesse & Référencement (SEO)</h3>
								<p class="text-stone-600 leading-relaxed mb-6">
									Contrairement aux sites WordPress classiques, ce site est généré statiquement. Résultat : un chargement instantané qui ravit vos visiteurs et Google.
								</p>
								<ul class="space-y-3">
									<li class="flex items-center gap-3 text-sm font-medium text-stone-700"><CheckCircle2 size={18} class="text-blue-500" /> Score Google PageSpeed > 95%</li>
									<li class="flex items-center gap-3 text-sm font-medium text-stone-700"><CheckCircle2 size={18} class="text-blue-500" /> Navigation fluide sans rechargement</li>
								</ul>
							</div>
							<div class="flex-1 w-full relative">
								<div class="aspect-video bg-stone-900 rounded-xl overflow-hidden shadow-2xl p-4 border border-stone-800">
									<!-- Pseudo code block for visual -->
									<div class="flex gap-2 mb-4">
										<div class="w-3 h-3 rounded-full bg-red-500"></div>
										<div class="w-3 h-3 rounded-full bg-yellow-500"></div>
										<div class="w-3 h-3 rounded-full bg-green-500"></div>
									</div>
									<div class="font-mono text-sm text-green-400">
										<p>> astro build</p>
										<p class="text-stone-400">✓ Completed in 120ms.</p>
										<p class="text-blue-400 mt-2">Deploying to Global Edge Network...</p>
										<p class="text-green-400">Success! Site is live.</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Section Technologies -->
	<section id="technologies" class="py-24 bg-stone-50 text-stone-900 relative overflow-hidden">
		<!-- Interactive Mouse Background Script -->
		<div id="cursor-glow" class="absolute w-[600px] h-[600px] bg-prussian-blue-200/50 rounded-full blur-[100px] pointer-events-none transform -translate-x-1/2 -translate-y-1/2 transition-all duration-500 ease-out"></div>
		
		<div class="relative z-10 mx-auto max-w-6xl px-6">
			<div class="text-center mb-16" data-aos="fade-up">
				<h2 class="text-4xl font-bold mb-4 text-stone-900">Sous le capot</h2>
				<p class="text-lg text-stone-600">Des technologies modernes pour un résultat sans compromis.</p>
			</div>

			<div class="grid md:grid-cols-3 gap-8">
				<div class="bg-white border border-stone-200 shadow-sm p-8 rounded-3xl hover:shadow-md transition-shadow" data-aos="fade-up" data-aos-delay="0">
					<LayoutDashboard class="w-12 h-12 text-prussian-blue-600 mb-6" />
					<h3 class="text-xl font-bold mb-3 text-stone-900">Astro & React</h3>
					<p class="text-stone-600 text-sm leading-relaxed">
						L'interface est construite avec Astro pour des performances maximales et React pour les composants interactifs (comme le formulaire de réservation).
					</p>
				</div>
				<div class="bg-white border border-stone-200 shadow-sm p-8 rounded-3xl hover:shadow-md transition-shadow" data-aos="fade-up" data-aos-delay="100">
					<Database className="w-12 h-12 text-prussian-blue-600 mb-6" />
					<h3 class="text-xl font-bold mb-3 text-stone-900">Zéro Base de données</h3>
					<p class="text-stone-600 text-sm leading-relaxed">
						Aucune base de données complexe à maintenir. Les informations sont stockées dans des fichiers de configuration sécurisés et directement dans votre agenda.
					</p>
				</div>
				<div class="bg-white border border-stone-200 shadow-sm p-8 rounded-3xl hover:shadow-md transition-shadow" data-aos="fade-up" data-aos-delay="200">
					<Server class="w-12 h-12 text-prussian-blue-600 mb-6" />
					<h3 class="text-xl font-bold mb-3 text-stone-900">Hébergement Edge</h3>
					<p class="text-stone-600 text-sm leading-relaxed">
						Déployé sur Cloudflare Workers. Votre site est distribué sur des centaines de serveurs dans le monde entier pour un accès immédiat.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Section Coûts -->
	<section id="couts" class="py-24 bg-white">
		<div class="mx-auto max-w-4xl px-6">
			<div class="text-center mb-16" data-aos="fade-up">
				<h2 class="text-4xl font-bold text-stone-900 mb-4">Investissement & Coûts d'infrastructure</h2>
				<p class="text-lg text-stone-600">La formule la plus économique sur le long terme.</p>
			</div>

			<div class="bg-stone-50 rounded-3xl p-8 md:p-12 border border-stone-200 shadow-sm" data-aos="fade-up">
				<div class="flex flex-col md:flex-row gap-12 items-center justify-between border-b border-stone-200 pb-8 mb-8">
					<div>
						<h3 class="text-2xl font-bold text-stone-900 mb-2">Création initiale</h3>
						<p class="text-stone-500">Design, développement, intégration de vos contenus et configuration API.</p>
					</div>
					<div class="text-right">
						<span class="text-4xl font-black text-prussian-blue-600">Sur devis</span>
					</div>
				</div>

				<div>
					<h4 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
						<Euro size={20} class="text-stone-400" />
						Frais fixes mensuels (Infrastructure)
					</h4>
					<div class="space-y-4">
						<div class="flex justify-between items-center bg-white p-4 rounded-xl border border-stone-100">
							<span class="font-medium text-stone-700">Hébergement Cloudflare</span>
							<span class="text-green-600 font-bold">0 € / mois *</span>
						</div>
						<div class="flex justify-between items-center bg-white p-4 rounded-xl border border-stone-100">
							<span class="font-medium text-stone-700">Google Calendar API</span>
							<span class="text-green-600 font-bold">0 € / mois</span>
						</div>
						<div class="flex justify-between items-center bg-white p-4 rounded-xl border border-stone-100">
							<span class="font-medium text-stone-700">Nom de domaine</span>
							<span class="text-stone-900 font-bold">~15 € / an</span>
						</div>
					</div>
					<p class="mt-6 text-xs text-stone-400 italic">
						* Dans la limite généreuse de 100 000 requêtes par jour. Un trafic standard de TPE ne dépassera jamais ce seuil gratuit.
					</p>
				</div>
			</div>
		</div>
	</section>

	<script>
		// Cursor glow effect logic
		const cursorGlow = document.getElementById('cursor-glow');
		const techSection = document.getElementById('technologies');

		if (cursorGlow && techSection) {
			techSection.addEventListener('mousemove', (e) => {
				const rect = techSection.getBoundingClientRect();
				const x = e.clientX - rect.left;
				const y = e.clientY - rect.top;
				cursorGlow.style.left = `${x}px`;
				cursorGlow.style.top = `${y}px`;
			});
		}
	</script>
</CommercialLayout>
