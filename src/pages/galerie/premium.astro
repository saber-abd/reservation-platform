---
import CommercialLayout from '@/layouts/commercial/CommercialLayout.astro';
import FormulaGallery, { type GalleryShot } from '@/components/commercial/FormulaGallery.astro';
import { paliers, fraisDe } from '@/components/commercial/offre';
import { Database, ShieldCheck, Users, LineChart, Euro, Gift, LayoutTemplate, Settings, Smartphone } from 'lucide-react';

// Prix et frais : src/data/devis.json (via offre.ts), jamais écrits à la main.
const p = paliers[1];
const frais = fraisDe('premium');
const notes = frais.filter((f) => f.note);

const galleryShots: GalleryShot[] = [
	{ file: 'site-vitrine', commercial: 'premium-accueil', title: 'Site vitrine', caption: 'La page d’accueil du garage, avec la réservation en avant.' },
	{ file: 'rendez-vous', commercial: 'premium-tableau', title: 'Tableau de bord', caption: 'Toutes les demandes de rendez-vous au même endroit, à confirmer, refuser ou consulter dans l’historique.' },
	{ file: 'statistiques', commercial: 'premium-stats', title: 'Statistiques', caption: 'Évolution du chiffre d’affaires, nombre d’interventions, panier moyen et prestations les plus rentables.' },
	{ file: 'clientele', title: 'Fiches clients', caption: 'Historique complet, coordonnées, note privée (véhicule, préférences) et discussion directe avec chaque client.' },
	{ file: 'espace-client', title: 'Espace client', caption: 'Vos clients retrouvent leurs réservations passées et à venir et peuvent annuler eux-mêmes.' },
	{ file: 'fidelite', title: 'Fidélité et points', caption: 'Les points s’accumulent à chaque passage et débloquent automatiquement grades, badges et avantages.' },
];
---

<CommercialLayout title="Formule Premium | SaberWeb.dev" description="La formule Premium en détail : base de données, espace client, tableau de bord, statistiques et fidélité. Écrans, technologies et coûts.">
	
	<!-- Hero Section -->
	<section class="relative min-h-[75vh] flex items-center justify-center overflow-hidden bg-brick-ember-900">
		<div class="absolute inset-0 z-0">
			<!-- Animated grid and gradients (optimized) -->
			<div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none"></div>
			<div class="absolute left-0 top-0 w-full h-full bg-gradient-to-br from-brick-ember-900 via-brick-ember-800/20 to-transparent pointer-events-none"></div>
			
			<div class="absolute right-[10%] top-[20%] w-[300px] h-[300px] bg-brick-ember-600 rounded-full blur-[80px] opacity-20 will-change-transform pointer-events-none transform-gpu"></div>
		</div>
		
		<div class="relative z-10 mx-auto max-w-6xl px-6 grid md:grid-cols-2 gap-12 items-center pt-32 pb-32 md:pb-24">
			<div class="text-left" data-reveal="right">
				<h1 class="text-5xl md:text-6xl font-black text-brick-ember-200 tracking-tight mb-6 leading-tight">
					Vos clients, vos rendez-vous, <span class="text-brick-ember-500">vos données.</span>
				</h1>
				<p class="text-xl text-brick-ember-100/80 mb-8 leading-relaxed">
					Une plateforme avec base de données : vos clients ont un compte et un historique, vous gérez rendez-vous, prestations et disponibilités depuis un tableau de bord.
				</p>
				
				<div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
					<a href="/demo-premium/" target="_blank" class="px-8 py-4 bg-brick-ember-500 text-white text-center rounded-xl font-bold text-lg hover:bg-brick-ember-400 transition-colors shadow-[0_0_40px_-10px_rgba(251,10,6,0.5)]">
						Voir la démo en direct
					</a>
					<a href="#fonctionnalites" class="px-8 py-4 bg-white/40 border-2 border-brick-ember-500/30 text-brick-ember-300 text-center rounded-xl font-bold text-lg hover:bg-brick-ember-800/50 transition-colors">
						Découvrir
					</a>
				</div>
			</div>
			
			<!-- Interactive 3D-like Dashboard Preview -->
			<div class="relative perspective-1000 hidden md:block" data-reveal="left" data-reveal-delay="200">
				<div class="w-full aspect-square bg-brick-ember-800/30 rounded-3xl border border-brick-ember-700/50 backdrop-blur-sm p-6 transform rotate-y-[-10deg] rotate-x-[10deg] shadow-2xl relative overflow-hidden group">
					<div class="absolute inset-0 bg-gradient-to-tr from-brick-ember-600/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
					<!-- Mockup UI -->
					<div class="w-full h-12 border-b border-brick-ember-700/50 flex items-center px-4 gap-4 mb-6">
						<div class="w-3 h-3 rounded-full bg-brick-ember-500"></div>
						<div class="w-24 h-4 rounded-full bg-brick-ember-700/50"></div>
					</div>
					<div class="grid grid-cols-2 gap-4 mb-4">
						<div class="h-24 rounded-xl border border-brick-ember-700/50 bg-brick-ember-800/40 p-4">
							<div class="w-8 h-8 rounded bg-brick-ember-600/50 mb-3"></div>
							<div class="w-16 h-3 rounded-full bg-brick-ember-500/80"></div>
						</div>
						<div class="h-24 rounded-xl border border-brick-ember-700/50 bg-brick-ember-800/40 p-4">
							<div class="w-8 h-8 rounded bg-brick-ember-600/50 mb-3"></div>
							<div class="w-12 h-3 rounded-full bg-brick-ember-500/80"></div>
						</div>
					</div>
					<div class="h-40 rounded-xl border border-brick-ember-700/50 bg-brick-ember-800/40 p-4">
						<div class="w-full h-full border-b border-l border-brick-ember-600/30 relative">
							<div class="absolute bottom-0 left-0 w-[20%] h-[40%] bg-brick-ember-500/50 rounded-t-sm"></div>
							<div class="absolute bottom-0 left-[25%] w-[20%] h-[70%] bg-brick-ember-500/50 rounded-t-sm"></div>
							<div class="absolute bottom-0 left-[50%] w-[20%] h-[50%] bg-brick-ember-500/50 rounded-t-sm"></div>
							<div class="absolute bottom-0 left-[75%] w-[20%] h-[90%] bg-brick-ember-500/50 rounded-t-sm"></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Section Fonctionnalités (Horizontal Scroll / Cards) -->
	<section id="fonctionnalites" class="py-24 bg-stone-50 overflow-hidden">
		<div class="mx-auto max-w-6xl px-6">
			<div class="text-center mb-16" data-reveal>
				<h2 class="text-4xl font-bold text-stone-900 mb-4">Ce que comprend la formule</h2>
				<p class="text-lg text-stone-600 max-w-2xl mx-auto">Tout ce qu’apporte la formule Standard, avec une base de données et un espace client.</p>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				<!-- Feature 1 -->
				<div data-reveal data-reveal-delay="0">
					<div class="group h-full bg-white p-8 rounded-3xl border border-stone-200 shadow-sm hover:border-brick-ember-300 transition-all duration-300 ease-out hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] transform hover:-translate-y-2">
						<Users className="w-10 h-10 text-brick-ember-600 mb-6 transition-transform duration-500 group-hover:scale-110 group-hover:-translate-y-1 group-hover:text-brick-ember-500" />
						<h3 class="text-xl font-bold text-stone-900 mb-3">Comptes Clients</h3>
						<p class="text-stone-600 text-sm leading-relaxed">
							Vos clients peuvent s'inscrire, se connecter, et retrouver l'historique complet de leurs réservations passées et futures.
						</p>
					</div>
				</div>
				<!-- Feature 2 -->
				<div data-reveal data-reveal-delay="100">
					<div class="group h-full bg-white p-8 rounded-3xl border border-stone-200 shadow-sm hover:border-brick-ember-300 transition-all duration-300 ease-out hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] transform hover:-translate-y-2">
						<Database className="w-10 h-10 text-brick-ember-600 mb-6 transition-transform duration-500 group-hover:scale-110 group-hover:-translate-y-1 group-hover:text-brick-ember-500" />
						<h3 class="text-xl font-bold text-stone-900 mb-3">Base de données SQL</h3>
						<p class="text-stone-600 text-sm leading-relaxed">
							Toutes les informations (utilisateurs, services, créneaux) sont stockées de manière sécurisée et structurée dans Supabase (PostgreSQL).
						</p>
					</div>
				</div>
				<!-- Feature 3 -->
				<div data-reveal data-reveal-delay="200">
					<div class="group h-full bg-white p-8 rounded-3xl border border-stone-200 shadow-sm hover:border-brick-ember-300 transition-all duration-300 ease-out hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] transform hover:-translate-y-2">
						<LineChart className="w-10 h-10 text-brick-ember-600 mb-6 transition-transform duration-500 group-hover:scale-110 group-hover:-translate-y-1 group-hover:text-brick-ember-500" />
						<h3 class="text-xl font-bold text-stone-900 mb-3">Tableau de bord</h3>
						<p class="text-stone-600 text-sm leading-relaxed">
							Gérez votre activité depuis une interface d'administration claire. Visualisez votre chiffre d'affaires et vos prochains RDV.
						</p>
					</div>
				</div>
				<!-- Feature 4 -->
				<div data-reveal data-reveal-delay="300">
					<div class="group h-full bg-white p-8 rounded-3xl border border-stone-200 shadow-sm hover:border-brick-ember-300 transition-all duration-300 ease-out hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] transform hover:-translate-y-2">
						<Gift className="w-10 h-10 text-brick-ember-600 mb-6 transition-transform duration-500 group-hover:scale-110 group-hover:-translate-y-1 group-hover:text-brick-ember-500" />
						<h3 class="text-xl font-bold text-stone-900 mb-3">Fidélité & Points</h3>
						<p class="text-stone-600 text-sm leading-relaxed">
							Un système de points de fidélité automatisé. Vos clients cumulent des points à chaque réservation pour les fidéliser.
						</p>
					</div>
				</div>
				<!-- Feature 5 -->
				<div data-reveal data-reveal-delay="400">
					<div class="group h-full bg-white p-8 rounded-3xl border border-stone-200 shadow-sm hover:border-brick-ember-300 transition-all duration-300 ease-out hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] transform hover:-translate-y-2">
						<ShieldCheck className="w-10 h-10 text-brick-ember-600 mb-6 transition-transform duration-500 group-hover:scale-110 group-hover:-translate-y-1 group-hover:text-brick-ember-500" />
						<h3 class="text-xl font-bold text-stone-900 mb-3">Sécurité RLS</h3>
						<p class="text-stone-600 text-sm leading-relaxed">
							Les données sont protégées par les règles de sécurité Row Level Security (RLS). Un client ne voit que ses propres données.
						</p>
					</div>
				</div>
				<!-- Feature 6 -->
				<div data-reveal data-reveal-delay="500">
					<div class="group h-full bg-brick-ember-500 p-8 rounded-3xl border border-brick-ember-500 shadow-lg text-white transition-all duration-300 ease-out hover:shadow-[0_20px_40px_-15px_rgba(191,6,3,0.3)] transform hover:-translate-y-2">
						<LayoutTemplate className="w-10 h-10 text-white mb-6 transition-transform duration-500 group-hover:scale-110 group-hover:-translate-y-1 group-hover:text-white" />
						<h3 class="text-xl font-bold mb-3 text-white">Interface soignée</h3>
						<p class="text-white/85 text-sm leading-relaxed">
							Composants accessibles au clavier, construits avec Tailwind, et un site public dessiné pour le métier.
						</p>
					</div>
				</div>
				<!-- Feature 7 : mobile -->
				<div class="md:col-span-2 lg:col-span-3" data-reveal data-reveal-delay="100">
					<div class="group flex h-full flex-col gap-6 rounded-3xl border border-stone-200 bg-white p-8 shadow-sm transition-all duration-300 ease-out hover:-translate-y-2 hover:border-brick-ember-300 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] sm:flex-row sm:items-center">
						<Smartphone className="w-10 h-10 shrink-0 text-brick-ember-600 transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-6" />
						<div>
							<h3 class="text-xl font-bold text-stone-900 mb-2">Version mobile soignée et animée</h3>
							<p class="text-stone-600 text-sm leading-relaxed">
								Chaque page s’adapte au téléphone : menu qui se déplie avec une animation fluide, tableau de bord accessible depuis un tiroir latéral, transitions légères qui restent rapides même sur un smartphone modeste.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Galerie de captures -->
	<FormulaGallery demo="premium" shots={galleryShots} title="Les écrans de la démo Premium" intro="L’espace client, le tableau de bord et la fidélité en situation réelle." />

	<!-- Section Technologies -->
	<section id="technologies" class="py-24 bg-stone-900 text-white">
		<div class="mx-auto max-w-6xl px-6">
			<div class="flex flex-col md:flex-row items-center gap-16">
				<div class="flex-1" data-reveal="right">
					<h2 class="text-4xl font-bold mb-6">Technologies utilisées</h2>
					<p class="text-stone-400 text-lg mb-8 leading-relaxed">
						La formule Premium s'appuie sur des outils largement utilisés en production.
					</p>
					
					<ul class="space-y-6">
						<li class="flex gap-4">
							<div class="w-12 h-12 rounded-xl bg-brick-ember-900/50 flex items-center justify-center border border-brick-ember-800 text-brick-ember-500 shrink-0">
								<Database size={24} />
							</div>
							<div>
								<h4 class="font-bold text-lg mb-1">Supabase (PostgreSQL)</h4>
								<p class="text-stone-400 text-sm">Base de données PostgreSQL, authentification des comptes et messages en temps réel.</p>
							</div>
						</li>
						<li class="flex gap-4">
							<div class="w-12 h-12 rounded-xl bg-brick-ember-900/50 flex items-center justify-center border border-brick-ember-800 text-brick-ember-500 shrink-0">
								<Settings size={24} />
							</div>
							<div>
								<h4 class="font-bold text-lg mb-1">Astro SSR & React</h4>
								<p class="text-stone-400 text-sm">Le site est rendu côté serveur (SSR) pour générer des pages dynamiques sécurisées (vérification des sessions utilisateurs).</p>
							</div>
						</li>
					</ul>
				</div>
				<div class="flex-1 w-full" data-reveal="left">
					<div class="bg-stone-950 rounded-2xl border border-stone-800 p-6 font-mono text-sm shadow-2xl">
						<div class="flex gap-2 mb-4 border-b border-stone-800 pb-4">
							<span class="text-brick-ember-500">Supabase</span>
							<span class="text-stone-500">Schema</span>
						</div>
						<pre class="text-stone-400 overflow-x-auto"><code><span class="text-purple-400">create table</span> users (
  id uuid <span class="text-blue-400">primary key</span>,
  email text <span class="text-blue-400">unique</span>,
  loyalty_points int <span class="text-blue-400">default</span> 0
);

<span class="text-purple-400">create table</span> reservations (
  id uuid <span class="text-blue-400">primary key</span>,
  user_id uuid <span class="text-blue-400">references</span> users,
  service_id uuid,
  start_time timestamptz,
  status text
);</code></pre>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Section Coûts -->
	<section id="couts" class="py-24 bg-brick-ember-50/50">
		<div class="mx-auto max-w-4xl px-6">
			<div class="text-center mb-16" data-reveal>
				<h2 class="text-4xl font-bold text-stone-900 mb-4">Coûts de fonctionnement</h2>
				<p class="text-lg text-stone-600">Une infrastructure professionnelle, des coûts maîtrisés.</p>
			</div>

			<div class="bg-white rounded-3xl p-8 md:p-12 border border-stone-200 shadow-sm" data-reveal>
				<div class="flex flex-col md:flex-row gap-12 items-center justify-between border-b border-stone-200 pb-8 mb-8">
					<div>
						<h3 class="text-2xl font-bold text-stone-900 mb-2">Création de la plateforme</h3>
						<p class="text-stone-500">Développement du site et des outils, modélisation de la base de données, maquette. Environ {p.jours} de travail.</p>
					</div>
					<div class="shrink-0 text-right">
						<span class="block whitespace-nowrap text-sm text-stone-500">Main d’œuvre, sans option</span>
						<span class="whitespace-nowrap text-4xl font-black text-brick-ember-500 tabular-nums">dès {p.prixBase}</span>
					</div>
				</div>

				<div>
					<h4 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
						<Euro size={20} class="text-stone-400" />
						Frais fixes mensuels (Infrastructure)
					</h4>
					<div class="space-y-4">
						{frais.map((f) => (
							<div class="flex justify-between items-center gap-4 bg-stone-50 p-4 rounded-xl border border-stone-100">
								<span class="font-medium text-stone-700">{f.nom}{f.note && ' *'}</span>
								<span class="text-stone-900 font-bold tabular-nums text-right">{f.montant}</span>
							</div>
						))}
					</div>
					<p class="mt-4 text-sm font-semibold text-stone-700">Total estimé : {p.frais}, payés sur vos propres comptes.</p>
					{notes.map((f) => (
						<p class="mt-3 text-xs text-stone-400 italic">* {f.nom} : {f.note}</p>
					))}
					<div class="mt-8 flex flex-wrap gap-3">
						<a href={p.devisHref} class="btn btn-rose">Simuler un devis Premium</a>
						<a href="/galerie/diamant" class="btn btn-outline">Voir la formule Diamant</a>
					</div>
				</div>
			</div>
		</div>
	</section>

</CommercialLayout>
