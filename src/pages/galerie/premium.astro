---
import FormuleDetail from '@/components/commercial/FormuleDetail.astro';
import type { GalleryShot } from '@/components/commercial/FormulaGallery.astro';
import { paliers } from '@/components/commercial/offre';

const galleryShots: GalleryShot[] = [
	{ file: 'site-vitrine', commercial: 'premium-accueil', title: 'Site vitrine', caption: 'La page d’accueil du garage, avec la réservation en avant.' },
	{ file: 'rendez-vous', commercial: 'premium-tableau', title: 'Tableau de bord', caption: 'Toutes les demandes de rendez-vous au même endroit, à confirmer, refuser ou consulter dans l’historique.' },
	{ file: 'statistiques', commercial: 'premium-stats', title: 'Statistiques', caption: 'Évolution du chiffre d’affaires, nombre d’interventions, panier moyen et prestations les plus rentables.' },
	{ file: 'clientele', title: 'Fiches clients', caption: 'Historique complet, coordonnées, note privée (véhicule, préférences) et discussion directe avec chaque client.' },
	{ file: 'espace-client', title: 'Espace client', caption: 'Vos clients retrouvent leurs réservations passées et à venir et peuvent annuler eux-mêmes.' },
	{ file: 'fidelite', title: 'Fidélité et points', caption: 'Les points s’accumulent à chaque passage et débloquent automatiquement grades, badges et avantages.' },
];
---

<FormuleDetail
	id="premium"
	titre="Vos clients ont un compte, vous avez un tableau de bord."
	chapo={`${paliers[1].description} La démo met en scène un garage fictif ; le tableau de bord peut être parcouru avec des données d’exemple depuis la page de connexion.`}
	technique="Les données (clients, rendez-vous, prestations, messages) sont dans une base PostgreSQL hébergée par Supabase. Chaque client ne peut lire que ses propres données : la règle est posée dans la base, pas seulement dans l’interface."
	shots={galleryShots}
	galerieTitre="Les écrans de la démo Premium"
	galerieIntro="L’espace client, le tableau de bord et la fidélité, avec des données d’exemple."
/>
