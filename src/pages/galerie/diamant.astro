---
import FormuleDetail from '@/components/commercial/FormuleDetail.astro';
import type { GalleryShot } from '@/components/commercial/FormulaGallery.astro';
import { paliers } from '@/components/commercial/offre';

const galleryShots: GalleryShot[] = [
	{ file: 'tableau-de-bord', title: 'Tableau de bord', caption: 'Chiffre d’affaires, rendez-vous, nouveaux clients, panier moyen et prochains rendez-vous en un coup d’œil.' },
	{ file: 'plage-personnalisee', title: 'Période personnalisable', caption: 'Choisissez 7 jours, 30 jours, 1 an ou vos propres dates : tous les indicateurs et graphiques s’adaptent.' },
	{ file: 'gestion-equipe', title: 'Gestion des utilisateurs', caption: 'Créez les comptes de votre équipe (administrateur, employé, démo), suspendez-les ou réinitialisez leur accès.' },
	{ file: 'permissions', title: 'Gestion des droits', caption: 'Chaque rôle a ses accès : lecture, modification ou masqué, onglet par onglet.' },
	{ file: 'moderation-clients', title: 'Modération des clients', caption: 'Recherchez, modifiez ou bannissez un client, avec le motif consigné.' },
	{ file: 'messagerie', title: 'Messagerie intégrée', caption: 'Un fil de discussion par client, avec compteur de messages non lus et accusés de lecture.' },
	{ file: 'recherche', title: 'Recherche unifiée', caption: 'Retrouvez n’importe quel rendez-vous par nom, e-mail, téléphone ou prestation.' },
	{ file: 'fidelite-client', title: 'Programme VIP', caption: 'Côté client : quatre niveaux (Cristal, Argent, Or, Diamant), des points et des avantages qui se débloquent.' },
	{ file: 'site-vitrine', commercial: 'diamant-accueil', title: 'Site vitrine', caption: 'Un site dessiné pour le salon, avec son logo animé.' },
];
---

<FormuleDetail
	id="diamant"
	titre="Une plateforme pour travailler à plusieurs."
	chapo={`${paliers[2].description} Le projet commence par un cahier des charges écrit et validé avec vous. La démo met en scène un salon de coiffure fictif ; un compte de démonstration en lecture seule ouvre le tableau de bord.`}
	technique="Même socle que Premium, avec des droits vérifiés par la base pour chaque rôle de l’équipe, des fonctions sécurisées pour la modération et une synchronisation des rendez-vous avec Google Agenda."
	shots={galleryShots}
	galerieTitre="Les écrans de la démo Diamant"
	galerieIntro="Le pilotage, la gestion d’équipe et l’espace client de la démo Diamant."
/>
